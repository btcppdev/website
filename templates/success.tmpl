<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <title>bitcoin++ | {{ msg "confirmation.title" }}</title>
    {{ block "checkout_header" . }}{{ end }}
  </head>
  <body class="btcpp-checkout-page">
    <main class="checkout-shell checkout-shell--success">
      <aside class="checkout-hero">
        <picture>
          <source srcset="/static/img/{{ .Conf.Tag }}/leading.avif" type="image/avif">
          <img src="/static/img/{{ .Conf.Tag }}/leading.png" alt="">
        </picture>
        <div class="checkout-hero__shade"></div>
        <div class="checkout-hero__content">
          <a href="{{ localeURL (printf "/%s" .Conf.Tag) }}" class="checkout-brand"><img src="/static/img/logo_blk.svg" alt="bitcoin++"></a>
          <div>
            <p class="checkout-kicker">{{ msg "confirmation.received" }}</p>
            <h1>{{ eventText .Conf.Tag .Conf.Desc }}</h1>
            <p>{{ eventText .Conf.Tag .Conf.DateDesc }} · {{ eventText .Conf.Tag .Conf.Location }}</p>
          </div>
        </div>
      </aside>

      <section class="checkout-panel">
        <nav class="checkout-steps" aria-label="{{ msg "checkout.steps" }}" data-step="04/04" data-current="confirmed" data-current-label="{{ msg "checkout.confirmed" }}">
          <span class="is-complete"><b>01</b> {{ msg "checkout.register" }}</span>
          <span class="is-complete"><b>02</b> {{ msg "checkout.addons" }}</span>
          <span class="is-complete"><b>03</b> {{ msg "checkout.pay" }}</span>
          <span class="is-active"><b>04</b> {{ msg "checkout.confirmed" }}</span>
        </nav>

        <div class="checkout-form checkout-confirmation">
          <div class="checkout-copy">
            {{ if .Sponsored }}
            <p class="checkout-confirmation__status">{{ msg "confirmation.sponsor_received" }}</p>
            <h2>{{ msg "confirmation.sponsor_title" }}</h2>
            <p>{{ msg "confirmation.sponsor_note" }}</p>
            {{ else }}
            <p class="checkout-confirmation__status">{{ msg "confirmation.ticket_received" }}</p>
            <h2>{{ msg "confirmation.ticket_title" }}</h2>
            <p>{{ msg "confirmation.ticket_note" }}</p>
            {{ end }}
          </div>

          <div class="checkout-ticket-stub">
            <div>
              {{ if .Sponsored }}
              <span>{{ msg "confirmation.sponsor_stub" }}</span>
              <strong>{{ eventText .Conf.Tag .Conf.Desc }}</strong>
              <small>{{ eventText .Conf.Tag .Conf.DateDesc }} · {{ eventText .Conf.Tag .Conf.Location }}</small>
              {{ else }}
              <span>{{ msg "confirmation.ticket_stub" }}</span>
              <strong>{{ eventText .Conf.Tag .Conf.Desc }}</strong>
              <small>{{ eventText .Conf.Tag .Conf.DateDesc }} · {{ eventText .Conf.Tag .Conf.Location }}</small>
              {{ end }}
            </div>
            <div class="checkout-ticket-stub__mark">
              {{ if and .Ticket .Ticket.QRCodeURI }}
              <img class="checkout-ticket-stub__qr" src="{{ .Ticket.QRCodeURI | safeURL }}" width="120" height="120" alt="{{ msg "confirmation.qr" (dict "ID" .Ticket.RefID) }}">
              {{ else if .Sponsored }}
              {{ msg "confirmation.funded" }}
              {{ else }}
              ++
              {{ end }}
            </div>
          </div>

          <div class="checkout-actions">
            <a href="{{ localeURL (printf "/%s" .Conf.Tag) }}" class="checkout-actions__primary">{{ msg "confirmation.back" }}</a>
            <a href="/dashboard">{{ msg "confirmation.dashboard" }}</a>
            <a href="{{ localeURL (printf "/%s#tickets" .Conf.Tag) }}">{{ msg "confirmation.another" }}</a>
          </div>
        </div>

        <footer class="checkout-footer">
          <span>{{ msg "confirmation.delivered" }}</span>
          <a href="mailto:hello@btcpp.dev">{{ msg "checkout.contact" }}</a>
        </footer>
      </section>
    </main>
  </body>
</html>
