<!DOCTYPE html>
<html>
<head>
  <title>Subscriptions · bitcoin++</title>
  {{ block "header" . }} {{ end }}
</head>
<body class="btcpp-profile-edit-page account-settings-page">
  {{ block "mainnav" . }} {{ end }}
  {{ template "dashboard_tabs" (dict "Active" "billing" "ShowHackathons" .HasHackathonProjects "ShowSponsors" .ShowSponsors "ShowAdmin" .IsGlobalAdmin "PendingOrgInviteCount" .PendingOrgInviteCount) }}
  <main class="profile-edit-shell person-emails-page">
    <header class="profile-edit-hero account-settings-hero">
      <div class="account-settings-hero__copy">
        <p class="profile-edit-tag">§ YOUR ACCOUNT</p>
        <h1>Your <span>subscriptions.</span></h1>
        <p>Manage your subscriptions, payments, and delivery preferences from your bitcoin++ account.</p>
      </div>
    </header>
    {{ template "billing_tabs" (dict "Active" "subscriptions" "ShowServices" .IsGlobalAdmin) }}
    {{ range .Subscriptions }}
    <section class="profile-edit-section is-open dashboard-subscription-card" aria-label="{{ .Name }} subscription">
      <div class="profile-edit-section__index">{{ if eq .Name "Alerts" }}01{{ else }}02{{ end }}</div>
      <div class="profile-edit-section__body">
        <div class="profile-edit-section__head"><div><h2>{{ .Name }}</h2><p>{{ .Description }}</p></div></div>
        <p><strong>{{ .Status }}</strong></p>
        {{ range .Periods }}<p>{{ . }}</p>{{ end }}
        {{ if .CheckedAt }}<p>Membership last updated {{ .CheckedAt }}. See Insider for your membership dates, including prepaid and complimentary access.</p>{{ end }}
        {{ if .BillingStatus }}<p>{{ .BillingStatus }}</p>{{ end }}
        {{ if .BillingURL }}
        <p><a href="{{ .BillingURL }}">Manage subscription →</a></p>
        <p><a href="{{ .URL }}">My alerts →</a></p>
        {{ else }}<p><a href="{{ .URL }}">Manage {{ .Name }} →</a></p>{{ end }}
      </div>
    </section>
    {{ end }}
  </main>
  {{ block "footer" . }}{{ end }}
</body>
</html>
