<!DOCTYPE html>
<html lang="en">
  <head>
    {{ template "rebrand_header" . }}
    {{ template "site_seo" (dict "Title" "whois @ bitcoin++" "Description" "A directory of bitcoin++ speakers, builders, and hackathon participants." "Path" "/whois" "Image" "/static/img/rebrand/breakthroughs.jpg") }}
    <link rel="stylesheet" href="/static/css/archive-rain.css">
    <link rel="shortcut icon" href="/static/favicon/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/static/favicon/apple-touch-icon.png">
  </head>
  <body class="btcpp-redesign btcpp-rebrand-page whois-page">
    {{ template "mainnav" . }}
    {{ template "archive_rain" .ArchiveRain }}

    <main class="whois-shell">
      <section class="whois-hero">
        <div>
          <p class="whois-section-tag">§ WHO'S HERE</p>
          <h1>The <span>people</span> of bitcoin++.</h1>
        </div>
        <p class="whois-hero__copy">{{ .AllCount }} builders, researchers, and hackers who have taken the stage or the hackathon table at bitcoin++ events. Find a co-speaker, collaborator, or someone who runs what you run.</p>
        <form class="whois-search" action="/whois" method="GET" role="search">
          <label for="whois-q">⌕</label>
          <input id="whois-q" type="search" name="q" value="{{ .Query }}" placeholder="Search people, talks, projects, cities, handles...">
          <button type="submit">SEARCH</button>
          {{ if .Query }}<a href="/whois">CLEAR</a>{{ end }}
        </form>
      </section>

      <section class="whois-directory" aria-label="Speaker directory">
        <div class="whois-filters" aria-label="Directory filters">
          <div class="whois-filters__group">
            <p>Topic:</p>
            <a class="{{ if eq .Topic "protocol" }}is-active{{ end }}" href="/whois?{{ if .Query }}q={{ .Query }}&{{ end }}topic=protocol{{ if .Event }}&event={{ .Event }}{{ end }}">protocol</a>
            <a class="{{ if eq .Topic "privacy" }}is-active{{ end }}" href="/whois?{{ if .Query }}q={{ .Query }}&{{ end }}topic=privacy{{ if .Event }}&event={{ .Event }}{{ end }}">privacy</a>
            <a class="{{ if eq .Topic "scaling" }}is-active{{ end }}" href="/whois?{{ if .Query }}q={{ .Query }}&{{ end }}topic=scaling{{ if .Event }}&event={{ .Event }}{{ end }}">scaling</a>
            <a class="{{ if eq .Topic "operations" }}is-active{{ end }}" href="/whois?{{ if .Query }}q={{ .Query }}&{{ end }}topic=operations{{ if .Event }}&event={{ .Event }}{{ end }}">operations</a>
          </div>
          <span class="whois-filters__rule" aria-hidden="true"></span>
          <div class="whois-filters__group whois-filters__group--events">
            <p>Event:</p>
            {{ range .EventOptions }}
            <a class="{{ if eq $.Event .Tag }}is-active{{ end }}" href="/whois?{{ if $.Query }}q={{ $.Query }}&{{ end }}{{ if $.Topic }}topic={{ $.Topic }}&{{ end }}event={{ .Tag }}">{{ .ArchiveTitle }}</a>
            {{ end }}
          </div>
          {{ if or .Query .Topic .Event }}<a class="whois-filters__clear" href="/whois">clear filters</a>{{ end }}
          <strong class="whois-filters__count">{{ len .People }} MEMBER{{ if ne (len .People) 1 }}S{{ end }}{{ if or .Query .Topic .Event }} · FILTERED{{ end }}</strong>
        </div>

        <div class="whois-results">
          {{ if .People }}
          <div class="whois-grid">
            {{ range .People }}
            <a class="whois-card" href="/whois/{{ .PublicID }}">
              <div class="whois-card__top">
                <img loading="lazy" src="{{ speakerPhoto .Speaker.Photo }}" alt="{{ .Speaker.Name }}" data-image-fallback>
                <span class="whois-card__photo-fallback" data-image-fallback-copy hidden aria-hidden="true">++</span>
                <div>
                  <p>@{{ .PublicID }}</p>
                  <h2>{{ .Speaker.Name }}</h2>
                  <span>{{ if .Speaker.Company }}{{ .Speaker.Company }}{{ else if .Talks }}bitcoin++ speaker{{ else }}bitcoin++ builder{{ end }}</span>
                </div>
              </div>
              <div class="whois-card__tags">
                {{ range .Editions }}
                <span>{{ .Tag }}</span>
                {{ end }}
              </div>
              <div class="whois-card__stats">
                <span><b>{{ len .Editions }}</b> ED</span>
                <span><b>{{ len .Talks }}</b> TALKS</span>
                <span><b>{{ len .Projects }}</b> PROJ</span>
              </div>
            </a>
            {{ end }}
          </div>
          {{ else }}
          <div class="whois-empty">
            <h2>No members match.</h2>
            <p>Try removing a search term or broadening the query.</p>
          </div>
          {{ end }}
          <div class="whois-directory__footer">
            <span>◇ = community profile</span>
            <span>click a card for the full archive</span>
          </div>
        </div>
      </section>
    </main>

    {{ template "generic_conf_footer" . }}
  </body>
</html>
