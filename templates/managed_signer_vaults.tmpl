{{ define "managed_signer_vaults.tmpl" -}}
<!doctype html>
<html lang="en"><head><title>Choose a key vault · bitcoin++</title>
{{ template "account_security_head" . }}
<link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-account-flows">
</head>
<body class="btcpp-login-page account-flow account-flow--signer">
{{ template "account_security_brand" . }}

<main class="auth-shell auth-shell--simple"><section class="auth-card">
  <h1>Choose a key vault.</h1>
  <p class="managed-signer-consent__intro">Open your personal vault or one for an organization you manage. We’ll check whether it’s ready or needs setup.</p>
  <dl>{{ range .Vaults }}<div><dt>{{ .Kind }}</dt><dd><a href="{{ .URL }}">{{ .Name }} →</a></dd></div>{{ end }}</dl>
  <div class="auth-form auth-form__actions"><a href="/dashboard">Back to your bitcoin++ account →</a></div>
</section></main>{{ template "account_security_footer" . }}</body></html>
{{- end }}
