<div id="discount_result" name="hidden_stuffs" class="checkout-summary"
  data-ticket-btc-price-cents="{{ mul (int .DiscountPrice) 100 }}"
  data-ticket-card-price-cents="{{ mul (int .CardPrice) 100 }}">
  <div class="checkout-summary__lines">
    <div>
      <span>{{ if .SponsorCheckout }}{{ msg "checkout.sponsor_builder" }}{{ else }}{{ eventText .Conf.Tag .Tix.Tier }}{{ end }} · <span data-ticket-count-label>{{ if .SponsorCheckout }}{{ if eq .Count 1 }}{{ msg "checkout.pass_one" (dict "Count" .Count) }}{{ else }}{{ msg "checkout.pass_many" (dict "Count" .Count) }}{{ end }}{{ else }}{{ if eq .Count 1 }}{{ msg "checkout.ticket_one" (dict "Count" .Count) }}{{ else }}{{ msg "checkout.ticket_many" (dict "Count" .Count) }}{{ end }}{{ end }}</span></span>
      <strong>{{ .Tix.Symbol }}{{ .TixPrice }}{{ .Tix.PostSymbol }} {{ msg "checkout.each" }}</strong>
    </div>
    {{ if ne .TixPrice .DiscountPrice }}
    <div class="is-discount">
      <span>{{ msg "checkout.applied" (dict "Code" .Discount) }}</span>
      <strong>-{{ .Tix.Symbol }}{{ usub .TixPrice .DiscountPrice }}{{ .Tix.PostSymbol }}</strong>
    </div>
    {{ end }}
    <div class="is-total" data-selected-payment-price
      data-bitcoin-price="{{ .Tix.Symbol }}{{ .DiscountPrice }}{{ .Tix.PostSymbol }} {{ msg "checkout.each" }}"
      data-card-price="{{ .Tix.Symbol }}{{ .CardPrice }}{{ .Tix.PostSymbol }} {{ msg "checkout.each" }}">
      <span data-payment-price-label>{{ if eq .PaymentMethod "card" }}{{ msg "checkout.card_price" }}{{ else }}{{ msg "checkout.bitcoin_price" }}{{ end }}</span>
      <strong data-payment-price-amount>{{ if eq .PaymentMethod "card" }}{{ .Tix.Symbol }}{{ .CardPrice }}{{ .Tix.PostSymbol }}{{ else }}{{ .Tix.Symbol }}{{ .DiscountPrice }}{{ .Tix.PostSymbol }}{{ end }} {{ msg "checkout.each" }}</strong>
    </div>
  </div>

  {{ if .Err }}
    {{ if .Discount }}
  <div class="checkout-summary__error">{{ .Err }}</div>
    {{ end }}
  {{ end }}

  <input type="hidden" name="Tix" value="{{ .Tix }}" required>
  <input type="hidden" name="HMAC" value="{{ .HMAC }}" required>
  <input type="hidden" name="TixPrice" value="{{ .TixPrice }}" required>
  <input type="hidden" name="DiscountPrice" value="{{ .DiscountPrice }}" required>
  <input type="hidden" name="DiscountRef" value="{{ .DiscountRef }}" required>
  <input type="hidden" name="AffiliateCode" value="{{ .AffiliateCode }}">
</div>
