<!doctype html>
<html lang="en">
<head>
  {{ template "head_meta" . }}
  <title>bitcoin++ {{ if .SponsorsMode }}sponsor{{ else }}news{{ end }} ticker</title>
  <base target="_blank">
  <link rel="stylesheet" href="/static/css/site-chrome.css?v=20260911-marquee">
  <style>
    html, body { margin:0; padding:0; width:100%; height:100%; overflow:hidden; }
    body { background:{{ if .SponsorsMode }}#f6f3ee{{ else }}#0a0a0a{{ end }}; }
    /* Broadcast-sized version; the website ticker keeps its original size. */
    .site-ticker { position:static; height:68px; min-height:68px; font-size:22px; }
    .site-ticker__label, .site-ticker__live { padding:16px 32px; }
    .site-ticker__track { height:100%; animation-duration:56s; }
    .site-ticker__items { height:100%; padding:16px 32px; gap:32px; }
    .sponsor-banner__viewport { width:100%; }
  </style>
</head>
<body>
  {{ if .SponsorsMode }}
    <div data-widget-sponsors>{{ template "sponsor_marquee" (dict "Sponsors" .Sponsors "IncludeBrands" true) }}</div>
    <script>
      // Retain the current animation when the public sponsor list is unchanged.
      // Failed refreshes leave the last successful frame on screen.
      let sponsorMarkup = document.querySelector('[data-widget-sponsors]').innerHTML;
      window.setInterval(async function () {
        try {
          const response = await fetch(window.location.href, {cache:'no-store', credentials:'omit'});
          if (!response.ok) return;
          const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
          const next = doc.querySelector('[data-widget-sponsors]');
          const current = document.querySelector('[data-widget-sponsors]');
          if (next && current && next.innerHTML !== sponsorMarkup) {
            sponsorMarkup = next.innerHTML;
            window.btcppSponsorMarquee?.dispose(current);
            current.replaceChildren(...next.childNodes);
            window.btcppSponsorMarquee?.init(current);
          }
        } catch (_) {}
      }, 60000);
    </script>
  {{ else }}
    {{ template "site_ticker" .Nav }}
  {{ end }}
</body>
</html>
