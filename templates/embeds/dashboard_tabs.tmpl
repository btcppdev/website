{{ define "dashboard_tabs" }}
{{ if or .ShowHackathons .ShowAdmin }}
<nav class="dashboard-tabs" aria-label="Dashboard sections">
  <a href="/dashboard" class="dashboard-tab{{ if eq .Active "overview" }} is-active{{ end }}"{{ if eq .Active "overview" }} aria-current="page"{{ end }}>Overview</a>
  {{ if .ShowHackathons }}
  <a href="/dashboard/hackathons" class="dashboard-tab{{ if eq .Active "hackathons" }} is-active{{ end }}"{{ if eq .Active "hackathons" }} aria-current="page"{{ end }}>Hackathons</a>
  {{ end }}
  {{ if .ShowAdmin }}
  <a href="/admin" class="dashboard-tab{{ if eq .Active "admin" }} is-active{{ end }}"{{ if eq .Active "admin" }} aria-current="page"{{ end }}>Admin</a>
  {{ end }}
</nav>
{{ end }}
{{ end }}
