<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ $socialCard := .SocialCardURL }}{{ if not $socialCard }}{{ $socialCard = "/static/img/rebrand/breakthroughs.jpg" }}{{ end }}
    {{ template "site_seo" (dict "Title" "bitcoin++ · Developing the frontier of bitcoin" "Description" "bitcoin++ hosts technical conferences, workshops, and hackathons for bitcoin developers and builders around the world." "Path" "/" "Image" $socialCard "ImageType" "image/jpeg" "ImageWidth" 1200 "ImageHeight" 630) }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,600&family=IBM+Plex+Mono:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/btcpp-redesign.css?v=20261121-landing-alignment">
    <link rel="stylesheet" href="/static/css/site-chrome.css?v=20261121-ticker-colors">
    <link rel="stylesheet" href="/static/css/home-redesign.css?v=20261121-site-refresh-0183d292">
    <link rel="stylesheet" href="/static/css/home-features.css?v=20261121-expedition-alerts">
    {{ if insiderVisible }}
    <link rel="stylesheet" href="/static/css/home-insider.css?v=20261121-insider-footer-logo">
    <script src="/static/js/home-insider.js?v=20261121-insider-brand" defer></script>
    {{ end }}
    <link rel="stylesheet" href="/static/css/brand-typography.css?v=20261121-light-surfaces">
    <link rel="stylesheet" href="/static/css/archive-rain.css?v=20261121-bitcoin-orange">
    <link rel="stylesheet" href="/static/css/site-navigation.css?v=20261121-stable-header">
    <link rel="shortcut icon" href="/static/favicon/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/static/favicon/apple-touch-icon.png">
  <link rel="stylesheet" href="/static/css/site-controls.css?v=20261121-header-orange">
</head>
  <body class="btcpp-home btcpp-home--index">
    <div class="home-page">
      {{ $next := .NextConf }}
      {{ template "mainnav" . }}

      {{ template "archive_rain" .ArchiveRain }}

      <main class="home-shell">
        <section class="home-hero">
          <div class="home-hero__grid">
            <div>
              <h1>Developing the <span class="brand-frontier">frontier</span> of bitcoin.</h1>
              <p class="home-deck">Join the builders shaping Bitcoin's next chapter. Meet them at bitcoin++ events around the world.</p>
            </div>
            <div class="home-actions">
              <a href="/#events" class="home-button">Upcoming events</a>
{{ if insiderVisible }}              <a href="https://insider.btcpp.dev/" target="_blank" rel="noopener noreferrer" class="home-button is-outline">Read insider</a>{{ end }}
            </div>
          </div>
          <div class="home-stats">
            <div class="home-stat"><strong>{{ len .Confs }}</strong><span>Editions and counting</span></div>
            <div class="home-stat"><strong>{{ len .Years }}</strong><span>Years of events</span></div>
            <div class="home-stat"><strong>{{ len .Upcoming }}</strong><span>Upcoming stops</span></div>
            <div class="home-stat"><strong>{{ len .Past }}</strong><span>Archived editions</span></div>
          </div>
        </section>

        {{ if $next }}
        <section class="home-next">
          <div>
            <h2>{{ $next.Desc }}, <span class="home-serif">{{ if $next.Tagline }}{{ $next.Tagline }}{{ else }}technical edition{{ end }}.</span></h2>
            <p class="home-deck">{{ $next.OGFlavor }}</p>
            <div class="home-next__meta">{{ $next.DateDesc }} · {{ $next.Location }}</div>
            <div class="home-actions">
              <a href="/{{ $next.Tag }}" class="home-button is-accent">The full program</a>
              <a href="/{{ $next.Tag }}#tickets" class="home-button">Get tickets</a>
            </div>
          </div>
          <a href="/{{ $next.Tag }}" class="home-next__image">
            <img src="{{ confImage $next.Tag "leading" }}" alt="{{ $next.Desc }}">
          </a>
        </section>
        {{ end }}

        <section id="hackathons" class="home-hackathon" aria-labelledby="home-hackathon-title">
          <div class="home-hackathon__intro">
            <div>
              <h2 id="home-hackathon-title" class="home-section-title">Hackathons.<br><span class="home-serif home-hackathon-accent">Build. Ship. Win.</span></h2>
            </div>
            <!-- Historical award snapshot and photo provenance: docs/homepage-hackathons.md. -->
            <div class="home-hackathon__stat">
              <strong>129M+</strong>
              <span>sats awarded</span>
              <small>Across all bitcoin++ hackathons</small>
            </div>
          </div>
          <div class="home-hackathon__gallery" aria-label="Hackathon photo gallery">
            <figure>
              <a href="/berlin25/hackathon" aria-label="View the Berlin 2025 hackathon">
                <img src="/static/img/home/berlin25-hackathon-awards.avif" width="700" height="933" loading="lazy" alt="The Glacier Wallet team receiving their award at the bitcoin++ Berlin 2025 hackathon">
                <span class="home-hackathon__link-arrow" aria-hidden="true">→</span>
              </a>
              <figcaption><strong>Berlin 2025</strong><span>Glacier Wallet · Awards</span></figcaption>
            </figure>
            <figure>
              <a href="/nairobi/hackathon" aria-label="View the Nairobi 2026 hackathon">
                <img src="/static/img/home/nairobi26-hackathon-awards.avif" width="1440" height="1016" loading="lazy" alt="The PoWR team receiving a hackathon award on the bitcoin++ Nairobi stage">
                <span class="home-hackathon__link-arrow" aria-hidden="true">→</span>
              </a>
              <figcaption><strong>Nairobi 2026</strong><span>PoWR · Awards</span></figcaption>
            </figure>
            <figure>
              <a href="/berlin26/hackathon" aria-label="View the Berlin 2026 hackathon">
                <img src="/static/img/home/berlin26-hackathon-demo.avif" width="1440" height="690" loading="lazy" alt="A developer presenting Barkade during the bitcoin++ Berlin 2026 hackathon demos">
                <span class="home-hackathon__link-arrow" aria-hidden="true">→</span>
              </a>
              <figcaption><strong>Berlin 2026</strong><span>Barkade · Demo day</span></figcaption>
            </figure>
          </div>
          <div class="home-actions">
            <a href="https://foss.devpost.com/" target="_blank" rel="noopener noreferrer" class="home-button">Past winners</a>
            <a href="{{ if $next }}/{{ $next.Tag }}{{ else }}/{{ end }}" class="home-button is-outline">Next event</a>
          </div>
        </section>

        <section class="home-map">
          <div class="home-section-head home-section-head--inset">
            <div>
              <h2 class="home-section-title">Cities across <span class="home-serif">the map.</span></h2>
            </div>
            <div class="home-section-copy">Every edition leaves a dot in the archive. The next stops keep moving.</div>
          </div>
          <div class="home-map__frame">
            <img src="/static/img/home/worldmap.svg" alt="bitcoin++ event map">
            {{ if .MapMarkers }}
            <div class="home-map__markers" aria-label="bitcoin++ event locations">
              {{ range .MapMarkers }}
              {{ if gt (len .Editions) 1 }}
              <details class="home-map-marker home-map-marker--multi {{ if .Upcoming }}is-upcoming{{ else }}is-past{{ end }} is-label-{{ .LabelSide }}" style="{{ .Style | safeCSS }}">
                <summary>
                  <span class="home-map-marker__dot"></span>
                  <span class="home-map-marker__label">{{ .Label }} <b>{{ len .Editions }}</b></span>
                </summary>
                <span class="home-map-marker__menu">
                  {{ range .Editions }}
                  <a href="/{{ .Conf.Tag }}" class="{{ if .Upcoming }}is-upcoming{{ else }}is-past{{ end }}">
                    <strong>{{ .Label }}{{ if .Upcoming }} <em>Upcoming</em>{{ end }}</strong>
                    <span>{{ .Date }}{{ if eq .EditionType "local" }} · Local edition{{ end }}</span>
                  </a>
                  {{ end }}
                </span>
              </details>
              {{ else }}
              <a href="/{{ .Conf.Tag }}" class="home-map-marker {{ if .Upcoming }}is-upcoming{{ else }}is-past{{ end }} is-label-{{ .LabelSide }}" style="{{ .Style | safeCSS }}">
                <span class="home-map-marker__dot"></span>
                <span class="home-map-marker__label">{{ .Label }}{{ if and .Conf (eq .Conf.EditionType "local") }} <b>local</b>{{ end }}</span>
              </a>
              {{ end }}
              {{ end }}
            </div>
            {{ end }}
            <div class="home-map__legend">
              <span>Past editions · {{ len .Past }}</span>
              <span>Upcoming editions · {{ len .Upcoming }}</span>
              <span>{{ len .Years }} years · 2022-present</span>
            </div>
          </div>
        </section>

        <section id="events">
          <div class="home-section-head">
            <div>
              <h2 class="home-section-title">Choose your next stop.</h2>
            </div>
            <div class="home-section-copy">We're bringing bitcoin++ around the globe. Each city is picked for its role in bitcoin's story.</div>
          </div>
          <div class="home-card-grid">
            {{ range .Upcoming }}
            <a href="/{{ .Tag }}" class="home-card">
              <span class="home-card__image">
                <img src="{{ confImage .Tag "leading" }}" alt="{{ .Desc }}">
                <span class="home-card__badge {{ if eq .Tag $next.Tag }}is-live{{ end }}">{{ if eq .Tag $next.Tag }}Next up{{ else }}Tickets live{{ end }}</span>
              </span>
              <span class="home-card__body">
                <span><span class="home-card__city">{{ .Desc }}</span><span class="home-card__theme">{{ if .Tagline }}{{ .Tagline }}{{ else }}Technical edition{{ end }}</span></span>
                <span class="home-card__date">{{ .DateDesc }}</span>
              </span>
            </a>
            {{ end }}
          </div>
        </section>

        <section id="antarctica" class="home-expedition" aria-labelledby="home-expedition-title">
          <div class="home-expedition__copy">
            <h2 id="home-expedition-title">Cold storage.<br><span>Warm company.</span></h2>
            <p class="home-expedition__date">Antarctica · Jan 24–Feb 5, 2028</p>
            <p class="home-expedition__description">13 days at the edge of the world. Join bitcoin builders for an Antarctic expedition and an unconference at sea.</p>
            <a class="home-button" href="/antarctica">Explore the expedition <span aria-hidden="true">→</span></a>
          </div>
          <a class="home-expedition__art" href="/antarctica" aria-label="Explore the bitcoin++ Antarctica expedition">
            <img src="{{ confImage "antarctica" "leading" }}" width="1024" height="1024" loading="lazy" alt="An expedition ship, explorers and penguins among Antarctic ice beneath an orange sky">
          </a>
        </section>

        <section class="home-speakers">
          <div class="home-section-head home-section-head--inset">
            <div>
              <h2 class="home-section-title">Direct access to bitcoin's <span class="home-serif">brightest minds.</span></h2>
              <p class="home-deck">Long-form technical sessions, workshops, and hallway time with the people writing the code.</p>
            </div>
            <a href="/events" class="home-button is-accent">Talk archive</a>
          </div>
          <div class="home-speaker-strip">
            {{ if .FeaturedSpeakers }}
            {{ range .FeaturedSpeakers }}
            <div class="home-speaker">
              <div class="home-speaker__portrait">
                {{ if .Photo }}
                <img src="{{ speakerPhoto .Photo }}" alt="{{ .Name }}">
                {{ else }}
                <span>{{ printf "%.1s" .Name }}</span>
                {{ end }}
              </div>
              <div class="home-speaker__name">{{ .Name }}</div>
            </div>
            {{ end }}
            {{ else }}
            <div class="home-speaker"><div class="home-speaker__portrait">n</div><div class="home-speaker__name">niftynei</div></div>
            <div class="home-speaker"><div class="home-speaker__portrait">P</div><div class="home-speaker__name">Peter Todd</div></div>
            <div class="home-speaker"><div class="home-speaker__portrait">J</div><div class="home-speaker__name">Jeremy Rubin</div></div>
            <div class="home-speaker"><div class="home-speaker__portrait">Y</div><div class="home-speaker__name">Ying Tong</div></div>
            <div class="home-speaker"><div class="home-speaker__portrait">S</div><div class="home-speaker__name">Salvatore Ingala</div></div>
            <div class="home-speaker"><div class="home-speaker__portrait">L</div><div class="home-speaker__name">Liam Eagen</div></div>
            <div class="home-speaker"><div class="home-speaker__portrait">H</div><div class="home-speaker__name">Hunter Beast</div></div>
            <div class="home-speaker"><div class="home-speaker__portrait">B</div><div class="home-speaker__name">Bianca Motta</div></div>
            {{ end }}
          </div>
        </section>

{{ if insiderVisible }}
        <section id="insider" class="home-insider" aria-labelledby="home-insider-title">
          <div class="home-insider__grid">
            <div class="home-insider__copy">
              <h2 id="home-insider-title">Understand what's next in <span>bitcoin.</span></h2>
              <p>Bitcoin news, technical deep dives, and conversations with the people building it.</p>
              <a href="https://insider.btcpp.dev/" target="_blank" rel="noopener noreferrer" class="home-insider__link">Read Insider <span aria-hidden="true">→</span></a>
            </div>
            <!-- Curated clip and brand sources: docs/homepage-insider.md. -->
            <figure class="home-insider__episode" data-insider-preview>
              <div class="home-insider__player">
                <video controls muted loop playsinline preload="none" width="960" height="540" poster="/static/img/home/insider-news-hour-20261120.jpg" aria-label="Silent preview of the November 20 Insider News Hour">
                  <source src="/static/video/insider-news-hour-20261120.mp4" type="video/mp4">
                  <a href="https://x.com/i/broadcasts/2WXPjaJrnEyAYK">Watch the News Hour on X</a>
                </video>
                <button class="home-insider__play" type="button" hidden data-insider-play>
                  <span data-insider-play-icon aria-hidden="true">▶</span>
                  <span data-insider-play-label>Play preview</span>
                </button>
              </div>
              <figcaption>
                <h3>P2Pool v2 &amp; testnet5 with @jungly</h3>
                <div class="home-insider__episode-meta"><span>News Hour · <time datetime="2026-11-20">Nov 20</time></span><a href="https://x.com/i/broadcasts/2WXPjaJrnEyAYK" target="_blank" rel="noopener noreferrer">Full episode <span aria-hidden="true">↗</span></a></div>
              </figcaption>
            </figure>
          </div>
          <a href="https://insider.btcpp.dev/" target="_blank" rel="noopener noreferrer" class="home-insider__logo" aria-label="bitcoin++ Insider Edition">
            <img src="/static/img/home/insider-logo-white.png" width="650" height="650" loading="lazy" alt="bitcoin++ Insider Edition">
          </a>
        </section>
{{ end }}

        <section id="alerts" class="home-alerts" aria-labelledby="home-alerts-title">
          <div class="home-alerts__copy">
            <svg class="home-alerts__icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13a8 8 0 0 1 16 0c0 9 3 9 3 11H5c0-2 3-2 3-11Z"/><path d="M13 28h6M16 2v3M3 8l2 2M29 8l-2 2"/></svg>
            <div>
              <h2 id="home-alerts-title">Your software ships.<br><span>Your inbox knows.</span></h2>
              <p>Release alerts for the wallets, nodes, and tools you use. Delivered by email or Telegram.</p>
            </div>
          </div>
          <div class="home-alerts__action">
            <a href="https://alerts.btcpp.dev/" target="_blank" rel="noopener noreferrer">Try bitcoin++ Alerts <span aria-hidden="true">→</span></a>
            <p>Your first 3 projects are free.</p>
          </div>
        </section>

        <section class="home-shop">
          <div class="home-section-head">
            <div>
              <h2 class="home-section-title">bitcoin++ <span class="home-serif">merch shop</span></h2>
            </div>
            <a href="/shop" class="home-button is-outline">Shop the Store</a>
          </div>
          <div class="home-shop__grid">
            <div class="home-shop__item"><div class="home-shop__mock">Conference tee</div><div class="home-shop__body"><strong>Edition shirts</strong><a href="/shop">Shop</a></div></div>
            <div class="home-shop__item"><div class="home-shop__mock">Sticker pack</div><div class="home-shop__body"><strong>Protocol stickers</strong><a href="/shop">Shop</a></div></div>
            <div class="home-shop__item"><div class="home-shop__mock">Poster</div><div class="home-shop__body"><strong>Event prints</strong><a href="/shop">Shop</a></div></div>
          </div>
        </section>

        <section class="home-sponsors">
          <div class="home-section-head home-section-head--inset">
            <div>
              <h2 class="home-section-title">Builders backing <span class="home-serif">the frontier.</span></h2>
            </div>
            <div class="home-section-actions">
              <div class="home-section-copy">Headline and workshop sponsors from current and past-year editions.</div>
              <a href="/sponsor" class="home-button is-accent">Sponsor bitcoin++</a>
            </div>
          </div>
          {{ if .Sponsors }}
          <div class="home-sponsor-grid">
            {{ range .Sponsors }}
              {{ if .URL }}<a href="{{ .URL | safeURL }}" target="_blank" rel="noopener noreferrer" class="home-sponsor-card home-sponsor-card--{{ .Level | lower }}">{{ else }}<div class="home-sponsor-card home-sponsor-card--{{ .Level | lower }}">{{ end }}
                <span class="home-sponsor-card__tier">{{ .Level }}</span>
                {{ $logo := .LogoLight }}{{ if not $logo }}{{ $logo = .LogoDark }}{{ end }}
                {{ if $logo }}
                  <img src="{{ $logo | safeURL }}" alt="{{ .Name }}">
                {{ else }}
                  <span class="home-sponsor-card__name">{{ .Name }}</span>
                {{ end }}
              {{ if .URL }}</a>{{ else }}</div>{{ end }}
            {{ end }}
          </div>
          {{ else }}
          <div class="home-sponsor-row">
            <a href="/sponsor">Your logo here</a>
          </div>
          {{ end }}
        </section>

        <section class="home-subscribe">
          <div>
            <h2>Don't miss a single <span class="home-serif">moment.</span></h2>
            <p>Event announcements{{ if insiderVisible }} and Insider dispatches{{ end }}, direct to your inbox.</p>
          </div>
          <form method="post" action="/newsletter/subscribe" hx-post="/newsletter/subscribe" hx-target="#home-newsletter-result" hx-swap="innerHTML">
            <input type="email" name="newsletter-email" required autocomplete="email" placeholder="hello@example.com" aria-label="Email address">
            <button type="submit">Subscribe</button>
            <div id="home-newsletter-result" role="status" aria-live="polite"></div>
          </form>
        </section>

        <section class="home-journey">
          <div class="home-section-head home-section-head--inset">
            <div>
              <h2 class="home-section-title">bitcoin++ through the <span class="home-serif">years.</span></h2>
            </div>
            <a href="/events" class="home-button is-outline">The full timeline</a>
          </div>
          <div class="home-year-grid">
            {{ range .Years }}
            <a href="/events#y{{ .Year }}" class="home-year">
              <strong>{{ .Year }}</strong>
              <p>{{ len .Confs }} edition{{ if ne (len .Confs) 1 }}s{{ end }} in the permanent record.</p>
            </a>
            {{ end }}
          </div>
        </section>
      </main>

      {{ template "generic_conf_footer" . }}
    </div>
  </body>
</html>
