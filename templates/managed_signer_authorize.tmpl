{{ define "managed_signer_authorize.tmpl" -}}
<!doctype html>
<html lang="en"><head><title>Authorize signer · bitcoin++</title>
{{ template "account_security_head" . }}
<link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-account-details">
</head>
<body class="btcpp-login-page account-flow account-flow--signer">
{{ $signingRequest := or (eq .Action "sign") (eq .Action "sign_event") }}
{{ $identityChange := or (eq .Action "rotate_identity") (eq .Action "recover_identity") }}
{{ template "account_security_brand" . }}<main class="auth-shell auth-shell--simple{{ if or .BatchRecipients .AwardRecipient (not (or $signingRequest $identityChange)) }} auth-shell--wide{{ end }}"><section class="auth-card">
  {{ if eq .Action "create_identity" }}
  <h1>Create a Nostr signer for <em>{{ .TenantName }}</em>?</h1>
  <p class="managed-signer-consent__intro">This creates a dedicated Nostr identity for <strong>{{ .TenantName }}</strong> to create and manage Bitcoin++ badges.</p>
  {{ else if eq .Action "connect_login" }}
  <h1>Connect <em>{{ .TenantName }}</em> to {{ if .ApplicationName }}{{ .ApplicationName }}{{ else }}Badge Studio{{ end }}?</h1>
  <p><strong>{{ .PersonName }}</strong> is connecting the managed signer for <strong>{{ .TenantName }}</strong>{{ if .ApplicationURL }} (<a href="{{ .ApplicationURL }}" rel="noreferrer">{{ .ApplicationURL }}</a>){{ end }}.</p>
  {{ else if $identityChange }}
  <h1>{{ if eq .Action "rotate_identity" }}Rotate{{ else }}Recover{{ end }} the signer for <em>{{ .TenantName }}</em>?</h1>
  <p>Requested by <strong>{{ .PersonName }}</strong>.</p>
  {{ else if $signingRequest }}
  <h1>{{ if eq .EventKind 8 }}Award <em>{{ if .BadgeName }}{{ .BadgeName }}{{ else }}this badge{{ end }}</em>?{{ else }}Review <em>{{ if .ContentTitle }}{{ .ContentTitle }}{{ else }}this request{{ end }}</em>.{{ end }}</h1>
  <p><strong>{{ .PersonName }}</strong> is {{ if eq .EventKind 8 }}awarding badges{{ else }}requesting a signature{{ end }} for <strong>{{ .TenantName }}</strong>.</p>
  {{ else }}
  <h1>{{ if and (eq .EventKind 8) (gt .RecipientCount 1) }}Review this badge batch.{{ else }}Review this signing request.{{ end }}</h1>
  <p><strong>{{ .PersonName }}</strong> is authorizing the managed signer for <strong>{{ .TenantName }}</strong>.</p>
  {{ end }}
  {{ if .Error }}<p class="managed-signer-consent__error" role="alert">{{ .Error }}</p>{{ end }}
  {{ if $signingRequest }}
  {{ template "managed_signer_signing_review" . }}
  {{ else if and (ne .Action "connect_login") (ne .Action "create_identity") (not $identityChange) }}
  <dl>
    <div><dt>{{ if eq .Tenant "organization" }}organization{{ else }}account{{ end }}</dt><dd><strong>{{ .TenantName }}</strong></dd></div>
    <div><dt>your role</dt><dd>{{ .Role }}</dd></div>
    <div><dt>requested action</dt><dd>{{ .ActionLabel }}</dd></div>
    {{ if .ApplicationName }}<div><dt>requesting application</dt><dd>{{ .ApplicationName }}</dd></div>{{ end }}
    {{ if .ApplicationURL }}<div><dt>application address</dt><dd><code>{{ .ApplicationURL }}</code></dd></div>{{ end }}
    {{ if .ContentTitle }}<div><dt>title</dt><dd>{{ .ContentTitle }}</dd></div>{{ end }}
    {{ if .ContentIdentifier }}<div><dt>content identifier</dt><dd><code>{{ .ContentIdentifier }}</code></dd></div>{{ end }}
    {{ if .StreamStatus }}<div><dt>live stream status</dt><dd><strong>{{ .StreamStatus }}</strong></dd></div>{{ end }}
    {{ if .ContentBody }}<div><dt>content to sign</dt><dd>{{ .ContentBody }}</dd></div>{{ end }}
    {{ if .ContentTags }}<div><dt>content metadata</dt><dd><details><summary>Review all event tags</summary>{{ range .ContentTags }}<p>{{ range . }}<code>{{ . }}</code> {{ end }}</p>{{ end }}</details></dd></div>{{ end }}
    {{ if .HTTPURL }}<div><dt>exact login destination</dt><dd><strong>{{ .HTTPMethod }}</strong> <code>{{ .HTTPURL }}</code></dd></div>{{ end }}
    {{ if .BadgeName }}<div><dt>badge being published</dt><dd><strong>{{ .BadgeName }}</strong> · <code>{{ .BadgeIdentifier }}</code></dd></div>{{ end }}
    {{ if .BadgeImage }}<div><dt>badge artwork URL</dt><dd><code>{{ .BadgeImage }}</code></dd></div>{{ end }}
    {{ if .BadgeDescription }}<div><dt>badge description</dt><dd>{{ .BadgeDescription }}</dd></div>{{ end }}
    {{ if .RecipientCount }}<div><dt>recipients</dt><dd>{{ .RecipientCount }}{{ if .VerifiedGrants }} · {{ .VerifiedGrants }} bitcoin++ grant{{ if ne .VerifiedGrants 1 }}s{{ end }} verified{{ end }}</dd></div>{{ end }}
    {{ if .AwardRecipient }}<div><dt>exact recipient</dt><dd><code>{{ .AwardRecipient }}</code></dd></div>{{ end }}
    {{ if .BadgeAddress }}<div><dt>badge definition</dt><dd><code>{{ .BadgeAddress }}</code></dd></div>{{ end }}
    {{ if .RevocationEventID }}<div><dt>award being revoked</dt><dd><code>{{ .RevocationEventID }}</code>{{ if .RevocationReason }} · {{ .RevocationReason }}{{ end }}</dd></div>{{ end }}
    {{ if .ProfileBadgeCount }}<div><dt>accepted badges</dt><dd>{{ .ProfileBadgeCount }}</dd></div>{{ end }}
    {{ if and .EventHash (ne .Action "connect_login") }}<div><dt>{{ if and (eq .EventKind 8) (gt .RecipientCount 1) }}exact batch hash{{ else }}exact event hash{{ end }}</dt><dd><code>{{ .EventHash }}</code></dd></div>{{ end }}
  </dl>
  {{ end }}
  {{ if .Permissions }}
  <section class="managed-signer-permissions" aria-labelledby="permissions-title">
    <h2 id="permissions-title">Requested permissions</h2>
    <p>This connection can request the following actions. Future signing requests still need your approval.</p>
    <ul role="list">
      {{ range .Permissions }}
      <li><span class="managed-signer-permissions__check" aria-hidden="true">✓</span><div>
        {{ if eq . "sign_event:27235" }}<strong>Sign in</strong><p>Prove your identity to the application with a signed login request.</p>
        {{ else if eq . "sign_event:30009" }}<strong>Create and update badges</strong><p>Sign badge definitions, including their name, description, and artwork.</p>
        {{ else if eq . "sign_event:8" }}<strong>Award badges</strong><p>Sign a badge award for a recipient.</p>
        {{ else if eq . "sign_event_batch:8" }}<strong>Award badges to a group</strong><p>Sign a batch of badge awards, with one award per recipient.</p>
        {{ else if eq . "sign_event:5" }}<strong>Revoke badges</strong><p>Sign a deletion request to revoke a previously issued badge award.</p>
        {{ else if eq . "sign_event:10008" }}<strong>Display accepted badges</strong><p>Sign the list of badges you accept and display on your profile.</p>
        {{ else if eq . "sign_event:1" }}<strong>Publish short posts</strong><p>Sign short text posts for publication on Nostr.</p>
        {{ else if eq . "sign_event:30023" }}<strong>Publish articles</strong><p>Sign long-form articles and updates to them.</p>
        {{ else if eq . "sign_event:30311" }}<strong>Publish live stream details</strong><p>Sign a live stream’s title, schedule, status, and other details.</p>
        {{ else }}<strong>Additional permission</strong><p><code>{{ . }}</code></p>
        {{ end }}
      </div></li>
      {{ end }}
    </ul>
  </section>
  {{ end }}
  {{ if and .ApplicationName (ne .Action "connect_login") (not $signingRequest) }}<p class="managed-signer-consent__note">Application names and addresses are supplied by the requesting client. Verify them before approving.</p>{{ end }}
  {{ if eq .Action "rotate_identity" }}<p>Creates new Nostr and encryption keys. All apps are disconnected, and other managers must set up access again.</p>{{ end }}
  {{ if eq .Action "recover_identity" }}<p>Keeps the existing Nostr identity. All apps are disconnected, and every manager must set up access again.</p>{{ end }}
  {{ if and .BatchRecipients (not $signingRequest) }}<details><summary>review exact recipients</summary><ol>{{ range .BatchRecipients }}<li><code>{{ .Pubkey }}</code>{{ if .SubjectProfileURL }} · <a href="{{ .SubjectProfileURL }}" rel="noreferrer">profile</a>{{ end }}{{ if .GrantID }} · verified bitcoin++ grant{{ end }}</li>{{ end }}</ol></details>{{ end }}
  <form class="auth-form" method="post" action="/signer/authorize">
    <input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="return_to" value="{{ .ReturnTo }}"><input type="hidden" name="tenant" value="{{ .Tenant }}"><input type="hidden" name="tenant_id" value="{{ .TenantID }}"><input type="hidden" name="action" value="{{ .Action }}"><input type="hidden" name="event_hash" value="{{ .EventHash }}"><input type="hidden" name="target" value="{{ .Target }}"><input type="hidden" name="event_kind" value="{{ .EventKind }}"><input type="hidden" name="recipient_count" value="{{ .RecipientCount }}">
    <button class="auth-primary" name="decision" value="allow">{{ if eq .Action "create_identity" }}Continue to signer setup →{{ else if eq .Action "connect_login" }}Connect &amp; sign in →{{ else if eq .Action "rotate_identity" }}Rotate signer →{{ else if eq .Action "recover_identity" }}Recover signer →{{ else if and $signingRequest (eq .EventKind 8) (gt .RecipientCount 0) }}Award {{ .RecipientCount }} badge{{ if ne .RecipientCount 1 }}s{{ end }} →{{ else }}Authorize with bitcoin++ →{{ end }}</button>
    <div class="auth-form__actions"><button class="auth-text-link" data-site-controls="off" type="submit" name="decision" value="deny">{{ if eq .Action "create_identity" }}Cancel setup{{ else }}Cancel{{ end }} →</button></div>
  </form>
</section></main>{{ template "account_security_footer" . }}</body></html>
{{- end }}


{{ define "managed_signer_signing_review" -}}
<section class="signer-review" aria-label="Signing request">
  {{ if .RecipientCount }}
  <div class="signer-review__recipients">
    <strong>{{ .RecipientCount }} recipient{{ if ne .RecipientCount 1 }}s{{ end }}{{ if eq .VerifiedGrants .RecipientCount }} <span class="signer-review__verified" role="img" aria-label="All bitcoin++ grants verified" title="All bitcoin++ grants verified">✓</span>{{ end }}</strong>
    {{ if and .VerifiedGrants (ne .VerifiedGrants .RecipientCount) }}<p>{{ .VerifiedGrants }} bitcoin++ grant{{ if ne .VerifiedGrants 1 }}s{{ end }} verified</p>{{ end }}
  </div>
  {{ end }}
  {{ if .BadgeDescription }}<p>{{ .BadgeDescription }}</p>{{ end }}
  {{ if ne .EventKind 8 }}{{ if .ActionLabel }}<p>{{ .ActionLabel }}</p>{{ end }}{{ end }}
  {{ if .StreamStatus }}<p>Live stream: <strong>{{ .StreamStatus }}</strong></p>{{ end }}
  {{ if .ContentBody }}<div class="signer-review__content">{{ .ContentBody }}</div>{{ end }}
  {{ if .HTTPURL }}<p>Sign in to <a href="{{ .HTTPURL }}" rel="noreferrer">{{ .HTTPURL }}</a>{{ if .HTTPMethod }} ({{ .HTTPMethod }}){{ end }}.</p>{{ end }}
  {{ if .RevocationReason }}<p>{{ .RevocationReason }}</p>{{ end }}
  {{ if .ProfileBadgeCount }}<p><strong>{{ .ProfileBadgeCount }}</strong> accepted badge{{ if ne .ProfileBadgeCount 1 }}s{{ end }}.</p>{{ end }}
  {{ if or .ApplicationName .ApplicationURL }}
  <p class="signer-review__application">Requested by {{ if .ApplicationName }}<strong>{{ .ApplicationName }}</strong>{{ if .ApplicationURL }} (<a href="{{ .ApplicationURL }}" rel="noreferrer">{{ .ApplicationURL }}</a>){{ end }}{{ else }}<a href="{{ .ApplicationURL }}" rel="noreferrer">{{ .ApplicationURL }}</a>{{ end }}.</p>
  {{ end }}
  {{ if .BatchRecipients }}
  <details><summary>Review {{ len .BatchRecipients }} recipient{{ if ne (len .BatchRecipients) 1 }}s{{ end }}</summary>
    <ol>{{ range .BatchRecipients }}<li><code>{{ .Pubkey }}</code>{{ if .SubjectProfileURL }} · <a href="{{ .SubjectProfileURL }}" rel="noreferrer">View profile →</a>{{ end }}{{ if .GrantID }}<span class="signer-review__grant">Verified bitcoin++ grant</span>{{ end }}</li>{{ end }}</ol>
  </details>
  {{ else if .AwardRecipient }}
  <details><summary>Review recipient</summary><div class="signer-review__technical"><code>{{ .AwardRecipient }}</code></div></details>
  {{ end }}
  {{ if and (not .Error) (ne .EventKind 8) }}
  <details><summary>Signing details</summary><div class="signer-review__technical">
    {{ if .Role }}<p><strong>Your role</strong>{{ .Role }}</p>{{ end }}
    {{ if .ActionLabel }}<p><strong>Requested action</strong>{{ .ActionLabel }}</p>{{ end }}
    {{ if .BadgeName }}<p><strong>Badge</strong>{{ .BadgeName }}</p>{{ end }}
    {{ if .BadgeIdentifier }}<p><strong>Badge ID</strong><code>{{ .BadgeIdentifier }}</code></p>{{ end }}
    {{ if .BadgeImage }}<p><strong>Badge artwork</strong><a href="{{ .BadgeImage }}" rel="noreferrer">{{ .BadgeImage }}</a></p>{{ end }}
    {{ if .BadgeAddress }}<p><strong>Badge definition</strong><code>{{ .BadgeAddress }}</code></p>{{ end }}
    {{ if .RevocationEventID }}<p><strong>Award being revoked</strong><code>{{ .RevocationEventID }}</code></p>{{ end }}
    {{ if .ContentIdentifier }}<p><strong>Content ID</strong><code>{{ .ContentIdentifier }}</code></p>{{ end }}
    {{ if .ContentTags }}<div><strong>Event tags</strong>{{ range .ContentTags }}<p>{{ range . }}<code>{{ . }}</code> {{ end }}</p>{{ end }}</div>{{ end }}
    {{ if .EventHash }}<p><strong>{{ if and (eq .EventKind 8) (gt .RecipientCount 1) }}Exact batch hash{{ else }}Exact event hash{{ end }}</strong><code>{{ .EventHash }}</code></p>{{ end }}
    {{ if .ApplicationName }}<p class="managed-signer-consent__note">Application names and addresses are supplied by the requesting client. Verify them before approving.</p>{{ end }}
  </div></details>
  {{ end }}
</section>
{{- end }}
