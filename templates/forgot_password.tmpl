<!DOCTYPE html>
<html>
<head>
  <title>Reset password · bitcoin++</title>
  {{ block "header" . }} {{ end }}
</head>
<body class="btcpp-admin-page h-full">
  {{ block "mainnav" . }} {{ end }}
  <main class="profile-edit-shell">
    <div class="profile-edit-back"><a href="/login">← Sign in</a></div>
    <header class="profile-edit-hero">
      <p class="profile-edit-tag">§ ACCOUNT RECOVERY</p>
      <h1>Reset your <span>password.</span></h1>
      <p>Enter a verified email on your account. We’ll send a one-use link if it matches.</p>
    </header>
    {{ if .FlashMessage }}<div class="profile-edit-flash">{{ .FlashMessage }}</div>{{ end }}
    <section class="profile-edit-section is-open">
      <div class="profile-edit-section__index">@</div>
      <div class="profile-edit-section__body">
        <form method="POST" action="/forgot-password" class="person-email-add">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <label>EMAIL <input type="email" name="email" required autocomplete="email"></label>
          <button type="submit">Send reset link</button>
        </form>
      </div>
    </section>
  </main>
  {{ block "footer" . }} {{ end }}
</body>
</html>
