<!doctype html>
<html lang="en">
<head>
  <title>Reset password · bitcoin++</title>
  {{ template "header" . }}
  <link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-account-flows">
</head>
<body class="btcpp-login-page account-flow">
  {{ template "mainnav" . }}
  <main class="auth-shell auth-shell--simple">
    <section class="auth-card">
      <header class="auth-card__head">
        <h1>Reset your <em>password.</em></h1>
        <p>Enter a verified email on your account. We’ll send a one-use link if it matches.</p>
      </header>
      {{ if .FlashMessage }}<div class="auth-alert auth-alert--success" role="status">{{ .FlashMessage }}</div>{{ end }}
      <form method="POST" action="/forgot-password" class="auth-form">
        <input type="hidden" name="csrf" value="{{ .CSRF }}">
        <label>Email <input type="email" name="email" required autocomplete="email"></label>
        <button class="auth-primary" type="submit">Send reset link <span aria-hidden="true">→</span></button>
      </form>
      <div class="auth-form auth-form__actions"><a href="/login">Cancel and return to sign in →</a></div>
    </section>
  </main>
  {{ template "footer" . }}
</body>
</html>
