<!DOCTYPE html>
<html lang="en">
<head>
  <title>{{ .Organization.Name }} sponsor dashboard - bitcoin++</title>
  {{ block "header" . }}{{ end }}
</head>
<body class="btcpp-dashboard-page sponsor-dashboard-page">
  {{ block "mainnav" . }}{{ end }}
  {{ template "dashboard_tabs" (dict "Active" "sponsor" "ShowHackathons" .HasHackathonProjects "ShowSponsor" true "ShowAdmin" .IsGlobalAdmin) }}
  <div class="dashboard-shell">
    <main class="dashboard-main">
      {{ if .FlashMessage }}<div class="dashboard-flash is-success"><p>{{ .FlashMessage }}</p></div>{{ end }}
      {{ if .FlashError }}<div class="dashboard-flash is-error"><p>{{ .FlashError }}</p></div>{{ end }}

      <header class="dashboard-workspace-hero sponsor-dashboard-hero">
        <div class="dashboard-workspace-hero__identity">
          <div class="dashboard-workspace-hero__mark sponsor-dashboard-hero__logo">
            {{ if .Organization.LogoLight }}
            <img src="{{ .Organization.LogoLight | safeURL }}" alt="{{ .Organization.Name }}">
            {{ else }}
            <span>{{ printf "%.1s" .Organization.Name }}</span>
            {{ end }}
          </div>
          <div class="dashboard-workspace-hero__copy sponsor-dashboard-hero__copy">
            <div class="dashboard-kicker">● Sponsor workspace · {{ .Membership.Role }}</div>
            <h1>{{ .Organization.Name }}</h1>
            <p>{{ if .Organization.Tagline }}{{ .Organization.Tagline }}{{ else }}Manage your bitcoin++ sponsorship, team, tickets, and hackathon activity.{{ end }}</p>
          </div>
        </div>
        <dl class="dashboard-workspace-hero__facts sponsor-dashboard-hero__facts" aria-label="Workspace summary">
          <div><dt>Active events</dt><dd>{{ len .Upcoming }}</dd></div>
          <div><dt>Team members</dt><dd>{{ len .Members }}</dd></div>
          <div><dt>Access</dt><dd>{{ if .CanManage }}Manage{{ else }}View{{ end }}</dd></div>
        </dl>
        {{ if gt (len .Memberships) 1 }}
        <nav class="sponsor-dashboard-org-switcher" aria-label="Sponsor organizations">
          {{ range .Memberships }}
          <a href="/dashboard/sponsor/{{ .OrganizationID }}"{{ if eq .OrganizationID $.Organization.Ref }} class="is-active" aria-current="page"{{ end }}>{{ .Organization.Name }}</a>
          {{ end }}
        </nav>
        {{ end }}
      </header>

      <nav class="sponsor-workspace-nav" aria-label="Sponsor workspace sections">
        <a href="#sponsorships"><span>01</span> Sponsorships</a>
        <a href="#prize-entrants"><span>02</span> Prize entrants</a>
        <a href="#team"><span>03</span> Team</a>
        <a href="#profile"><span>04</span> Public profile</a>
        {{ if .Past }}<a href="#history"><span>05</span> Trophy case</a>{{ end }}
      </nav>

      <section class="sponsor-dashboard-section dashboard-workspace-panel" id="sponsorships">
        <div class="sponsor-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Upcoming</div><h2>Active sponsorships.</h2></div>
          <p>Benefits shown here come from the event agreement, not just the public tier name.</p>
        </div>
        {{ if .Upcoming }}
        <div class="sponsor-event-grid">
          {{ range .Upcoming }}
          <article class="sponsor-event-card dashboard-workspace-widget">
            <header class="sponsor-event-card__header">
              <div class="sponsor-event-card__eyebrow"><span>{{ .Sponsorship.Level }} sponsor</span><span>{{ .Sponsorship.Status }}</span></div>
              <h3>{{ .Conference.Desc }}</h3>
              <p>{{ .Conference.DateDesc }}{{ if .Conference.Location }} · {{ .Conference.Location }}{{ end }}</p>
            </header>
            <dl>
              <div class="sponsor-event-card__metric"><dt>Tickets issued</dt><dd>{{ .TicketsIssued }} <span>/ {{ .Entitlement.TicketAllocation }}</span></dd><i aria-hidden="true"><b style="width: {{ $.TicketUsePercent . }}%"></b></i></div>
              <div class="sponsor-event-card__metric"><dt>Sponsor prizes</dt><dd>{{ .AwardCount }} <span>/ {{ .Entitlement.SponsorAwardLimit }}</span></dd><i aria-hidden="true"><b style="width: {{ $.ProposalUsePercent . }}%"></b></i></div>
              <div><dt>Past winners</dt><dd>{{ .WinnerCount }}</dd></div>
              <div><dt>Participant contacts</dt><dd>{{ if .Entitlement.ParticipantContactAccess }}Opt-in only{{ else }}Not included{{ end }}</dd></div>
            </dl>
            <nav class="sponsor-event-card__links" aria-label="{{ .Conference.Desc }} links">
              <a href="/{{ .Conference.Tag }}">Event page →</a>
              {{ if .Conference.ShowHackathon }}<a href="/{{ .Conference.Tag }}/hackathon">Browse hackathon →</a>{{ end }}
            </nav>
            {{ if $.CanManage }}
            {{ $remainingTickets := $.TicketsRemaining . }}
            {{ $batchMaximum := $.TicketBatchMaximum . }}
            {{ if gt $remainingTickets 0 }}
            <details class="sponsor-benefit-action">
              <summary><span>Issue sponsor tickets</span><small>{{ $remainingTickets }} remaining</small></summary>
              <form method="POST" action="/dashboard/sponsor/{{ $.Organization.Ref }}/tickets" class="sponsor-benefit-form sponsor-ticket-form">
                <input type="hidden" name="csrf" value="{{ $.CSRF }}">
                <input type="hidden" name="SponsorshipID" value="{{ .Sponsorship.Ref }}">
                <input type="hidden" name="ConferenceID" value="{{ .Conference.Ref }}">
                <p class="sponsor-benefit-form__intro">{{ $remainingTickets }} ticket{{ if ne $remainingTickets 1 }}s{{ end }} remaining. Tickets are emailed directly to the recipient.</p>
                <label><span>Recipient email</span><input name="Email" type="email" required placeholder="teammate@example.com"></label>
                <label><span>Quantity</span><input name="Quantity" type="number" min="1" max="{{ $batchMaximum }}" value="1" required></label>
                <button type="submit">Issue tickets →</button>
              </form>
            </details>
            {{ end }}
            {{ if .Competition }}
            {{ $proposalSlots := $.ProposalSlotsRemaining . }}
            {{ if gt $proposalSlots 0 }}
            <details class="sponsor-benefit-action">
              <summary><span>Propose a hackathon prize</span><small>{{ $proposalSlots }} slot{{ if ne $proposalSlots 1 }}s{{ end }} remaining</small></summary>
              <form method="POST" action="/dashboard/sponsor/{{ $.Organization.Ref }}/prize-proposals" class="sponsor-benefit-form sponsor-prize-form">
                <input type="hidden" name="csrf" value="{{ $.CSRF }}">
                <input type="hidden" name="SponsorshipID" value="{{ .Sponsorship.Ref }}">
                <input type="hidden" name="ConferenceID" value="{{ .Conference.Ref }}">
                <input type="hidden" name="CompetitionID" value="{{ .Competition.ID }}">
                <p class="sponsor-benefit-form__intro">{{ $proposalSlots }} proposal slot{{ if ne $proposalSlots 1 }}s{{ end }} remaining. Organizers review proposals before they appear publicly.</p>
                <fieldset>
                  <legend>Award</legend>
                  <div class="sponsor-benefit-form__grid">
                    <label class="is-wide"><span>Award title</span><input name="Title" required maxlength="160" placeholder="Best privacy project"></label>
                    <label class="is-wide"><span>Description</span><textarea name="Description" rows="3" maxlength="4000" placeholder="What kind of work should this award celebrate?"></textarea></label>
                    <label class="is-wide"><span>Judging guidance</span><textarea name="JudgingInstructions" rows="2" maxlength="4000" placeholder="What should judges pay attention to?"></textarea></label>
                    <label><span>Maximum winners</span><input name="MaxAwardees" type="number" min="1" max="100" value="1" required></label>
                  </div>
                </fieldset>
                <fieldset>
                  <legend>Prize</legend>
                  <div class="sponsor-benefit-form__grid">
                    <label><span>Prize type</span><select name="PrizeType"><option value="sats">Satoshis</option><option value="in_kind">In kind</option><option value="tickets">Tickets</option><option value="trophy">Trophy</option></select></label>
                    <label><span>Prize title</span><input name="PrizeTitle" required maxlength="160" placeholder="1,000,000 sats"></label>
                    <label><span>Value in sats</span><input name="PrizeValueText" inputmode="numeric" pattern="[0-9]+" required placeholder="1000000"></label>
                    <label class="is-wide"><span>Prize details</span><textarea name="PrizeDescription" rows="2" maxlength="4000" placeholder="Include delivery details or any non-cash components."></textarea></label>
                  </div>
                </fieldset>
                <fieldset class="sponsor-benefit-options">
                  <legend>Eligibility</legend>
                  <label class="sponsor-profile-checkbox"><input name="OptInRequired" type="checkbox" checked><span>Projects must opt in to compete</span></label>
                  <label class="sponsor-profile-checkbox"><input name="FinalistsOnly" type="checkbox"><span>Only finalists are eligible</span></label>
                </fieldset>
                <button type="submit">Send proposal →</button>
              </form>
            </details>
            {{ end }}
            {{ end }}
            {{ end }}
            {{ $proposals := $.ProposalsFor .Sponsorship.Ref }}
            {{ if $proposals }}
            <div class="sponsor-benefit-history">
              <strong>Prize proposals</strong>
              {{ range $proposals }}<p><span class="is-{{ .Status }}">{{ .Status }}</span> {{ .Title }} · {{ .PrizeTitle }}{{ if .ReviewNotes }} — {{ .ReviewNotes }}{{ end }}</p>{{ end }}
            </div>
            {{ end }}
            {{ $issuances := $.TicketIssuancesFor .Sponsorship.Ref }}
            {{ if $issuances }}
            <div class="sponsor-benefit-history">
              <strong>Recently issued</strong>
              {{ range $issuances }}<p>{{ .Quantity }} ticket{{ if ne .Quantity 1 }}s{{ end }} · {{ .RecipientEmail }} · {{ .CreatedAt.Format "Jan 2, 2006" }}</p>{{ end }}
            </div>
            {{ end }}
          </article>
          {{ end }}
        </div>
        {{ else }}
        <div class="sponsor-dashboard-empty">No upcoming sponsorship is connected to this organization yet.</div>
        {{ end }}
      </section>

      <section class="sponsor-dashboard-section dashboard-workspace-panel" id="prize-entrants">
        <div class="sponsor-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Hackathon projects</div><h2>{{ if .CanViewAllHackathonSubmissions }}All submitted projects.{{ else }}Teams building for your challenges.{{ end }}</h2></div>
          <div class="sponsor-project-export">
            <p>{{ if .CanViewAllHackathonSubmissions }}Your sponsorship includes access to hackathon participant contact information{{ else }}Every project below explicitly entered an approved prize sponsored by {{ .Organization.Name }}. Contact details appear only through the included submission terms or an additional participant choice.{{ end }}</p>
            {{ if .CanExportParticipants }}<a href="/dashboard/sponsor/{{ .Organization.Ref }}/hackathon-projects.csv">Download participant CSV ↓</a>{{ end }}
          </div>
        </div>
        {{ if .PrizeEntries }}
        {{ with .CurrentHackathonEntries }}
        <div class="sponsor-project-era">
          <div class="sponsor-project-era__head"><span>Current hackathon</span><strong>{{ len . }} project{{ if ne (len .) 1 }}s{{ end }}</strong></div>
          <div class="sponsor-prize-entry-grid">{{ range . }}{{ template "sponsor_prize_entry" . }}{{ end }}</div>
        </div>
        {{ end }}
        {{ with .PastHackathonEntries }}
        <details class="sponsor-project-era sponsor-project-era--past">
          <summary><span>Past hackathons</span><strong>{{ len . }} archived project{{ if ne (len .) 1 }}s{{ end }}</strong></summary>
          <div class="sponsor-prize-entry-grid">{{ range . }}{{ template "sponsor_prize_entry" . }}{{ end }}</div>
        </details>
        {{ end }}
        {{ else }}
        <div class="sponsor-dashboard-empty">{{ if .CanViewAllHackathonSubmissions }}No hackathon projects have been submitted yet.{{ else }}No projects have entered an approved {{ .Organization.Name }} prize yet.{{ end }}</div>
        {{ end }}
      </section>

      <section class="sponsor-dashboard-section dashboard-workspace-panel" id="team">
          <div class="sponsor-dashboard-section__head">
            <div><div class="dashboard-kicker">§ Team</div><h2>Organization managers.</h2></div>
          </div>
          <div class="sponsor-team-list">
            {{ range .Members }}
            <div class="sponsor-team-row">
              <div><strong>{{ .PersonName }}</strong><span>{{ .PersonEmail }}</span></div>
              <div class="sponsor-team-row__actions">
                <span class="sponsor-team-role">{{ .Role }}</span>
                {{ if $.CanRemoveMember . }}
                <form method="POST" action="/dashboard/sponsor/{{ $.Organization.Ref }}/members/{{ .PersonID }}/remove" onsubmit="return confirm('{{ if eq $.Membership.PersonID .PersonID }}Leave this sponsor organization?{{ else }}Remove {{ .PersonName }} from this organization?{{ end }}');">
                  <input type="hidden" name="csrf" value="{{ $.CSRF }}">
                  <button type="submit">{{ if eq $.Membership.PersonID .PersonID }}Leave organization{{ else }}Remove{{ end }}</button>
                </form>
                {{ end }}
              </div>
            </div>
            {{ end }}
          </div>
          {{ if .CanManage }}
          <form method="POST" action="/dashboard/sponsor/{{ .Organization.Ref }}/invites" class="sponsor-invite-form">
            <input type="hidden" name="csrf" value="{{ .CSRF }}">
            <label><span>Invite a teammate</span><input name="email" type="email" required placeholder="teammate@example.com"></label>
            <label><span>Role</span><select name="role"><option value="manager">Manager</option><option value="member">Member</option></select></label>
            <button type="submit">Create invite →</button>
          </form>
          {{ if .InviteLink }}
          <div class="sponsor-invite-link"><strong>Secure invite link</strong><input readonly value="{{ .InviteLink }}" aria-label="Secure invite link"><p>Share it only with the invited email address. It expires in 72 hours and can be used once.</p></div>
          {{ end }}
          {{ end }}
      </section>

      <section class="sponsor-dashboard-section dashboard-workspace-panel" id="profile">
        <div class="sponsor-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Public profile</div><h2>How {{ .Organization.Name }} appears.</h2></div>
          <p>Internal sponsorship notes, tier, and contract details cannot be changed here.</p>
        </div>
        <div class="sponsor-profile-preview">
          <div class="sponsor-profile-preview__logo">
            {{ if .Organization.LogoLight }}<img src="{{ .Organization.LogoLight | safeURL }}" alt="">{{ else }}<span>{{ printf "%.1s" .Organization.Name }}</span>{{ end }}
          </div>
          <div>
            <span>Public sponsor card preview</span>
            <h3>{{ .Organization.Name }}</h3>
            <p>{{ if .Organization.Tagline }}{{ .Organization.Tagline }}{{ else }}No public tagline has been added yet.{{ end }}</p>
            {{ if .Organization.Website }}<a href="{{ .Organization.Website | safeURL }}" target="_blank" rel="noopener noreferrer">Visit website ↗</a>{{ end }}
          </div>
          {{ if .Organization.Hiring }}<strong>Hiring</strong>{{ end }}
        </div>
        {{ if .CanEditOrg }}
        <details class="sponsor-profile-editor">
          <summary>Edit public profile</summary>
        <form method="POST" enctype="multipart/form-data" action="/dashboard/sponsor/{{ .Organization.Ref }}/profile" class="sponsor-profile-form">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <fieldset class="sponsor-profile-group">
            <legend>Organization details</legend>
            <div class="sponsor-profile-grid">
              <label><span>Organization name</span><input name="Name" required value="{{ .Organization.Name }}"></label>
              <label><span>Contact email</span><input name="Email" type="email" value="{{ .Organization.Email }}"></label>
              <label class="is-wide"><span>Tagline or short blurb</span><textarea name="Tagline" rows="3">{{ .Organization.Tagline }}</textarea></label>
              <label><span>Website</span><input name="Website" type="url" value="{{ .Organization.Website }}"></label>
              <label class="sponsor-profile-checkbox"><input name="Hiring" type="checkbox"{{ if .Organization.Hiring }} checked{{ end }}><span>Show that our organization is hiring</span></label>
            </div>
          </fieldset>
          <fieldset class="sponsor-profile-group">
            <legend>Social links</legend>
            <div class="sponsor-profile-grid">
              <label><span>X handle</span><input name="Twitter" value="{{ .Organization.Twitter.Handle }}"></label>
              <label><span>GitHub</span><input name="Github" type="url" value="{{ .Organization.Github }}"></label>
              <label><span>LinkedIn</span><input name="LinkedIn" type="url" value="{{ .Organization.LinkedIn }}"></label>
              <label><span>Instagram</span><input name="Instagram" value="{{ .Organization.Instagram }}"></label>
              <label><span>YouTube</span><input name="Youtube" value="{{ .Organization.Youtube }}"></label>
              <label><span>Nostr</span><input name="Nostr" value="{{ .Organization.Nostr }}"></label>
              <label><span>Matrix</span><input name="Matrix" value="{{ .Organization.Matrix }}"></label>
            </div>
          </fieldset>
          <fieldset class="sponsor-profile-group">
            <legend>Logos</legend>
            <div class="sponsor-logo-variants">
              <div class="sponsor-logo-variant">
                <span>Light background</span>
                <div class="sponsor-logo-variant__preview is-light">
                  {{ if .Organization.LogoLight }}<img src="{{ .Organization.LogoLight | safeURL }}" alt="{{ .Organization.Name }} light-background logo">{{ else }}<em>No logo uploaded</em>{{ end }}
                </div>
                {{ if .SpacesReady }}
                <label><span>Replace light-background logo</span><input name="LogoLightFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml"></label>
                {{ end }}
              </div>
              <div class="sponsor-logo-variant">
                <span>Dark background</span>
                <div class="sponsor-logo-variant__preview is-dark">
                  {{ if .Organization.LogoDark }}<img src="{{ .Organization.LogoDark | safeURL }}" alt="{{ .Organization.Name }} dark-background logo">{{ else }}<em>No logo uploaded</em>{{ end }}
                </div>
                {{ if .SpacesReady }}
                <label><span>Replace dark-background logo</span><input name="LogoDarkFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml"></label>
                {{ end }}
              </div>
            </div>
          </fieldset>
          <button type="submit">Save public profile →</button>
        </form>
        </details>
        {{ else }}
        <div class="sponsor-dashboard-empty">Profile editing is not enabled for this sponsorship or your organization role.</div>
        {{ end }}
      </section>

      {{ if .Past }}
      <section class="sponsor-dashboard-section dashboard-workspace-panel" id="history">
        <div class="sponsor-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Trophy case</div><h2>Past sponsorships.</h2></div>
        </div>
        <div class="sponsor-trophy-grid">
          {{ range .Past }}
          <article><span>{{ .Conference.EmojiOrDefault }}</span><div><strong>{{ .Conference.ArchiveTitle }}</strong><p>{{ .Sponsorship.Level }} · {{ .WinnerCount }} winning project{{ if ne .WinnerCount 1 }}s{{ end }}</p></div></article>
          {{ end }}
        </div>
      </section>
      {{ end }}
    </main>
  </div>
  {{ block "footer" . }}{{ end }}
</body>
</html>

{{ define "sponsor_prize_entry" }}
<article class="sponsor-prize-entry">
  <header>
    <div>
      <span>{{ .ConferenceTitle }}{{ if .SponsoredPrize }} · {{ .AwardTitle }}{{ else }} · Hackathon submission{{ end }}</span>
      <h3>{{ with .ProjectNumber }}<b>#{{ . }}</b> {{ end }}{{ .ProjectTitle }}</h3>
    </div>
    <div class="sponsor-prize-entry__status">
      {{ if .Winner }}<strong>Winner</strong>{{ end }}
      <span>{{ .ProjectStatus }}</span>
    </div>
  </header>
  {{ if .ProjectImageURL }}<a class="sponsor-prize-entry__image" href="/{{ .ConferenceTag }}/hackathon/projects/{{ .ProjectID }}"><img src="{{ .ProjectImageURL | safeURL }}" alt=""></a>{{ end }}
  <div class="sponsor-prize-entry__body">
    {{ if .ProjectShortDescription }}<p>{{ .ProjectShortDescription }}</p>{{ end }}
    <nav aria-label="{{ .ProjectTitle }} links">
      <a href="/{{ .ConferenceTag }}/hackathon/projects/{{ .ProjectID }}">View project →</a>
      {{ if .GitHubURL }}<a href="{{ .GitHubURL | safeURL }}" target="_blank" rel="noopener noreferrer">Repository ↗</a>{{ end }}
      {{ if .DemoURL }}<a href="{{ .DemoURL | safeURL }}" target="_blank" rel="noopener noreferrer">Demo ↗</a>{{ end }}
    </nav>
  </div>
  <div class="sponsor-prize-entry__team">
    <strong>Team · {{ len .Participants }}</strong>
    {{ range .Participants }}
    <div class="sponsor-prize-participant">
      {{ if .PublicID }}<a class="sponsor-prize-participant__identity" href="/whois/{{ .PublicID }}">{{ else }}<span class="sponsor-prize-participant__identity">{{ end }}
        <span class="sponsor-prize-participant__avatar">
          <img src="{{ speakerPhoto .Photo }}" alt="" loading="lazy" data-image-fallback>
          <span data-image-fallback-copy hidden aria-hidden="true">++</span>
        </span>
        <span><b>{{ .Name }}</b><small>{{ .Role }}</small></span>
      {{ if .PublicID }}</a>{{ else }}</span>{{ end }}
      <div class="sponsor-prize-participant__contact">
        {{ if .Email }}
        <a href="mailto:{{ .Email }}">{{ .Email }}</a>
        <small>{{ if eq .ConsentScope "included_sponsorship" }}Included with submission{{ else if eq .ConsentScope "all_sponsors" }}Consented to other hackathon sponsors{{ else }}Consented through this prize{{ end }}</small>
        {{ else }}
        <span>Contact not shared</span>
        {{ end }}
      </div>
    </div>
    {{ end }}
  </div>
</article>
{{ end }}
