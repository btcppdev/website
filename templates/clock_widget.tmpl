<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>bitcoin++ conference clock</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
  <style>
    * { box-sizing:border-box; }
    html, body { width:100%; height:100%; margin:0; overflow:hidden; }
    body { display:flex; align-items:center; justify-content:center; background:#0a0a0a; color:#fff; font-family:'Montserrat',sans-serif; text-align:center; }
    .clock { width:100%; padding:8px; }
    .clock__time { display:block; font-size:clamp(24px,min(20vw,50vh),96px); font-weight:600; line-height:1.1; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .clock__zone { margin-top:8px; font-size:clamp(10px,4vw,14px); font-weight:400; line-height:1.4; color:#bcbcbc; overflow-wrap:anywhere; }
  </style>
</head>
<body>
  <main class="clock" data-timezone="{{ .Timezone }}" aria-label="Current conference local time">
    <time class="clock__time">{{ .Time }}</time>
    <div class="clock__zone">{{ .Timezone }}</div>
  </main>
  <script src="/static/js/clock-widget.js" defer></script>
</body>
</html>
