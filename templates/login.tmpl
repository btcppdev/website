<!DOCTYPE html>
<html>
<head>
  <title>Sign in · bitcoin++</title>
  {{ block "header" . }} {{ end }}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>&#128272;</text></svg>">
</head>
<body class="btcpp-login-page">
  {{ block "mainnav" . }} {{ end }}

  <main class="auth-shell">
    <aside class="auth-poster" aria-hidden="true">
      <div class="auth-poster__eyebrow">BITCOIN++ / ACCESS</div>
      <div class="auth-poster__mark">++</div>
      <div>
        <p>One profile.</p>
        <p>Every event.</p>
        <p class="auth-poster__accent">Your keys.</p>
      </div>
      <span class="auth-poster__note">Talks · tickets · hackathons · volunteering</span>
    </aside>

    <section class="auth-card" id="login">
      <header class="auth-card__head">
        <span class="auth-kicker">§ SIGN IN</span>
        <h1>Welcome <em>back.</em></h1>
        <p>Choose any method connected to your bitcoin++ profile.</p>
      </header>

      {{ if .FlashMessage }}
      <div class="auth-alert auth-alert--success">{{ .FlashMessage }}</div>
      {{ end }}
      {{ if .FlashError }}
      <div class="auth-alert auth-alert--error">{{ .FlashError }}</div>
      {{ end }}

      {{ if .OAuthProviders }}
      <div class="auth-methods" aria-label="OAuth sign-in methods">
        {{ range .OAuthProviders }}
          {{ if .Enabled }}
          <a class="auth-method auth-method--{{ .Key }}" href="{{ .LinkURL }}">
          {{ else }}
          <span class="auth-method auth-method--disabled auth-method--{{ .Key }}" aria-disabled="true" title="Add this provider's client ID and secret to .env">
          {{ end }}
            <span class="auth-method__icon" aria-hidden="true">
              {{ if eq .Key "github" }}
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 .8a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.2-3.1-.12-.29-.52-1.47.11-3.06 0 0 .98-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.75.81 1.2 1.84 1.2 3.1 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .8Z"/></svg>
              {{ else if eq .Key "discord" }}
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M19.5 5.3A17.2 17.2 0 0 0 15.2 4l-.5 1.1a15.8 15.8 0 0 0-5.4 0L8.8 4a17 17 0 0 0-4.3 1.3C1.8 9.3 1 13.2 1.4 17a17.5 17.5 0 0 0 5.3 2.7l1.3-1.8c-.7-.3-1.4-.7-2-1.2l.5-.4c3.8 1.8 7.9 1.8 11.6 0l.6.4c-.7.5-1.4.9-2.1 1.2l1.3 1.8a17.4 17.4 0 0 0 5.3-2.7c.5-4.4-.8-8.2-3.7-11.7ZM8.6 14.8c-1.1 0-2.1-1.1-2.1-2.5s.9-2.5 2.1-2.5 2.1 1.1 2.1 2.5-.9 2.5-2.1 2.5Zm6.8 0c-1.1 0-2.1-1.1-2.1-2.5s.9-2.5 2.1-2.5 2.1 1.1 2.1 2.5-.9 2.5-2.1 2.5Z"/></svg>
              {{ else if eq .Key "gitlab" }}
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="m12 22 4.4-13.5H7.6L12 22Z"/><path fill="currentColor" opacity=".78" d="M12 22 7.6 8.5 2 8.5 12 22Zm0 0 4.4-13.5H22L12 22Z"/><path fill="currentColor" opacity=".5" d="M2 8.5.4 13.4c-.2.6 0 1.2.5 1.6L12 22 2 8.5Zm20 0 1.6 4.9c.2.6 0 1.2-.5 1.6L12 22 22 8.5ZM2 8.5h5.6L5.2 1.2c-.1-.4-.7-.4-.8 0L2 8.5Zm14.4 0H22l-2.4-7.3c-.1-.4-.7-.4-.8 0l-2.4 7.3Z"/></svg>
              {{ else }}
              <span class="auth-method__monogram">MLH</span>
              {{ end }}
            </span>
            <span class="auth-method__copy"><strong>Continue with {{ .Label }}</strong>{{ if not .Enabled }}<small>Not configured locally</small>{{ end }}</span>
            <span class="auth-method__arrow" aria-hidden="true">↗</span>
          {{ if .Enabled }}</a>{{ else }}</span>{{ end }}
        {{ end }}
      </div>
      {{ end }}

      <div class="auth-methods auth-methods--native">
        <button type="button" class="auth-method" data-passkey-login data-next="{{ .Next }}">
          <span class="auth-method__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14.5 9.5a5.5 5.5 0 1 0-4 5.3V18h2v2h2v2h3v-3h-3v-4.2a5.5 5.5 0 0 0 0-5.3Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9" cy="9.5" r="1.2" fill="currentColor"/></svg></span>
          <span class="auth-method__copy"><strong>Sign in with a passkey</strong><small data-passkey-status>Touch ID, Face ID, or a security key</small></span>
          <span class="auth-method__arrow" aria-hidden="true">→</span>
        </button>
        <button type="button" class="auth-method auth-method--nostr" data-nostr-login data-next="{{ .Next }}">
          <span class="auth-method__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="m13.2 1-8 12h5.2L9.8 23l9-13h-5.4L13.2 1Z"/></svg></span>
          <span class="auth-method__copy"><strong>Sign in with Nostr</strong><small data-nostr-status>Sign with Alby or another NIP-07 extension</small></span>
          <span class="auth-method__arrow" aria-hidden="true">→</span>
        </button>
      </div>

      <div class="auth-divider"><span>or use your email</span></div>

      <form method="POST" action="/login/password" class="auth-form">
        <input type="hidden" name="Next" value="{{ .Next }}">
        <input type="hidden" name="csrf" value="{{ .CSRF }}">
        <label>EMAIL<input type="email" name="Email" autocomplete="email" placeholder="you@example.com" required></label>
        <label>PASSWORD<input type="password" name="Password" autocomplete="current-password" placeholder="••••••••••••" required></label>
        <div class="auth-form__actions">
          <button class="auth-primary" type="submit">Sign in with password <span>→</span></button>
          <a href="/forgot-password">Forgot password?</a>
        </div>
      </form>

      <details class="auth-email-link">
        <summary>Email me a one-time sign-in link</summary>
        <form method="POST" action="/login" class="auth-form auth-form--compact">
          <input type="hidden" name="Next" value="{{ .Next }}">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <label>EMAIL<input type="email" name="Email" autocomplete="email" placeholder="you@example.com" required></label>
          <button class="auth-secondary" type="submit">Send sign-in link</button>
        </form>
      </details>

      {{ if .DevLoginEnabled }}
      <aside class="auth-dev">
        <div><strong>LOCAL DEVELOPMENT</strong><span>No email is sent.</span></div>
        <form method="POST" action="/login">
          <input type="hidden" name="Next" value="{{ .Next }}">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <input type="email" name="Email" value="mara.chen@example.test" aria-label="Seeded development email" required>
          <button type="submit" name="Action" value="dev-login">Dev sign in →</button>
        </form>
      </aside>
      {{ end }}
    </section>
  </main>

  {{ block "footer" . }} {{ end }}
  <script src="/static/js/nostr-login.js" defer></script>
  <script src="/static/js/passkey.js" defer></script>
</body>
</html>
