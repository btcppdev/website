<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Payment confirmed</title></head>
<body style="margin:0;background:#f6f3ee;color:#171717;font-family:Arial,sans-serif">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td align="center" style="padding:24px 12px">
<table role="presentation" width="600" cellspacing="0" cellpadding="0" style="width:100%;max-width:600px;background:#fff;border:1px solid #171717">
<tr><td style="padding:24px;background:#ffb65e;font-weight:bold">bitcoin++ / shop</td></tr>
<tr><td style="padding:24px"><p style="font-size:12px;letter-spacing:1px">PAYMENT CONFIRMED</p><h1 style="font-size:28px;margin:12px 0">Your merch just sold.</h1>
<p>A customer purchased items from <strong>{{ .OrganizationName }}</strong>.</p>
<p style="overflow-wrap:anywhere">Purchase: {{ .Reference }}{{ if .Event }}<br>Event: {{ .Event }}{{ end }}</p>
<table width="100%" cellspacing="0" cellpadding="0">{{ range .Items }}<tr><td style="padding:14px 0;border-bottom:1px solid #ddd"><strong>{{ .Quantity }} × {{ .Name }}</strong><br><span style="font-size:14px;color:#555">{{ .Variant }}<br>{{ shopFulfillmentLabel .Fulfillment }}</span></td></tr>{{ end }}</table>
{{ if .Earnings }}<p style="margin-top:24px">Your organization's share<br><strong style="font-size:24px">{{ .Earnings }}</strong></p><p style="font-size:13px;color:#555">After the bitcoin++ fee, excluding shipping and tax. This records the sale, not a payout; refunds may change the amount due.</p>{{ end }}
<p>Open your shop to review the purchase and any shipping needed.</p>
<p style="margin:28px 0"><a href="{{ .URL }}" style="display:inline-block;padding:14px 20px;background:#171717;color:#fff;text-decoration:none;font-weight:bold">View purchases &amp; shipping →</a></p>
<p style="font-size:12px;color:#666">You’re receiving this because you’re an owner or manager of {{ .OrganizationName }}.</p>
</td></tr></table></td></tr></table></body></html>
