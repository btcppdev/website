<!doctype html>
<html lang="en">
  <head>
    <title>{{ .Title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/static/css/site-chrome.css?v=20261121-ticker-colors">
    <link rel="stylesheet" href="/static/css/btcpp-redesign.css?v=20261121-no-eyebrows">
    <link rel="stylesheet" href="/static/css/shop.css?v=20261121-no-eyebrows">
    <link rel="stylesheet" href="/static/css/site-navigation.css?v=20261121-stable-header">
  <link rel="stylesheet" href="/static/css/site-controls.css?v=20261121-header-orange">
</head>
  <body class="shop-page">
    {{ template "mainnav" . }}
    {{ template "shop_header" . }}
    <main class="shop-listing">
      <div class="shop-listing__head">
        <h1>{{ .CollectionHeading }}</h1>
        <p>{{ .CollectionDescription }}</p>
      </div>
      {{ template "shop_category_nav" . }}
      {{ template "shop_product_grid" .Products }}
    </main>
    {{ template "shop_footer" . }}
  </body>
</html>
