<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>bitcoin++ merch receipt</title></head>
<body style="margin:0;background:#f5f0e4;color:#131313;font-family:Arial,sans-serif">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td style="padding:16px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;margin:0 auto;background:#fffaf0;border:1px solid #151515"><tr><td style="padding:16px">
{{ if .AccountView }}<p><a href="/dashboard/orders" style="color:#131313">← Order history</a></p>{{ end }}
<p style="font-weight:bold">bitcoin++ · {{ .Event }}</p><h1 style="font-size:28px">Payment received.</h1><p>Merch receipt · Paid with Lightning</p>
<p style="font-size:12px;overflow-wrap:anywhere">Sale {{ .Sale.ID }}<br>{{ with .Sale.PaidAt }}{{ .UTC.Format "Jan 2, 2006 · 15:04 UTC" }}{{ end }}</p>
<table width="100%" cellpadding="0" cellspacing="0" aria-label="Purchased items">{{ range .Items }}<tr><td style="padding:12px 0;border-bottom:1px solid #ccc">{{ .Quantity }} × <strong>{{ .Name }}</strong><br><span style="color:#666;font-size:13px">{{ .Label }} · {{ .Unit }} each</span></td><td style="padding:12px 0 12px 12px;text-align:right;border-bottom:1px solid #ccc">{{ .Total }}</td></tr>{{ end }}</table>
<p style="font-size:22px;font-weight:bold">Total paid: {{ .Total }}<br><span style="font-size:13px;font-weight:normal;color:#777">{{ .Local }} · estimate at purchase</span></p>
<p style="color:#666;font-size:13px">Save this receipt for your records. Questions? Email hello@btcpp.dev.</p>
</td></tr></table></td></tr></table></body></html>
