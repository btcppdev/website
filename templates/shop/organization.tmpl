<!doctype html>
<html lang="en">
<head>
  <title>Shop · {{ .Organization.Name }} - bitcoin++</title>
  {{ block "header" . }}{{ end }}
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="/static/css/event-wizard.css">
  <link rel="stylesheet" href="/static/css/organization-shop.css?v=20261118-product-details">
  <script src="/static/js/organization-shop.js?v=20261118-product-details" defer></script>
</head>
<body class="btcpp-dashboard-page organization-dashboard-page organization-shop-page">
  {{ block "mainnav" . }}{{ end }}
  {{ template "dashboard_tabs" (dict "Active" "orgs" "ShowHackathons" .HasHackathonProjects "ShowSponsors" .ShowSponsors "ShowAdmin" .IsGlobalAdmin "PendingOrgInviteCount" .PendingOrgInviteCount) }}
  <div class="dashboard-shell">
    <main class="dashboard-main">
      {{ template "organization_workspace_header" (dict "Page" . "Active" "shop") }}
      <section class="org-shop" aria-label="Organization shop">
        <div class="org-shop-intro">
          <div class="dashboard-kicker">§ Merchandise</div>
          <h2>Your merch.</h2>
          <p>Your products, stock and fulfillment. Sold by bitcoin++ and shipped by your team.</p>
        </div>
        <nav class="org-shop-nav" aria-label="Shop management">
          <a href="{{ .Base }}?tab=profile" {{ if eq .Tab "profile" }}aria-current="page"{{ end }}>Shop profile</a>
          <a href="{{ .Base }}?tab=catalog" {{ if or (eq .Tab "catalog") (eq .Tab "product") }}aria-current="page"{{ end }}>Products &amp; stock</a>
          <a href="{{ .Base }}?tab=orders" {{ if eq .Tab "orders" }}aria-current="page"{{ end }}>Purchases &amp; shipping</a>
          <a href="{{ .Base }}?tab=discounts" {{ if eq .Tab "discounts" }}aria-current="page"{{ end }}>Discount codes</a>
          <a href="{{ .Base }}?tab=payouts" {{ if eq .Tab "payouts" }}aria-current="page"{{ end }}>Payouts &amp; tax</a>
        </nav>
{{ if .Flash }}<p role="status" class="ew-success">Changes saved.</p>{{ end }}
{{ if eq .Tab "profile" }}
<form method="post" action="{{ .Base }}" data-shop-form><input type="hidden" name="action" value="profile"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="revision" value="{{ .Profile.Revision }}">
<section class="ew-section"><h2>Ship-from address</h2><div class="ew-grid">
<label class="ew-field"><span>Contact name</span><input type="text" name="ship_contact" value="{{ .Profile.ShipFrom.ContactName }}" required></label>
<label class="ew-field"><span>Company</span><input type="text" name="ship_company" value="{{ .Profile.ShipFrom.CompanyName }}"></label>
<label class="ew-field"><span>Contact email</span><input type="email" name="ship_email" value="{{ .Profile.ShipFrom.Email }}" required></label>
<label class="ew-field"><span>Contact phone</span><input type="text" name="ship_phone" value="{{ .Profile.ShipFrom.Phone }}" required></label>
<label class="ew-field"><span>Street address</span><input type="text" name="ship_line1" value="{{ .Profile.ShipFrom.Line1 }}" required></label>
<label class="ew-field"><span>Address line 2</span><input type="text" name="ship_line2" value="{{ .Profile.ShipFrom.Line2 }}"></label>
<label class="ew-field"><span>City</span><input type="text" name="ship_city" value="{{ .Profile.ShipFrom.City }}" required></label>
<label class="ew-field"><span>State / region</span><input type="text" name="ship_region" value="{{ .Profile.ShipFrom.Region }}" required></label>
<label class="ew-field"><span>Postal code</span><input type="text" name="ship_postal_code" value="{{ .Profile.ShipFrom.PostalCode }}" required></label>
<label class="ew-field"><span>Country code</span><input type="text" name="ship_country" value="{{ .Profile.ShipFrom.CountryAlpha2 }}" required></label>
</div></section>
<section class="ew-section"><h2>Organization billing address</h2><div class="ew-grid">
<label class="ew-field"><span>Organization legal name</span><input name="billing_name" value="{{ .Profile.BillingName }}" required></label>
<label class="ew-field"><span>Street address</span><input type="text" name="billing_line1" value="{{ .Profile.Billing.Line1 }}" required></label>
<label class="ew-field"><span>Address line 2</span><input type="text" name="billing_line2" value="{{ .Profile.Billing.Line2 }}"></label>
<label class="ew-field"><span>City</span><input type="text" name="billing_city" value="{{ .Profile.Billing.City }}" required></label>
<label class="ew-field"><span>State / region</span><input type="text" name="billing_region" value="{{ .Profile.Billing.Region }}" required></label>
<label class="ew-field"><span>Postal code</span><input type="text" name="billing_postal_code" value="{{ .Profile.Billing.PostalCode }}" required></label>
<label class="ew-field"><span>Country code</span><input type="text" name="billing_country" value="{{ .Profile.Billing.Country }}" required></label>
</div></section>
<p class="ew-note">Shipping quotes use your ship-from address. Your billing address stays private. bitcoin++ remains the seller on customer orders. <a href="{{ .Base }}?tab=payouts">Manage payouts &amp; tax details →</a></p><label class="ew-field"><span>Fulfillment notes</span><textarea name="notes">{{ .Profile.Notes }}</textarea></label><div class="org-shop-actions"><button class="ew-primary">Save shop profile</button><p data-form-message role="status"></p></div></form>
{{ else if eq .Tab "payouts" }}
{{ template "organization_shop_payouts" . }}
{{ else if eq .Tab "catalog" }}
<div class="org-shop-actions"><a class="ew-primary" href="{{ .Base }}?tab=product">＋ Add a product</a></div><div class="ew-event-grid">{{ range .Products }}<a class="ew-event-card" href="{{ $.Base }}?tab=product&amp;product={{ .ID }}"><span class="ew-pill">{{ .Status }}</span>{{ with merchPrimaryImage . }}<img class="org-product-image" src="{{ . }}" alt="">{{ end }}<h2>{{ .Name }}</h2><p>{{ merchMoney .BasePriceCents . }} · {{ merchProductStock . }} available</p><span>{{ if .OnlineEnabled }}Online{{ else }}Events only{{ end }}{{ if .AllowEventPickup }} · Selected events{{ end }}</span><span class="ew-arrow">Edit product &amp; inventory ↗</span></a>{{ else }}<p class="ew-empty">Add your first product, then create its sizes or variants and stock quantities.</p>{{ end }}</div>
{{if .EventStock}}<section class="ew-section"><h2>Stock at events</h2><p>These units have been allocated to event registers and are excluded from online stock.</p>{{range .EventStock}}<p><strong>{{.Event}}</strong> · {{.Product}} / {{.Variant}} · {{.Available}} available</p>{{end}}</section>{{end}}
{{ else if eq .Tab "product" }}
{{ $product := .Product }}<p><a href="{{ .Base }}?tab=catalog">← All products</a></p><h2>{{ if .Product.ID }}{{ .Product.Name }}{{ else }}New product{{ end }}</h2>
<form method="post" action="{{ .Base }}" data-shop-form><input type="hidden" name="action" value="product"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="product_id" value="{{ .Product.ID }}"><input type="hidden" name="updated_at" value="{{ .Product.UpdatedAt.Format "2006-01-02T15:04:05.999999999Z07:00" }}"><input type="hidden" name="currency" value="USD">
<section class="ew-section"><h2>The product</h2><div class="ew-grid"><label class="ew-field"><span>Name</span><input name="name" value="{{ .Product.Name }}" required></label><label class="ew-field"><span>Product URL</span><input name="slug" value="{{ .Product.Slug }}" pattern="[a-z0-9][a-z0-9-]+" required></label><label class="ew-field"><span>Short description</span><input name="subtitle" value="{{ .Product.Subtitle }}"></label><label class="ew-field"><span>Category</span><select name="product_type"><option value="apparel" {{ if eq .Product.ProductType "apparel" }}selected{{ end }}>Apparel</option><option value="accessories" {{ if eq .Product.ProductType "accessories" }}selected{{ end }}>Accessories</option><option value="prints" {{ if eq .Product.ProductType "prints" }}selected{{ end }}>Prints</option><option value="stickers" {{ if eq .Product.ProductType "stickers" }}selected{{ end }}>Stickers &amp; pins</option><option value="exclusive" {{ if eq .Product.ProductType "exclusive" }}selected{{ end }}>Attendee exclusives</option><option value="standard" {{ if or (eq .Product.ProductType "standard") (eq .Product.ProductType "other") }}selected{{ end }}>Other merchandise</option></select></label><label class="ew-field ew-wide"><span>Description</span><textarea name="description">{{ .Product.Description }}</textarea></label><label class="ew-field"><span>Base price (USD)</span><input type="number" name="base_price" min="0.01" step="0.01" value="{{ merchDecimal .Product.BasePriceCents }}" required></label><label class="ew-field"><span>Visibility</span><select name="status"><option value="draft" {{ if eq .Product.Status "draft" }}selected{{ end }}>Draft</option><option value="published" {{ if eq .Product.Status "published" }}selected{{ end }}>Published</option><option value="archived" {{ if eq .Product.Status "archived" }}selected{{ end }}>Archived</option></select></label></div></section>
{{ template "organization_shop_earnings" (dict "Page" . "Estimate" (.ProductPayout nil)) }}
<section class="ew-section"><h2>Where to sell it</h2><label class="ew-check"><input type="checkbox" name="online_enabled" {{ if .Product.OnlineEnabled }}checked{{ end }}> Available in the online shop</label><p>Eligible events for pickup and in-person sales:</p>{{ range .Confs }}<label class="ew-check"><input type="checkbox" name="event_ids" value="{{ .Ref }}" {{ if index $.Events .Ref }}checked{{ end }}> {{ .Desc }} · {{ .DateDesc }}</label>{{ else }}<p class="ew-note">No upcoming published events are available yet.</p>{{ end }}<p class="ew-note">Leave events unchecked for online-only items. Event staff allocate and sell stock through the existing event register.</p></section>
<section class="ew-section" id="product-details-for-shipping">
<h2>A little more about the item</h2>
<p class="ew-note">Choose a description and we'll handle the technical tax settings. You can save a draft while you check any missing details with your supplier.</p>
<div class="ew-grid">
<label class="ew-field"><span>What are you selling?</span><select name="merchandise_kind"><option value="">I’m not sure yet</option>{{ $kind := .MerchandiseKind }}{{ range .MerchandiseKinds }}<option value="{{ .ID }}" {{ if eq $kind .ID }}selected{{ end }}>{{ .Label }}</option>{{ end }}{{ if eq $kind "saved" }}<option value="saved" selected>Keep the classification set by the shop admin</option>{{ end }}</select><small>This describes the item itself. Its shop category only controls where customers find it.</small></label>
<label class="ew-field"><span>Where was it made?</span><select name="country_of_origin"><option value="">I’m not sure yet</option>{{ range .ManufacturingCountries }}<option value="{{ .Code }}" {{ if eq $.Product.CountryOfOrigin .Code }}selected{{ end }}>{{ .Name }}</option>{{ end }}</select><small>Check the “Made in” label, packaging, or ask your manufacturer. This may be different from the country you ship from.</small></label>
</div>
<p class="ew-note">Other merchandise may need a shop admin to finish its shipping setup. Save a draft and <a href="/contact">ask bitcoin++ for help</a> if you're unsure.</p>
<details class="org-shop-detail" {{ if .Product.HSCode }}open{{ end }}><summary>I have a customs code from my supplier (optional)</summary><label class="ew-field"><span>Supplier’s customs / HS code</span><input name="hs_code" value="{{ .Product.HSCode }}" inputmode="numeric" maxlength="20"><small>This code identifies the goods for customs. Only enter one your supplier has provided; you don't need to look it up to save a draft. A shop admin can complete it later.</small></label></details>
<p class="ew-note">Packed weight and dimensions go in each variant below.</p>
</section>
<div class="org-shop-actions"><button class="ew-primary">Save product</button><button class="ew-secondary" name="save_draft" value="1">Save as draft</button><p data-form-message role="status"></p></div></form>
{{ if .Product.ID }}<section class="ew-section"><h2>Variants &amp; inventory</h2>{{ range .Product.Variants }}<details class="org-shop-detail"><summary>{{ .Label }} · {{ .Stock }} available · {{ .SKU }}</summary>{{ template "organization_shop_variant" (dict "Page" $ "Variant" .) }}</details>{{ end }}<details class="org-shop-detail"><summary>＋ Add a variant</summary>{{ template "organization_shop_variant" (dict "Page" .) }}</details></section>
<section class="ew-section"><h2>Product image</h2>{{ range .Product.Images }}<img class="org-product-image" src="{{ merchObjectURL .ObjectKey }}" alt="{{ .AltText }}">{{ end }}<form method="post" enctype="multipart/form-data" action="{{ .Base }}" data-shop-form><input type="hidden" name="action" value="image"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="product_id" value="{{ .Product.ID }}"><label class="ew-field"><span>New primary image</span><input type="file" name="file" accept="image/png,image/jpeg,image/webp" required></label><label class="ew-field"><span>Image description</span><input name="alt_text" required></label><div class="org-shop-actions"><button class="ew-secondary">Upload image</button><p data-form-message role="status"></p></div></form></section>{{ end }}
{{ else if eq .Tab "orders" }}
<h2>Purchases &amp; shipping</h2><p class="ew-note">The most recent 100 paid orders containing your items.</p>{{ range .Orders }}<section class="ew-section"><div class="ew-section-head"><h2>{{ .BuyerName }}</h2><span class="ew-pill">{{ .Status }}</span></div><p>{{ .BuyerEmail }} · {{ .CreatedAt.Format "Jan 2, 2006" }} · {{ .PublicID }}</p><ul>{{ range .Items }}<li>{{ .Quantity }} × {{ .ProductNameSnapshot }} · {{ .VariantLabelSnapshot }} · {{ .FulfillmentMethod }} · {{ merchMoney .LineTotalCents nil }} · {{ .FulfilledQuantity }} fulfilled{{ if .RefundedQuantity }} · {{ .RefundedQuantity }} refunded{{ end }}</li>{{ end }}</ul>{{ with .Address }}<p><strong>Ship to:</strong> {{ .Name }}<br>{{ .Line1 }} {{ .Line2 }}<br>{{ .City }}, {{ .Region }} {{ .PostalCode }} {{ .Country }}<br>{{ .Phone }}</p>{{ end }}{{if .ShippingService}}<p><strong>Shipping selected:</strong> {{.ShippingService}} · {{merchMoney .ShippingCents nil}}</p>{{end}}{{ with .ShipFrom }}<p class="ew-note"><strong>Ship from:</strong> {{ .CompanyName }} · {{ .Line1 }}, {{ .City }}, {{ .CountryAlpha2 }}</p>{{ end }}{{ range .Tracking }}<p>Tracking: {{ . }}</p>{{ end }}{{ if .CanShip }}<form method="post" action="{{ $.Base }}" data-shop-form><input type="hidden" name="action" value="ship"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><input type="hidden" name="order_id" value="{{ .ID }}"><div class="ew-grid"><label class="ew-field"><span>Carrier</span><input name="courier" required></label><label class="ew-field"><span>Tracking number</span><input name="tracking_number" required></label><label class="ew-field ew-wide"><span>Tracking URL (optional)</span><input type="url" name="tracking_url" placeholder="https://"></label></div><div class="org-shop-actions"><button class="ew-primary">Mark these items shipped</button><p data-form-message role="status"></p></div></form>{{ end }}</section>{{ else }}<p class="ew-empty">Paid purchases will appear here when customers order your items.</p>{{ end }}
{{if .EventSales}}<h2>Event purchases</h2>{{range .EventSales}}<section class="ew-section"><h3>{{.Event}}</h3><p>{{.CreatedAt.Format "Jan 2, 2006"}} · {{.Quantity}} × {{.Product}} / {{.Variant}} · {{.TotalSats}} sats{{if .HandedOver}} · Handed over{{else}} · Paid, awaiting pickup{{end}}</p></section>{{end}}{{end}}
{{ else if eq .Tab "discounts" }}<h2>Discounts for your items.</h2><p>Codes apply only to products fulfilled by {{ .Org.Name }}. Your {{ .SupplierPercent }}% share is calculated after the discount; bitcoin++ keeps {{ .FeePercent }}%. Shipping and tax are calculated separately. Dates are UTC.</p>{{ range .Discounts }}<details class="org-shop-detail"><summary>{{ .Code }} · {{ .PercentOff }}% off · {{ .Uses }} uses · {{ if .Active }}Active{{ else }}Disabled{{ end }}</summary>{{ template "organization_shop_discount" (dict "Page" $ "Discount" .) }}</details>{{ end }}<section class="ew-section"><h2>New discount code</h2>{{ template "organization_shop_discount" (dict "Page" .) }}</section>{{ end }}
<noscript><p>Enable JavaScript to save shop changes.</p></noscript>
      </section>
    </main>
  </div>
  {{ block "footer" . }}{{ end }}
</body>
</html>
{{ define "organization_shop_variant" }}{{ $p := .Page }}{{ $v := .Variant }}
<form method="post" action="{{ $p.Base }}" data-shop-form><input type="hidden" name="action" value="variant"><input type="hidden" name="csrf" value="{{ $p.CSRF }}"><input type="hidden" name="product_id" value="{{ $p.Product.ID }}"><input type="hidden" name="variant_id" value="{{ with $v }}{{ .ID }}{{ end }}"><input type="hidden" name="operation" value="{{ $p.Operation }}"><div class="ew-grid"><label class="ew-field"><span>SKU</span><input name="sku" value="{{ with $v }}{{ .SKU }}{{ end }}" required></label><label class="ew-field"><span>Variant name</span><input name="variant_label" placeholder="Medium / Black" value="{{ with $v }}{{ .Label }}{{ end }}" required></label><label class="ew-field"><span>Price adjustment (USD)</span><input name="price_adjustment" type="number" step="0.01" value="{{ if $v }}{{ merchDecimal $v.PriceDeltaCents }}{{ else }}0.00{{ end }}"></label><label class="ew-field"><span>Stock adjustment (+ to add, − to remove)</span><input name="stock_delta" type="number" value="0" required><small>New variants start at zero. Reserved and event-allocated stock is already excluded.</small></label><label class="ew-field"><span>Packed weight (g)</span><input name="weight_grams" type="number" min="0" value="{{ if $v }}{{ $v.WeightGrams }}{{ else }}0{{ end }}"></label><label class="ew-field"><span>Packed length (inches)</span><input name="length_inches" type="number" min="0" step="0.01" value="{{ if $v }}{{ merchInches $v.LengthMM }}{{ else }}0{{ end }}"></label><label class="ew-field"><span>Packed width (inches)</span><input name="width_inches" type="number" min="0" step="0.01" value="{{ if $v }}{{ merchInches $v.WidthMM }}{{ else }}0{{ end }}"></label><label class="ew-field"><span>Packed height (inches)</span><input name="height_inches" type="number" min="0" step="0.01" value="{{ if $v }}{{ merchInches $v.HeightMM }}{{ else }}0{{ end }}"></label><label class="ew-field"><span>Variant status</span><select name="variant_status"><option value="active">Active</option><option value="archived" {{ if and $v (eq $v.Status "archived") }}selected{{ end }}>Archived</option></select></label></div>{{ template "organization_shop_earnings" (dict "Page" $p "Estimate" ($p.ProductPayout $v)) }}<div class="org-shop-actions"><button class="ew-secondary">Save variant &amp; stock</button><p data-form-message role="status"></p></div></form>{{ end }}
{{ define "organization_shop_discount" }}{{ $p := .Page }}{{ $d := .Discount }}
<form method="post" action="{{ $p.Base }}" data-shop-form><input type="hidden" name="action" value="discount"><input type="hidden" name="csrf" value="{{ $p.CSRF }}"><input type="hidden" name="discount_id" value="{{ with $d }}{{ .ID }}{{ end }}"><div class="ew-grid"><label class="ew-field"><span>Code</span><input name="code" value="{{ with $d }}{{ .Code }}{{ end }}" required></label><label class="ew-field"><span>Percent off</span><input type="number" name="percent_off" min="1" max="99" value="{{ if $d }}{{ $d.PercentOff }}{{ else }}10{{ end }}" required></label><label class="ew-field"><span>Starts (UTC, optional)</span><input type="datetime-local" name="starts_at" value="{{ with $d }}{{ with .StartsAt }}{{ .UTC.Format "2006-01-02T15:04" }}{{ end }}{{ end }}"></label><label class="ew-field"><span>Ends (UTC, optional)</span><input type="datetime-local" name="ends_at" value="{{ with $d }}{{ with .EndsAt }}{{ .UTC.Format "2006-01-02T15:04" }}{{ end }}{{ end }}"></label><label class="ew-field"><span>Maximum uses (0 = unlimited)</span><input type="number" name="max_uses" min="0" value="{{ if $d }}{{ $d.MaxUses }}{{ else }}0{{ end }}" required></label><label class="ew-check"><input type="checkbox" name="active" {{ if $d }}{{ if $d.Active }}checked{{ end }}{{ else }}checked{{ end }}> Enabled</label></div><div class="org-shop-actions"><button class="ew-secondary">Save discount</button><p data-form-message role="status"></p></div></form>{{ end }}
