<!doctype html>
<html lang="en">
  <head>
    {{ template "site_seo" (dict "Title" (printf "%s · bitcoin++ shop" .Product.Name) "Description" (merchSEODescription .Product) "Path" (printf "/shop/%s" .Product.Slug) "Image" (merchSocialImage .Product) "ImageType" "image/jpeg" "ImageWidth" (merchSocialImageWidth .Product) "ImageHeight" (merchSocialImageHeight .Product) "Type" "product") }}
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/static/css/site-chrome.css?v=20260910-1">
    <link rel="stylesheet" href="/static/css/btcpp-redesign.css">
    <link rel="stylesheet" href="/static/css/shop.css?v=20260914-1">
    <link rel="stylesheet" href="/static/css/site-navigation.css?v=20260904-1">
  </head>
  <body class="shop-page">
    {{ template "mainnav" . }}
    {{ template "shop_header" . }}
    <div class="shop-breadcrumb"><a href="/shop">shop</a><span>/</span><a href="/shop/all">{{ .Product.CategoryName }}</a><span>/</span><b>{{ .Product.Name }}</b></div>
    <main class="shop-item">
      <div class="shop-item__media">
        {{ if .SelectedCanvasBadge }}<div class="badge-canvas-mockup"><img data-canvas-preview src="{{ .SelectedCanvasBadge.ArtworkURL | safeURL }}" alt="{{ .SelectedCanvasBadge.BadgeName }} canvas preview"></div>{{ else if merchImage .Product }}<img src="{{ merchImage .Product | safeURL }}" alt="{{ .Product.Name }}">{{ else }}<span>{{ .Product.CategoryName }}</span>{{ end }}
      </div>
      <section class="shop-item__details">
        <p class="shop-kicker">{{ .Product.CategoryName }}</p>
        <h1>{{ .Product.Name }}</h1>
        <div class="shop-price">
          {{ template "shop_product_price" .Product }}
        </div>
        <p>{{ .Product.Description }}</p>
        <p class="shop-canvas-note">Shipping and tax are additional. Prices refresh at checkout.</p>
        {{ if and (eq .Product.ProductType "badge_canvas") (not .CanvasSignedIn) }}
        <a class="shop-button is-primary" href="/login?next=/shop/{{ .Product.Slug }}">Sign in to choose your badge →</a>
        {{ else if and (eq .Product.ProductType "badge_canvas") (not .CanvasBadges) }}
        <div class="shop-empty">You don't have any issued Badge Studio badges to print yet. Your badges will appear here once issued.</div>
        {{ else if merchProductSoldOut .Product }}
        <div class="shop-sold-out-panel">
          <strong>SOLD OUT</strong>
          <span>This item is out of stock right now.</span>
        </div>
        {{ else if .Product.Variants }}
        <form method="POST" action="/shop/cart/add" class="shop-buy-box">
          <input type="hidden" name="redirect" value="/shop/cart">
          {{ if eq .Product.ProductType "badge_canvas" }}
          <input type="hidden" name="csrf" value="{{ .CanvasCSRF }}">
          <label>Your badge
            <select name="badge_ref" data-canvas-selector required>
              {{ range .CanvasBadges }}<option value="{{ .Reference }}" data-artwork="{{ .ArtworkURL }}"{{ if and $.SelectedCanvasBadge (eq .Reference $.SelectedCanvasBadge.Reference) }} selected{{ end }}>{{ .BadgeName }}</option>{{ end }}
            </select>
          </label>
          <p class="shop-canvas-note">Made from a badge issued to your account. The complete artwork stays visible on the square canvas.</p>
          {{ end }}
          <label>variant
            <select name="variant_id">
              {{ range .Product.Variants }}
              <option value="{{ .ID }}"{{ if not (merchVariantAvailable .) }} disabled{{ end }}>{{ .Label }}{{ if ne .PriceDeltaCents 0 }} · {{ .PriceDeltaCents }}{{ end }}{{ if not (merchVariantAvailable .) }} · sold out{{ end }}</option>
              {{ end }}
            </select>
          </label>
          <label>quantity
            <input type="number" name="qty" min="1" max="20" value="1">
          </label>
          <button class="shop-button is-primary" type="submit">Add to cart · {{ with merchSats (merchPrice .Product) .Product.Currency }}{{ . }} sats{{ else }}{{ merchMoney (merchPrice $.Product) $.Product }}{{ end }}</button>
        </form>
        {{ else }}
        <div class="shop-empty">This item needs a variant before it can be sold.</div>
        {{ end }}
        <div class="shop-facts">
          {{ if .Product.RequiresShipping }}<span>📦 ships worldwide</span>{{ end }}
          {{ if and .Product.AllowEventPickup .PickupConf }}<span>free event pickup</span>{{ end }}
          <span>₿ bitcoin or card</span>
        </div>
      </section>
    </main>
    {{ if .Related }}<section class="shop-section">
      <div class="shop-section__label">§ goes well with</div>
      {{ template "shop_product_grid" .Related }}
    </section>{{ end }}
    {{ template "shop_footer" . }}
    {{ if eq .Product.ProductType "badge_canvas" }}<script src="/static/js/badge-canvas.js?v=1" defer></script>{{ end }}
  </body>
</html>
