<!DOCTYPE html>
<html lang="en">
<head>
  <title>{{ .Organization.Name }} organization - bitcoin++</title>
  {{ block "header" . }}{{ end }}
  {{ if .CanManage }}<script src="/static/js/person-picker.js" defer></script>{{ end }}
</head>
<body class="btcpp-dashboard-page organization-dashboard-page">
  {{ block "mainnav" . }}{{ end }}
  {{ template "dashboard_tabs" (dict "Active" "orgs" "ShowHackathons" .HasHackathonProjects "ShowSponsors" .ShowSponsors "ShowAdmin" .IsGlobalAdmin "PendingOrgInviteCount" .PendingOrgInviteCount) }}
  <div class="dashboard-shell">
    <main class="dashboard-main">
      {{ if .FlashMessage }}<div class="dashboard-flash is-success"><p>{{ .FlashMessage }}</p></div>{{ end }}
      {{ if .FlashError }}<div class="dashboard-flash is-error"><p>{{ .FlashError }}</p></div>{{ end }}

      <header class="dashboard-workspace-hero organization-dashboard-hero">
        <div class="dashboard-workspace-hero__identity">
          <div class="dashboard-workspace-hero__mark">
            {{ if .Organization.LogoLight }}<img src="{{ .Organization.LogoLight | safeURL }}" alt="{{ .Organization.Name }}">{{ else }}<span>{{ printf "%.1s" .Organization.Name }}</span>{{ end }}
          </div>
          <div class="dashboard-workspace-hero__copy">
            <div class="dashboard-kicker">● Organization workspace · {{ .Membership.Role }}</div>
            <h1>{{ .Organization.Name }}</h1>
            <p>{{ if .Organization.Tagline }}{{ .Organization.Tagline }}{{ else }}Manage this organization’s members, identity, and bitcoin++ activity.{{ end }}</p>
          </div>
        </div>
        <dl class="dashboard-workspace-hero__facts" aria-label="Organization summary">
          <div><dt>Members</dt><dd>{{ len .Members }}</dd></div>
          <div><dt>Sponsorships</dt><dd>{{ len .SponsorEvents }}</dd></div>
          <div><dt>Access</dt><dd>{{ if .CanManage }}Manage{{ else }}Member{{ end }}</dd></div>
        </dl>
        {{ if gt (len .Memberships) 1 }}
        <nav class="sponsor-dashboard-org-switcher" aria-label="Your organizations">
          {{ range .Memberships }}
          <a href="/dashboard/orgs/{{ .OrganizationID }}"{{ if eq .OrganizationID $.Organization.Ref }} class="is-active" aria-current="page"{{ end }}>{{ .Organization.Name }}</a>
          {{ end }}
        </nav>
        {{ end }}
      </header>

      <section class="organization-dashboard-section dashboard-workspace-panel" id="badge-catalog">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Badge catalog</div><h2>Recognition from {{ .Organization.Name }}.</h2></div>
          <p>Anyone can receive these badges. Owners and managers can issue to any Nostr pubkey or use the bitcoin++ directory to find members.</p>
        </div>
        {{ if .BadgeCatalog }}
          {{ if .BadgeCatalog.Badges }}<div class="whois-credential-grid">{{ range .BadgeCatalog.Badges }}<article class="whois-credential"><div class="whois-credential-art"><img src="{{ .ImageURL }}" alt="" loading="lazy"></div><div><small>published badge</small><h3>{{ .Name }}</h3><p>{{ .Description }}</p></div></article>{{ end }}</div>{{ else }}<p>No badge definitions have been published yet.</p>{{ end }}
          <p><a href="{{ .BadgeCatalog.CatalogURL }}" target="_blank" rel="noopener noreferrer">View public badge catalog ↗</a></p>
        {{ else }}<p>This organization has not linked a Badge Studio issuer yet.</p>{{ end }}
        {{ if .CanManage }}<div class="organization-badge-actions">{{ if .SignerURL }}<a href="{{ .SignerURL }}/?tenant=organization&amp;tenant_id={{ .Organization.Ref }}" target="_blank" rel="noopener noreferrer">Set up or open managed signer ↗</a>{{ end }}{{ if .BadgeStudioURL }}<a href="{{ .BadgeStudioURL }}" target="_blank" rel="noopener noreferrer">Open Badge Studio ↗</a>{{ end }}</div>{{ end }}
      </section>

      {{ if .CanManage }}
      <section class="organization-dashboard-section dashboard-workspace-panel" id="badge-grants">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Badge grants</div><h2>Recognize any bitcoin++ member.</h2></div>
          <p>A grant records the organization’s intent here first. If the person has a verified Nostr key it becomes ready to issue; otherwise Bitcoin++ asks them to add one.</p>
        </div>
        {{ if and .BadgeCatalog .BadgeCatalog.Badges }}
        <form method="POST" action="/dashboard/orgs/{{ .Organization.Ref }}/badge-grants" class="organization-badge-grant-form">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <label><span>Published badge</span><select name="badge_identifier" required><option value="">Choose a badge</option>{{ range .BadgeCatalog.Badges }}<option value="{{ .Identifier }}">{{ .Name }}</option>{{ end }}</select></label>
          <div class="organization-person-picker" data-person-picker data-person-picker-required="true" data-person-picker-max="1" data-person-picker-name="recipient_person_id" data-person-picker-search-url="/dashboard/orgs/{{ .Organization.Ref }}/people/search">
            <label for="BadgeGrantRecipient"><span>Bitcoin++ person</span></label>
            <input id="BadgeGrantRecipient" type="search" data-person-picker-input placeholder="Search name, email, or phone">
            <p class="hidden" data-person-picker-flash></p>
          </div>
          <button type="submit">Grant badge →</button>
        </form>
        {{ else }}<p>Publish and link an organization badge definition before creating grants.</p>{{ end }}
        {{ if .OrganizationGrants }}
        <div class="organization-badge-grant-list">
          {{ range .OrganizationGrants }}
          <article>
            <img src="{{ .BadgeImageURL | safeURL }}" alt="" loading="lazy">
            <div><small>{{ if eq .State "ready_to_issue" }}ready to issue{{ else if eq .State "delivery_error" }}delivery needs attention{{ else }}{{ .State }}{{ end }}</small><strong>{{ .BadgeName }} → {{ .RecipientName }}</strong><span>{{ if eq .State "granted" }}Waiting for a verified Nostr key.{{ else if eq .State "ready_to_issue" }}Verified key: {{ .RecipientPubkey }}{{ else if eq .State "issued" }}Nostr award: {{ .AwardEventID }}{{ else if eq .State "accepted" }}Accepted into the recipient’s Nostr profile.{{ else if eq .State "revoked" }}Revoked by the issuer{{ if .RevocationReason }} · {{ .RevocationReason }}{{ end }}{{ else if .DeliveryError }}{{ .DeliveryError }}{{ end }}</span></div>
            <div class="organization-badge-grant-actions">
              {{ if eq .State "ready_to_issue" }}{{ if $.BadgeStudioURL }}<a href="{{ $.BadgeStudioURL }}/?btcpp_org={{ $.Organization.Ref }}&amp;grant={{ .ID }}" target="_blank" rel="noopener noreferrer">Issue in Studio ↗</a>{{ end }}{{ end }}
              {{ if or (eq .State "granted") (eq .State "ready_to_issue") }}<form method="POST" action="/dashboard/orgs/{{ $.Organization.Ref }}/badge-grants/{{ .ID }}/cancel" onsubmit="return confirm('Cancel this badge grant?');"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><button type="submit">Cancel</button></form>{{ end }}
            </div>
          </article>
          {{ end }}
        </div>
        {{ else }}<p>No Bitcoin++ badge grants have been created by this organization yet.</p>{{ end }}
      </section>
      {{ end }}

      {{ if or .Badges .PersonalGrants }}
      <section class="organization-dashboard-section dashboard-workspace-panel" id="badges">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Badges for you</div><h2>Your credentials from organizations.</h2></div>
          <p>Badges are issued to your verified Nostr key. Pending badges appear here before you add one.</p>
        </div>
        {{ if or (and .Badges (or .Badges.Issued .Badges.Pending)) .PersonalGrants }}
        <div class="whois-credential-grid">
          {{ if .Badges }}{{ range .Badges.Issued }}<article class="whois-credential{{ if .Award.Revocation }} is-revoked{{ end }}"><div class="whois-credential-art"><img src="{{ .Definition.ImageURL }}" alt="" loading="lazy"></div><div><small>{{ if .Award.Revocation }}revoked{{ else if .Accepted }}accepted on nostr{{ else }}awarded · acceptance pending{{ end }}</small><h3>{{ .Definition.Name }}</h3>{{ if not .Award.Revocation }}{{ if .CredentialURL }}<a href="{{ .CredentialURL }}">View credential →</a>{{ end }}{{ if .ClaimURL }} <a href="{{ .ClaimURL }}">Accept on Nostr →</a>{{ end }}{{ end }}</div></article>{{ end }}{{ end }}
          {{ range .PersonalGrants }}<article class="whois-credential{{ if or (eq .State "granted") (eq .State "ready_to_issue") }} is-pending{{ end }}"><div class="whois-credential-art"><img src="{{ .BadgeImageURL | safeURL }}" alt="" loading="lazy"></div><div><small>bitcoin++ grant · {{ if eq .State "ready_to_issue" }}ready to issue{{ else }}{{ .State }}{{ end }}</small><h3>{{ .BadgeName }}</h3>{{ if eq .State "granted" }}<a href="/dashboard/settings#settings-sign-in">Add or verify your Nostr key →</a>{{ else if eq .State "ready_to_issue" }}<span>The organization can now issue this to your verified key.</span>{{ end }}</div></article>{{ end }}
        </div>
        {{ else }}<p>No badges have been issued to this profile yet.</p>{{ end }}
      </section>
      {{ end }}

      <nav class="organization-dashboard-local-nav" aria-label="Organization sections">
		<a href="#badge-catalog">/badge catalog</a>
        {{ if .CanManage }}<a href="#profile">/profile</a>{{ end }}
        {{ if .CanManage }}<a href="#badge-grants">/badge grants{{ if .OrganizationGrants }} ({{ len .OrganizationGrants }}){{ end }}</a>{{ end }}
        {{ if .Badges }}<a href="#badges">/badges</a>{{ end }}
        <a href="#members">/members</a>
        {{ if .CanManage }}<a href="#requests">/join requests{{ if .PendingRequests }} ({{ len .PendingRequests }}){{ end }}</a>{{ end }}
        {{ if and .CanManage .SponsorEvents }}<a href="/dashboard/sponsor/{{ .Organization.Ref }}">/sponsorships</a>{{ end }}
      </nav>

      {{ if .CanManage }}
      <section class="organization-dashboard-section dashboard-workspace-panel" id="profile">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Public profile</div><h2>How {{ .Organization.Name }} appears.</h2></div>
          {{ if .CanManage }}<p>Owners and managers can keep the organization’s identity and contact details current. <a href="/organizations/{{ .Organization.Ref }}">View public profile →</a></p>{{ else }}<p>Ask an organization owner or manager to update these details.</p>{{ end }}
        </div>
        <div class="sponsor-profile-preview">
          <div class="sponsor-profile-preview__logo">
            {{ if .Organization.LogoLight }}<img src="{{ .Organization.LogoLight | safeURL }}" alt="">{{ else }}<span>{{ printf "%.1s" .Organization.Name }}</span>{{ end }}
          </div>
          <div>
            <span>Organization profile</span>
            <h3>{{ .Organization.Name }}</h3>
            <p>{{ if .Organization.Tagline }}{{ .Organization.Tagline }}{{ else }}No public tagline has been added yet.{{ end }}</p>
            <nav class="organization-profile-links" aria-label="Organization links">
              {{ if .Organization.Website }}<a href="{{ .Organization.Website | safeURL }}" target="_blank" rel="noopener noreferrer">Website ↗</a>{{ end }}
              {{ if .Organization.Github }}<a href="{{ .Organization.Github | safeURL }}" target="_blank" rel="noopener noreferrer">GitHub ↗</a>{{ end }}
              {{ if .Organization.Email }}<a href="mailto:{{ .Organization.Email }}">Contact</a>{{ end }}
            </nav>
          </div>
          {{ if .Organization.Hiring }}<strong>Hiring</strong>{{ end }}
        </div>
        {{ if .CanManage }}
        <details class="sponsor-profile-editor">
          <summary>Edit public profile</summary>
          <form method="POST" enctype="multipart/form-data" action="/dashboard/orgs/{{ .Organization.Ref }}/profile" class="sponsor-profile-form">
            <input type="hidden" name="csrf" value="{{ .CSRF }}">
            <fieldset class="sponsor-profile-group">
              <legend>Organization details</legend>
              <div class="sponsor-profile-grid">
                <label><span>Organization name</span><input name="Name" required value="{{ .Organization.Name }}"></label>
                <label><span>Contact email</span><input name="Email" type="email" value="{{ .Organization.Email }}"></label>
                <label class="is-wide"><span>Tagline or short blurb</span><textarea name="Tagline" rows="3">{{ .Organization.Tagline }}</textarea></label>
                <label><span>Website</span><input name="Website" type="url" value="{{ .Organization.Website }}"></label>
                <label class="sponsor-profile-checkbox"><input name="Hiring" type="checkbox"{{ if .Organization.Hiring }} checked{{ end }}><span>Show that our organization is hiring</span></label>
              </div>
            </fieldset>
            <fieldset class="sponsor-profile-group">
              <legend>Social links</legend>
              <div class="sponsor-profile-grid">
                <label><span>X handle</span><input name="Twitter" value="{{ .Organization.Twitter.Handle }}"></label>
                <label><span>GitHub</span><input name="Github" type="url" value="{{ .Organization.Github }}"></label>
                <label><span>LinkedIn</span><input name="LinkedIn" type="url" value="{{ .Organization.LinkedIn }}"></label>
                <label><span>Instagram</span><input name="Instagram" value="{{ .Organization.Instagram }}"></label>
                <label><span>YouTube</span><input name="Youtube" value="{{ .Organization.Youtube }}"></label>
                <label><span>Nostr</span><input name="Nostr" value="{{ .Organization.Nostr }}"></label>
                <label><span>Matrix</span><input name="Matrix" value="{{ .Organization.Matrix }}"></label>
              </div>
            </fieldset>
            {{ if .SpacesReady }}
            <fieldset class="sponsor-profile-group">
              <legend>Logos</legend>
              <div class="sponsor-logo-variants">
                <div class="sponsor-logo-variant">
                  <span>Light background</span>
                  <div class="sponsor-logo-variant__preview is-light">{{ if .Organization.LogoLight }}<img src="{{ .Organization.LogoLight | safeURL }}" alt="{{ .Organization.Name }} light-background logo">{{ else }}<em>No logo uploaded</em>{{ end }}</div>
                  <label><span>Replace light-background logo</span><input name="LogoLightFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml"></label>
                </div>
                <div class="sponsor-logo-variant">
                  <span>Dark background</span>
                  <div class="sponsor-logo-variant__preview is-dark">{{ if .Organization.LogoDark }}<img src="{{ .Organization.LogoDark | safeURL }}" alt="{{ .Organization.Name }} dark-background logo">{{ else }}<em>No logo uploaded</em>{{ end }}</div>
                  <label><span>Replace dark-background logo</span><input name="LogoDarkFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml"></label>
                </div>
              </div>
            </fieldset>
            {{ end }}
            <button type="submit">Save public profile →</button>
          </form>
        </details>
        {{ end }}
      </section>
      {{ end }}

      <section class="organization-dashboard-section dashboard-workspace-panel" id="members">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Members</div><h2>Your organization team.</h2></div>
          <p>{{ if .CanManage }}Invite people, review access, and keep roles current.{{ else }}Your organization managers control invitations and roles.{{ end }}</p>
        </div>
        <div class="sponsor-team-list organization-member-list">
          {{ range .Members }}
          <div class="sponsor-team-row">
            <div><strong>{{ .PersonName }}</strong>{{ if or $.CanManage (eq $.Membership.PersonID .PersonID) }}<span>{{ .PersonEmail }}</span>{{ end }}</div>
            <div class="sponsor-team-row__actions">
              {{ if $.IsOwner }}
              <form method="POST" action="/dashboard/orgs/{{ $.Organization.Ref }}/members/{{ .PersonID }}/role" class="organization-role-form">
                <input type="hidden" name="csrf" value="{{ $.CSRF }}">
                <label><span class="sr-only">Role for {{ .PersonName }}</span><select name="role" aria-label="Role for {{ .PersonName }}"><option value="owner"{{ if eq .Role "owner" }} selected{{ end }}>Owner</option><option value="manager"{{ if eq .Role "manager" }} selected{{ end }}>Manager</option><option value="member"{{ if eq .Role "member" }} selected{{ end }}>Member</option></select></label>
                <button type="submit">Save role</button>
              </form>
              {{ else }}
              <span class="sponsor-team-role">{{ .Role }}</span>
              {{ end }}
              {{ if $.CanRemoveMember . }}
              <form method="POST" action="/dashboard/orgs/{{ $.Organization.Ref }}/members/{{ .PersonID }}/remove" onsubmit="return confirm('{{ if eq $.Membership.PersonID .PersonID }}Leave this organization?{{ else }}Remove {{ .PersonName }} from this organization?{{ end }}');">
                <input type="hidden" name="csrf" value="{{ $.CSRF }}">
                <button type="submit">{{ if eq $.Membership.PersonID .PersonID }}Leave{{ else }}Remove{{ end }}</button>
              </form>
              {{ end }}
            </div>
          </div>
          {{ end }}
        </div>

        {{ if .CanManage }}
        <div class="organization-membership-policy">
          <div><div class="dashboard-kicker">§ Join policy</div><h3>Who can join?</h3><p>Choose whether new members need review, join immediately, or cannot request access.</p></div>
          <form method="POST" action="/dashboard/orgs/{{ .Organization.Ref }}/membership-policy">
            <input type="hidden" name="csrf" value="{{ .CSRF }}">
            <label><span>Membership requests</span><select name="membership_policy"><option value="request"{{ if eq .Organization.MembershipPolicy "request" }} selected{{ end }}>Managers approve each request</option><option value="open"{{ if eq .Organization.MembershipPolicy "open" }} selected{{ end }}>Automatically approve everyone</option><option value="closed"{{ if eq .Organization.MembershipPolicy "closed" }} selected{{ end }}>Do not accept requests</option></select></label>
            <button type="submit">Save join policy</button>
          </form>
        </div>

        <div class="organization-membership-requests" id="requests">
          <div><div class="dashboard-kicker">§ Requests</div><h3>Membership requests.</h3></div>
          {{ if .PendingRequests }}
          {{ range .PendingRequests }}
          <article>
            <div><strong>{{ .PersonName }}</strong>{{ if .PersonEmail }}<span>{{ .PersonEmail }}</span>{{ end }}{{ if .Message }}<p>{{ .Message }}</p>{{ end }}<small>Requested {{ .CreatedAt.Format "Jan 2, 2006" }}</small></div>
            <form method="POST" action="/dashboard/orgs/{{ $.Organization.Ref }}/membership-requests/{{ .ID }}">
              <input type="hidden" name="csrf" value="{{ $.CSRF }}">
              <label><span class="sr-only">Review note for {{ .PersonName }}</span><input name="review_note" placeholder="Optional note"></label>
              <button class="organization-review-action is-primary" type="submit" name="decision" value="approved">Approve</button>
              <button class="organization-review-action is-secondary" type="submit" name="decision" value="denied">Deny</button>
            </form>
          </article>
          {{ end }}
          {{ else }}<p>No membership requests are waiting.</p>{{ end }}
        </div>

        <div class="organization-teammate-tools">
          <header class="organization-teammate-tools__head">
            <div><div class="dashboard-kicker">§ Grow the team</div><h3>Add a teammate.</h3></div>
            <p>Choose an existing bitcoin++ profile, or send a secure invitation by email.</p>
          </header>
          <div class="organization-teammate-actions">
            <form method="POST" action="/dashboard/orgs/{{ .Organization.Ref }}/members" class="organization-teammate-card organization-teammate-card--existing">
              <input type="hidden" name="csrf" value="{{ .CSRF }}">
              <div class="organization-teammate-card__intro">
                <span class="organization-teammate-card__number">01</span>
                <div class="dashboard-kicker">§ Existing account</div>
                <h4>Find a bitcoin++ person.</h4>
                <p>Search existing profiles and grant access immediately.</p>
              </div>
              <div class="organization-teammate-card__fields">
                <div class="organization-person-picker" data-person-picker data-person-picker-required="true" data-person-picker-max="1" data-person-picker-name="person_id" data-person-picker-search-url="/dashboard/orgs/{{ .Organization.Ref }}/people/search">
                  <label for="OrganizationTeammateSearch"><span>Person</span></label>
                  <input id="OrganizationTeammateSearch" type="search" data-person-picker-input placeholder="Search name, email, or phone">
                  <p class="hidden" data-person-picker-flash></p>
                </div>
                <label><span>Access</span><select name="role"><option value="member">Member</option><option value="manager">Manager</option></select></label>
              </div>
              <button type="submit">Add teammate →</button>
            </form>

            <form method="POST" action="/dashboard/orgs/{{ .Organization.Ref }}/invites" class="organization-teammate-card organization-teammate-card--invite">
              <input type="hidden" name="csrf" value="{{ .CSRF }}">
              <div class="organization-teammate-card__intro">
                <span class="organization-teammate-card__number">02</span>
                <div class="dashboard-kicker">§ Email invitation</div>
                <h4>Invite someone new.</h4>
                <p>Email a secure 72-hour invitation to someone new.</p>
              </div>
              <div class="organization-teammate-card__fields">
                <label><span>Email</span><input name="email" type="email" required autocomplete="email" placeholder="teammate@example.com"></label>
                <label><span>Access</span><select name="role"><option value="member">Member</option><option value="manager">Manager</option></select></label>
              </div>
              <button type="submit">Send invitation →</button>
            </form>
          </div>
        </div>
        {{ if .InviteLink }}
        <div class="sponsor-invite-link"><strong>Secure invite link{{ if .InviteEmail }} for {{ .InviteEmail }}{{ end }}</strong><input readonly value="{{ .InviteLink }}" aria-label="Secure invite link"><p>Share it only with the invited email address. It expires in 72 hours and is shown here once.</p></div>
        {{ end }}
        {{ if .PendingInvites }}
        <div class="organization-pending-invites">
          <h3>Pending invitations</h3>
          {{ range .PendingInvites }}
          <div class="organization-pending-invite">
            <div><strong>{{ .Email }}</strong><span>{{ .Role }} · expires {{ .ExpiresAt.Format "Jan 2, 2006" }}</span></div>
            <div>
              <form method="POST" action="/dashboard/orgs/{{ $.Organization.Ref }}/invites/{{ .ID }}/replace"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><button type="submit">Create new link</button></form>
              <form method="POST" action="/dashboard/orgs/{{ $.Organization.Ref }}/invites/{{ .ID }}/revoke" onsubmit="return confirm('Revoke the invitation for {{ .Email }}?');"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><button type="submit">Revoke</button></form>
            </div>
          </div>
          {{ end }}
        </div>
        {{ end }}
        {{ end }}
      </section>

      {{ if and .CanManage .SponsorEvents }}
      <section class="organization-sponsorship-card dashboard-workspace-panel">
        <div><div class="dashboard-kicker">§ Sponsorships</div><h2>Event benefits and activity.</h2><p>Tickets, challenges, speaker applications, and hackathon entries stay together in the sponsor workspace.</p></div>
        <a href="/dashboard/sponsor/{{ .Organization.Ref }}">Open sponsor workspace →</a>
      </section>
      {{ end }}
    </main>
  </div>
  {{ block "footer" . }}{{ end }}
</body>
</html>
