{{ define "conf_hackathon_section" }}
{{ if .Hackathon }}
{{ $sectionLabel := .Conf.HackathonSectionLabel }}{{ if not $sectionLabel }}{{ $sectionLabel = msg "hackathon.section" }}{{ end }}
{{ $headline := .Conf.HackathonHeadline }}{{ if not $headline }}{{ $headline = msg "hackathon.headline" }}{{ end }}
{{ $judgesNote := msg "hackathon.judges_soon" }}
{{ $proofLabel := .Conf.HackathonProofLabel }}{{ if not $proofLabel }}{{ $proofLabel = msg "hackathon.proof" }}{{ end }}
{{ $prizePool := .HackathonPrizePoolValue }}
<section id="hackathon" class="conf-hackathon-redesign">
  {{ if .CommunityPool }}{{ template "community_pool_tracker" .CommunityPool }}{{ else }}
  <div class="conf-hackathon-redesign__prize-hero" aria-label="Hackathon prize pool">
    <div class="conf-hackathon-redesign__trophy">
      <img src="/static/img/rebrand/hackathon-trophy.jpg" alt="An orange championship trophy" loading="lazy">
    </div>
    <div class="conf-hackathon-redesign__prize-callout">
      <p>{{ msg "hackathon.pool" }}</p>
      {{ if $prizePool }}
      <strong>{{ $prizePool }}</strong>
      <span>{{ msg "hackathon.sats" }}</span>
      {{ else }}
      <strong class="is-coming-soon">{{ msg "hackathon.prizes" }}</strong>
      <span>{{ msg "common.coming_soon" }}</span>
      {{ end }}
      <a href="{{ .HackathonURL }}#awards">{{ msg "hackathon.awards" }}</a>
    </div>
  </div>
  {{ end }}
  <div class="conf-hackathon-redesign__inner">
    <div class="conf-hackathon-redesign__copy">
      <p class="rebrand-section-label">{{ $sectionLabel }}</p>
      <p class="conf-hackathon-redesign__edition">{{ .Hackathon.Title }}</p>
      <h2>{{ ishtml $headline }}</h2>
      <div class="conf-hackathon-redesign__summary">
        {{ if .Hackathon.Description }}
        {{ hackathonDescription .Hackathon.Description .Hackathon.DescriptionFormat }}
        {{ else }}
        {{ msg "hackathon.build_event" (dict "Event" .Conf.Desc) }}
        {{ end }}
      </div>
      <div class="conf-hackathon-redesign__actions">
        <a href="{{ .HackathonURL }}" class="rebrand-button">{{ msg "hackathon.explore" }}</a>
        <a href="{{ .HackathonURL }}#projects" class="rebrand-button is-secondary">{{ msg "hackathon.gallery" }}</a>
      </div>
      <div class="conf-hackathon-redesign__judges" aria-label="Hackathon judges">
        {{ if .HackathonJudgesArePast }}
        <div class="conf-hackathon-redesign__past-judges-note">
          <strong>{{ msg "hackathon.past_judges" }}</strong>
          <span>{{ .HackathonJudgesLabel }} {{ msg "hackathon.panel_soon" }}</span>
        </div>
        {{ end }}
        {{ if .HackathonJudges }}
        <div class="conf-hackathon-redesign__avatars" aria-hidden="true">
          {{ range .HackathonJudges }}
          <img src="{{ speakerPhoto .Photo }}" alt="" title="{{ if .Name }}{{ .Name }}{{ else }}Hackathon judge{{ end }}">
          {{ end }}
        </div>
        {{ end }}
        {{ if not .HackathonJudgesArePast }}<p>{{ .HackathonJudgeNote $judgesNote }}</p>{{ end }}
      </div>
    </div>

    <aside class="conf-hackathon-redesign__proof" aria-label="Last edition hackathon highlights">
      <p class="conf-hackathon-redesign__proof-kicker">{{ $proofLabel }}</p>
      <div class="conf-hackathon-redesign__rows">
        {{ if .HackathonPlaceRows }}
        {{ range .HackathonPlaceRows }}
        <a href="{{ $.HackathonURL }}{{ if .ProjectID }}#project-{{ .ProjectID }}{{ else }}#awards{{ end }}" class="conf-hackathon-redesign__row">
          <span class="conf-hackathon-redesign__place">{{ .PlaceLabel }}</span>
          <span class="conf-hackathon-redesign__project">
            {{ if .SponsorLogoURL }}<span class="conf-hackathon-redesign__award-logo"><img src="{{ .SponsorLogoURL }}" alt="{{ .SponsorLogoAlt }}"></span>{{ end }}
            <strong>{{ .ProjectTitle }}{{ range .ExtraPrizeNames }} <span>+ {{ . }}</span>{{ end }}</strong>
            {{ if .Detail }}<em>{{ .Detail }}</em>{{ end }}
            {{ if .Members }}
            <span class="conf-hackathon-redesign__team" aria-label="Project team">
              {{ range .Members }}
              <span class="conf-hackathon-redesign__member" title="{{ .Name }}">
                {{ if .Photo }}<img src="{{ speakerPhoto .Photo }}" alt="{{ .Name }}" loading="lazy">{{ else }}<span aria-hidden="true">+</span>{{ end }}
              </span>
              {{ end }}
            </span>
            {{ end }}
          </span>
        </a>
        {{ end }}
        {{ else }}
        <a href="{{ .HackathonURL }}#awards" class="conf-hackathon-redesign__row">
          <span class="conf-hackathon-redesign__place">★</span>
          <span class="conf-hackathon-redesign__project">
            <strong>{{ msg "hackathon.prizes_soon" }}</strong>
            <em>{{ msg "hackathon.prizes_note" }}</em>
          </span>
        </a>
        {{ end }}
      </div>
      <a href="{{ .HackathonURL }}#projects" class="conf-hackathon-redesign__all">{{ msg "hackathon.all_projects" }}</a>
    </aside>
  </div>
</section>
{{ end }}
{{ end }}
