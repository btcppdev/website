{{/*
  event_jsonld — Schema.org Event JSON-LD for conf pages. Lets Google
  surface the conference (and each scheduled talk as a SubEvent) in
  rich SERP cards + the Search Console "Events" report.

  Takes the full *ConfPage as data (uses .Conf + .EventSpeakers +
  .ScheduledSessions). Safe to render unconditionally: subEvent[] is
  emitted only when ScheduledSessions is non-empty, and performer[]
  only when EventSpeakers is non-empty.

  String fields go through {{ jsonStr }} (JSON encode + quote);
  session timestamps go through {{ jsonDate }}. Conference date-only
  values stay date-only; unknown conference dates are omitted.
*/}}
{{ define "event_jsonld" }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Event",
  "name": {{ jsonStr .Conf.Desc }},
  "description": {{ jsonStr (conferenceSEODescription .Conf) }},
  {{ if not .Conf.StartDate.IsZero }}"startDate": {{ jsonStr (eventSEODate .Conf .Conf.StartDate) }},{{ end }}
  {{ if not .Conf.EndDate.IsZero }}"endDate": {{ jsonStr (eventSEODate .Conf .Conf.EndDate) }},{{ end }}
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": {{ jsonStr .Conf.Venue }},
    "address": {{ if and .Conf.PickupAddressLine1 .Conf.PickupAddressCountry }}{
      "@type": "PostalAddress",
      "streetAddress": {{ jsonStr .Conf.PickupAddressLine1 }},
      "addressLocality": {{ jsonStr .Conf.PickupAddressCity }},
      "addressRegion": {{ jsonStr .Conf.PickupAddressRegion }},
      "postalCode": {{ jsonStr .Conf.PickupAddressPostalCode }},
      "addressCountry": {{ jsonStr .Conf.PickupAddressCountry }}
    }{{ else }}{{ jsonStr .Conf.Location }}{{ end }}{{ if .Conf.VenueWebsite }},
    "url": {{ jsonStr .Conf.VenueWebsite }}{{ end }}
  },
  "image": {{ jsonStr (absoluteSEOURL (conferenceSocialCard .Conf)) }},
  "url": {{ jsonStr (absoluteSEOURL (localeURL (printf "/%s" .Conf.Tag))) }},
  "organizer": {
    "@type": "Organization",
    "name": "bitcoin++",
    "url": "https://btcpp.dev"
  }{{ if .Tix }},
  "offers": {
    "@type": "Offer",
    "url": {{ jsonStr (absoluteSEOURL (localeURL (printf "/%s#tickets" .Conf.Tag))) }},
    "price": {{ .Tix.StandardPrice }},
    "priceCurrency": {{ jsonStr (or .Tix.Currency "USD") }},
    "availability": "https://schema.org/{{ if gt .TixLeft 0 }}InStock{{ else }}SoldOut{{ end }}"
  }{{ end }}{{ if .EventSpeakers }},
  "performer": [{{ range $i, $sp := .EventSpeakers }}{{ if $i }},{{ end }}
    {
      "@type": "Person",
      "name": {{ jsonStr $sp.Name }}{{ if $sp.Company }},
      "affiliation": {
        "@type": "Organization",
        "name": {{ jsonStr $sp.Company }}
      }{{ end }}
    }{{ end }}
  ]{{ end }}{{ if .ScheduledSessions }},
  "subEvent": [{{ range $i, $s := .ScheduledSessions }}{{ if $i }},{{ end }}
    {
      "@type": "Event",
      "name": {{ jsonStr $s.Name }},
      "startDate": {{ jsonDate $s.Sched.Start }}{{ if $s.Sched.End }},
      "endDate": {{ jsonDate $s.Sched.End }}{{ end }},
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
        "@type": "Place",
        "name": {{ jsonStr (or (mapVenue $s.Venue) $.Conf.Venue) }},
        "address": {{ jsonStr $.Conf.Location }}
      }{{ if $s.Speakers }},
      "performer": [{{ range $j, $sp := $s.Speakers }}{{ if $j }},{{ end }}
        {
          "@type": "Person",
          "name": {{ jsonStr $sp.Name }}
        }{{ end }}
      ]{{ end }}
    }{{ end }}
  ]{{ end }}
}
</script>
{{ end }}
