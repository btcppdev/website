<!DOCTYPE html>
<html>
<head>
  <title>Account settings · bitcoin++</title>
  {{ block "header" . }} {{ end }}
</head>
<body class="btcpp-profile-edit-page account-settings-page">
  {{ block "mainnav" . }} {{ end }}

  <main class="profile-edit-shell person-emails-page">
    <header class="profile-edit-hero account-settings-hero">
      <div class="account-settings-hero__copy">
        <a class="profile-edit-back" href="/dashboard">← Dashboard</a>
        <p class="profile-edit-tag">§ ACCOUNT CONTROL ROOM</p>
        <h1>Account <span>settings.</span></h1>
        <p>Manage sign-in methods, verified email addresses, connected applications, and credentials used by API clients.</p>
      </div>
      <dl class="account-settings-hero__facts" aria-label="Account summary">
        <div><dt>Verified emails</dt><dd>{{ len .Emails }}</dd></div>
        <div><dt>API tokens</dt><dd>{{ len .APITokens }}</dd></div>
        <div><dt>Authorized apps</dt><dd>{{ len .OAuthConsents }}</dd></div>
      </dl>
    </header>

    <nav class="account-settings-index" aria-label="Account settings sections">
      <a href="#settings-sign-in">/sign-in</a>
      <a href="#settings-apps">/apps</a>
      {{ if .IsGlobalAdmin }}<a href="#settings-oauth-server">/oauth server</a>{{ end }}
      <a href="#settings-api">/api tokens</a>
      <a href="#settings-emails">/emails</a>
    </nav>

    {{ if .FlashMessage }}<div class="profile-edit-flash">{{ .FlashMessage }}</div>{{ end }}
    {{ if .FlashError }}<div class="profile-edit-flash person-emails-error">{{ .FlashError }}</div>{{ end }}

    <section id="settings-sign-in" class="profile-edit-section is-open">
      <div class="profile-edit-section__index">ID</div>
      <div class="profile-edit-section__body">
        <div class="profile-edit-section__head">
          <div>
            <p>§ SIGN-IN METHODS</p>
            <h2>Connected accounts</h2>
          </div>
        </div>
        <div class="person-email-list">
          {{ range .OAuthIdentities }}
          <div class="person-email-row settings-provider-row">
            <div>
              <strong>{{ .Label }} · {{ .Identity.Username }}</strong>
              <span class="is-primary">CONNECTED</span>
              {{ if .Identity.Email }}<small>{{ .Identity.Email }}{{ if .Identity.EmailVerified }} · verified by provider{{ end }}</small>{{ end }}
            </div>
            <div class="person-email-actions">
              <form method="POST" action="/auth/oauth/{{ .Identity.Provider }}/unlink">
                <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}">
                <input type="hidden" name="identity_id" value="{{ .Identity.ID }}">
                <button type="submit" class="is-danger">Unlink</button>
              </form>
            </div>
          </div>
          {{ end }}
          {{ range .OAuthProviders }}
          {{ if .Enabled }}
          <div class="person-email-row settings-provider-row">
            <div>
              <strong>{{ .Label }}</strong>
              <small>{{ .Description }}</small>
            </div>
            <div class="person-email-actions"><a class="person-oauth-link" href="{{ .LinkURL }}">Connect</a></div>
          </div>
          {{ else }}
          <div class="person-email-row settings-provider-row is-pending"><div><strong>{{ .Label }}</strong><span class="is-pending">COMING SOON</span><small>Sign-in is not configured on this environment.</small></div></div>
          {{ end }}
          {{ end }}
          <div class="person-email-row settings-method-row">
            <div>
              <strong>Password</strong><span {{ if .HasPassword }}class="is-primary"{{ else }}class="is-pending"{{ end }}>{{ if .HasPassword }}SET{{ else }}NOT SET{{ end }}</span>
              <small>{{ if .HasPassword }}Choose a new password. This signs out other browser sessions.{{ else }}Add a password as another way to sign in.{{ end }}</small>
              <form method="POST" action="/dashboard/password" class="person-email-add person-password-form mt-3">
                <input type="hidden" name="csrf" value="{{ .AuthMethodsCSRF }}">
                <label>NEW PASSWORD
                  <input type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password">
                </label>
                <label>CONFIRM PASSWORD
                  <input type="password" name="password_confirm" required minlength="12" maxlength="128" autocomplete="new-password">
                </label>
                <button type="submit">{{ if .HasPassword }}Change password{{ else }}Set password{{ end }}</button>
              </form>
            </div>
          </div>
          {{ range .Passkeys }}
          <div class="person-email-row settings-method-row">
            <div>
              <strong>{{ .DisplayName }}</strong><span class="is-primary">PASSKEY</span>
              <small>Added {{ .CreatedAt.Format "Jan 2, 2006" }}{{ if .LastUsedAt }} · last used {{ .LastUsedAt.Format "Jan 2, 2006" }}{{ end }}</small>
            </div>
            <div class="person-email-actions">
              <form method="POST" action="/auth/passkey/unlink">
                <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}">
                <input type="hidden" name="credential_id" value="{{ .ID }}">
                <button type="submit" class="is-danger">Remove</button>
              </form>
            </div>
          </div>
          {{ end }}
          <div class="person-email-row settings-method-row{{ if not .Passkeys }} is-pending{{ end }}">
            <div>
              <strong>Passkey</strong>{{ if not .Passkeys }}<span class="is-pending">NOT ADDED</span>{{ end }}
              <small data-passkey-status>Use this device, a synced passkey, or a hardware security key.</small>
              <label class="mt-3">PASSKEY NAME
                <input type="text" data-passkey-name maxlength="80" placeholder="My laptop" autocomplete="off">
              </label>
            </div>
            <div class="person-email-actions">
              <button type="button" class="person-oauth-link" data-passkey-register>Add passkey</button>
            </div>
          </div>
          {{ range .NostrCredentials }}
          <div class="person-email-row settings-method-row">
            <div><strong>Nostr</strong><span class="is-primary">{{ if .Legacy }}PROFILE ONLY{{ else }}VERIFIED{{ end }}</span><small>{{ .Display }}{{ if .Legacy }} · unlink and prove this key before using it to sign in{{ end }}</small></div>
            <div class="person-email-actions">
              <form method="POST" action="/auth/nostr/unlink">
                <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}">
                <input type="hidden" name="credential_id" value="{{ .Credential.ID }}">
                <button type="submit" class="is-danger">Unlink</button>
              </form>
            </div>
          </div>
          {{ end }}
          {{ if not .NostrCredentials }}
          <div class="person-email-row settings-method-row is-pending">
            <div>
              <strong>Nostr</strong>{{ if not .NostrCredentials }}<span class="is-pending">NOT LINKED</span>{{ end }}
              <small data-nostr-status>Use a NIP-07 signer such as Alby to prove and link a key.</small>
            </div>
            <div class="person-email-actions">
              <button type="button" class="person-oauth-link" data-nostr-link data-challenge="/auth/nostr/link/challenge" data-verify="/auth/nostr/link/verify">Link key</button>
            </div>
          </div>
          {{ end }}
        </div>
      </div>
    </section>

    <section id="settings-apps" class="profile-edit-section is-open">
      <div class="profile-edit-section__index">APP</div>
      <div class="profile-edit-section__body">
        <div class="profile-edit-section__head"><div><p>§ AUTHORIZED APPS</p><h2>Third-party access</h2></div></div>
        <p><small>These applications can use bitcoin++ on your behalf within the listed scopes. Revoking access invalidates their access and refresh tokens.</small></p>
        <div class="person-email-list">
          {{ range .OAuthConsents }}
          <div class="person-email-row"><div><strong>{{ .ClientName }}</strong><span class="is-primary">AUTHORIZED</span>
            <small>{{ .ClientID }} · authorized {{ .GrantedAt.Format "Jan 2, 2006" }}</small>
            <small>Scopes: {{ range $index, $scope := .Scopes }}{{ if $index }}, {{ end }}{{ $scope }}{{ end }}</small>
          </div><div class="person-email-actions"><form method="POST" action="/dashboard/settings/oauth-consents/revoke">
            <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}"><input type="hidden" name="client_id" value="{{ .ClientDBID }}">
            <button type="submit" class="is-danger">Revoke access</button>
          </form></div></div>
          {{ else }}<div class="person-email-row is-pending"><div><strong>No authorized applications</strong><small>Apps appear here after you approve an OAuth authorization request.</small></div></div>{{ end }}
        </div>
      </div>
    </section>

    {{ if .IsGlobalAdmin }}
    <section id="settings-oauth-server" class="profile-edit-section is-open">
      <div class="profile-edit-section__index">O₂</div>
      <div class="profile-edit-section__body">
        <div class="profile-edit-section__head"><div><p>§ OAUTH SERVER</p><h2>Registered applications</h2></div></div>
        <p><small>Public clients are for browser and native apps and must use PKCE. Confidential clients are only for servers that can keep a client secret.</small></p>
        {{ if .NewOAuthClientID }}
        <div class="profile-edit-flash">
          <strong>OAuth application registered.</strong>
          <code style="display:block;overflow-wrap:anywhere;margin-top:.75rem;user-select:all">Client ID: {{ .NewOAuthClientID }}</code>
          {{ if .NewOAuthClientSecret }}<code style="display:block;overflow-wrap:anywhere;margin-top:.5rem;user-select:all">Client secret: {{ .NewOAuthClientSecret }}</code><small>Copy the secret now. It will not be shown again.</small>{{ end }}
        </div>
        {{ end }}
        <div class="person-email-list">
          {{ range .OAuthClients }}
          <div class="person-email-row oauth-client-card{{ if .RevokedAt }} is-pending{{ end }}">
            <div class="oauth-client-card__content">
              <div class="oauth-client-card__heading">
                <strong>{{ .Name }}</strong>{{ if .RevokedAt }}<span class="is-pending">REVOKED</span>{{ else }}<span class="is-primary">ACTIVE</span>{{ end }}
              </div>
              <dl class="oauth-client-card__metadata">
                <div><dt>Client ID</dt><dd><code>{{ .ClientID }}</code></dd></div>
                <div><dt>Client type</dt><dd>{{ .TokenEndpointAuthMethod }}</dd></div>
                <div><dt>Created</dt><dd>{{ .CreatedAt.Format "Jan 2, 2006" }}</dd></div>
              </dl>
              <div class="oauth-client-card__callbacks">
                <p>Callback URLs</p>
                <ul>{{ range .RedirectURIs }}<li><code>{{ . }}</code></li>{{ end }}</ul>
              </div>
              <div class="oauth-client-card__scopes">
                <p>Permissions</p>
                <ul>{{ range .AllowedScopes }}<li><code>{{ . }}</code></li>{{ end }}</ul>
              </div>
            </div>
            {{ if not .RevokedAt }}
            <div class="person-email-actions"><form method="POST" action="/dashboard/settings/oauth-clients/revoke">
              <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}"><input type="hidden" name="client_id" value="{{ .ID }}">
              <button type="submit" class="is-danger">Revoke</button>
            </form></div>
            {{ end }}
          </div>
          {{ else }}<div class="person-email-row is-pending"><div><strong>No OAuth applications</strong><small>Register one to let a third-party app request scoped access.</small></div></div>{{ end }}
        </div>
        <form method="POST" action="/dashboard/settings/oauth-clients" class="person-email-add oauth-client-form mt-3">
          <input type="hidden" name="csrf" value="{{ .AuthMethodsCSRF }}">
          <label>APPLICATION NAME<input type="text" name="name" required maxlength="100" placeholder="My bitcoin++ app"></label>
          <label>CLIENT TYPE<select name="client_type"><option value="public" selected>Public — native or browser app</option><option value="confidential">Confidential — server backend</option></select></label>
          <label class="oauth-client-form__callbacks">CALLBACK URLS <small>Enter one URL per line.</small><textarea name="redirect_uris" required rows="3" placeholder="https://app.example.com/oauth/callback&#10;myapp://oauth/callback"></textarea></label>
          <fieldset class="credential-permissions"><legend>ALLOWED PERMISSIONS</legend>
            <div class="credential-permissions__list">
              <label><input type="checkbox" name="scopes" value="identity:self:read" checked><span><code>identity:self:read</code> Read account identity and current roles</span></label>
              <label><input type="checkbox" name="scopes" value="profile:self:read" checked><span><code>profile:self:read</code> Read private profile</span></label>
              <label><input type="checkbox" name="scopes" value="profile:self:write"><span><code>profile:self:write</code> Update profile</span></label>
              <label><input type="checkbox" name="scopes" value="talks:read" checked><span><code>talks:read</code> Read talks</span></label>
              <label><input type="checkbox" name="scopes" value="talks:write"><span><code>talks:write</code> Update talks</span></label>
              <label><input type="checkbox" name="scopes" value="schedule:write"><span><code>schedule:write</code> Manage schedules <small>Requires a current admin role.</small></span></label>
              <label><input type="checkbox" name="scopes" value="recordings:write"><span><code>recordings:write</code> Manage recordings <small>Requires a current admin role.</small></span></label>
              <label><input type="checkbox" name="scopes" value="shop:accounting:read"><span><code>shop:accounting:read</code> Read PII-free shop inventory and sales <small>Requires a current global-admin role.</small></span></label>
              <label><input type="checkbox" name="scopes" value="offline_access" checked><span><code>offline_access</code> Issue rotating refresh tokens</span></label>
            </div>
          </fieldset>
          <button type="submit">Register OAuth application</button>
        </form>
      </div>
    </section>
    {{ end }}

    <section id="settings-api" class="profile-edit-section is-open">
      <div class="profile-edit-section__index">API</div>
      <div class="profile-edit-section__body">
        <div class="profile-edit-section__head">
          <div>
            <p>§ API ACCESS</p>
            <h2>Personal API tokens</h2>
          </div>
        </div>
        <p><small>Tokens act as you within their selected scopes. Store them like passwords. Revoking a token does not sign you out of the website.</small></p>
        {{ if .NewAPIToken }}
        <div class="profile-edit-flash">
          <strong>Copy this token now. It will not be shown again.</strong>
          <code style="display:block;overflow-wrap:anywhere;margin-top:.75rem;user-select:all">{{ .NewAPIToken }}</code>
        </div>
        {{ end }}
        <div class="person-email-list">
          {{ range .APITokens }}
          <div class="person-email-row{{ if or .RevokedAt .Expired }} is-pending{{ end }}">
            <div>
              <strong>{{ .Name }}</strong>
              {{ if .RevokedAt }}<span class="is-pending">REVOKED</span>{{ else if .Expired }}<span class="is-pending">EXPIRED</span>{{ else }}<span class="is-primary">ACTIVE</span>{{ end }}
              <small>{{ .Prefix }}… · created {{ .CreatedAt.Format "Jan 2, 2006" }} · expires {{ .ExpiresAt.Format "Jan 2, 2006" }}{{ if .LastUsedAt }} · last used {{ .LastUsedAt.Format "Jan 2, 2006" }}{{ end }}</small>
              <small>Scopes: {{ range $index, $scope := .Scopes }}{{ if $index }}, {{ end }}{{ $scope }}{{ end }}</small>
            </div>
            {{ if and (not .RevokedAt) (not .Expired) }}
            <div class="person-email-actions">
              <form method="POST" action="/dashboard/settings/api-tokens/revoke">
                <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}">
                <input type="hidden" name="token_id" value="{{ .ID }}">
                <button type="submit" class="is-danger">Revoke</button>
              </form>
            </div>
            {{ end }}
          </div>
          {{ else }}
          <div class="person-email-row is-pending"><div><strong>No API tokens</strong><small>Create one when you are ready to use the API.</small></div></div>
          {{ end }}
        </div>
        <form method="POST" action="/dashboard/settings/api-tokens" class="person-email-add api-token-form mt-3">
          <input type="hidden" name="csrf" value="{{ .AuthMethodsCSRF }}">
          <label>TOKEN NAME
            <input type="text" name="name" required maxlength="80" placeholder="My integration" autocomplete="off">
          </label>
          <fieldset class="credential-permissions">
            <legend>ALLOWED PERMISSIONS</legend>
            <div class="credential-permissions__list">
              <label><input type="checkbox" name="scopes" value="identity:self:read"><span><code>identity:self:read</code> Read your account identity and current roles</span></label>
              <label><input type="checkbox" name="scopes" value="profile:self:read" checked><span><code>profile:self:read</code> Read your private profile</span></label>
              <label><input type="checkbox" name="scopes" value="profile:self:write"><span><code>profile:self:write</code> Update your profile</span></label>
              <label><input type="checkbox" name="scopes" value="talks:read"><span><code>talks:read</code> Read your talks</span></label>
              <label><input type="checkbox" name="scopes" value="talks:write"><span><code>talks:write</code> Update talks you can edit</span></label>
              <label><input type="checkbox" name="scopes" value="schedule:write"><span><code>schedule:write</code> Manage conference schedules <small>Requires a current admin role.</small></span></label>
              <label><input type="checkbox" name="scopes" value="recordings:write"><span><code>recordings:write</code> Manage recording metadata <small>Requires a current admin role.</small></span></label>
              {{ if .IsGlobalAdmin }}<label><input type="checkbox" name="scopes" value="shop:accounting:read"><span><code>shop:accounting:read</code> Read PII-free shop inventory and sales <small>Requires your current global-admin role.</small></span></label>{{ end }}
            </div>
          </fieldset>
          <label>EXPIRES
            <select name="expires_in">
              <option value="30">30 days</option>
              <option value="90" selected>90 days</option>
              <option value="365">1 year</option>
            </select>
          </label>
          <button type="submit">Create API token</button>
        </form>
      </div>
    </section>

    <section id="settings-emails" class="profile-edit-section is-open">
      <div class="profile-edit-section__index">@</div>
      <div class="profile-edit-section__body">
        <div class="profile-edit-section__head">
          <div>
            <p>§ VERIFIED EMAILS</p>
            <h2>{{ len .Emails }} attached</h2>
          </div>
        </div>
        <div class="person-email-list">
          {{ range .Emails }}
          <div class="person-email-row">
            <div>
              <strong>{{ .Email }}</strong>
              <span {{ if .IsPrimary }}class="is-primary"{{ end }}>{{ if .IsPrimary }}PRIMARY{{ else }}VERIFIED{{ end }}</span>
              {{ if .RemovalLocked }}<small>Locked during merge undo window</small>{{ end }}
            </div>
            <div class="person-email-actions">
              {{ if not .IsPrimary }}
              <form method="POST" action="/dashboard/emails/primary">
                <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}">
                <input type="hidden" name="email" value="{{ .Email }}">
                <button type="submit">Make primary</button>
              </form>
              {{ end }}
              {{ if gt (len $.Emails) 1 }}
              <form method="POST" action="/dashboard/emails/remove">
                <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}">
                <input type="hidden" name="email" value="{{ .Email }}">
                <button type="submit" class="is-danger" {{ if .RemovalLocked }}disabled{{ end }}>Remove</button>
              </form>
              {{ end }}
            </div>
          </div>
          {{ end }}
          {{ range .PendingEmails }}
          <div class="person-email-row is-pending">
            <div>
              <strong>{{ . }}</strong>
              <span class="is-pending">PENDING</span>
            </div>
            <div class="person-email-actions">
              <form method="POST" action="/dashboard/emails/resend">
                <input type="hidden" name="csrf" value="{{ $.AuthMethodsCSRF }}">
                <input type="hidden" name="email" value="{{ . }}">
                <button type="submit" class="is-link">Resend email</button>
              </form>
            </div>
          </div>
          {{ end }}
        </div>
      </div>
    </section>

    <section id="settings-add-email" class="profile-edit-section is-open">
      <div class="profile-edit-section__index">+</div>
      <div class="profile-edit-section__body">
        <div class="profile-edit-section__head">
          <div>
            <p>§ ADD EMAIL</p>
            <h2>Add second email</h2>
          </div>
        </div>
        <form method="POST" action="/dashboard/emails/request" class="person-email-add">
          <input type="hidden" name="csrf" value="{{ .AuthMethodsCSRF }}">
          <label>SECOND EMAIL
            <input type="email" name="email" required autocomplete="email">
          </label>
          <button type="submit">Add second email</button>
        </form>
        <p><small>We’ll email this address. New addresses are verified and attached; addresses with an existing profile receive a private account-merge review.</small></p>

        {{ if .MergeRequests }}
        <div class="person-email-list">
          {{ range .MergeRequests }}
          <div class="person-email-row">
            <div>
              {{ if eq .RequesterPersonID $.Speaker.ID }}
                <strong>Merge with {{ .TargetName }}</strong>
                <small>{{ .TargetEmail }}</small>
              {{ else }}
                <strong>Requested by {{ .RequesterName }}</strong>
                <small>{{ .RequesterEmail }}</small>
              {{ end }}
            </div>
            <div class="person-email-actions"><span {{ if or (eq .Status "awaiting_confirmation") (eq .Status "pending") }}class="is-pending"{{ end }}>{{ if eq .Status "awaiting_confirmation" }}AWAITING EMAIL REVIEW{{ else if eq .Status "pending" }}READY TO COMPLETE{{ else }}{{ .Status }}{{ end }}</span></div>
          </div>
          {{ end }}
        </div>
        {{ end }}
      </div>
    </section>
  </main>

  {{ block "footer" . }} {{ end }}
  <script src="/static/js/nostr-login.js" defer></script>
  <script src="/static/js/passkey.js" defer></script>
</body>
</html>
