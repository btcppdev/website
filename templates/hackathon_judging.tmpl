<!doctype html>
<html lang="en">
<head>
  <title>Judging - {{ .Competition.Title }} - bitcoin++ hackathon</title>
  {{ template "hackathon_header" . }}
  <script src="/static/js/hackathon-live-results.js" defer></script>
</head>
<body class="hack-redesign">
  {{ template "generic_conf_ticker" (dict "Conf" .Conf "Label" "Hackathon judging") }}
  {{ template "generic_conf_nav" .Conf }}
  <main class="hack-shell">
    <section class="hack-section">
      <div class="hack-section__head">
        <div>
          <div class="hack-label">§ Judging</div>
          <h1 style="margin:0;font-size:clamp(48px,7vw,88px);font-weight:700;line-height:.92;">Rank the <span class="hack-serif">projects.</span></h1>
        </div>
        <div class="hack-section__deck">Submit scores for the current judging round. Admins open and advance rounds from the backend.</div>
      </div>
    </section>

    {{ if .FlashMessage }}
    <div class="hack-alert hack-alert--success">{{ .FlashMessage }}</div>
    {{ end }}
    {{ if .FlashError }}
    <div class="hack-alert hack-alert--error">{{ .FlashError }}</div>
    {{ end }}

    {{ if .CanViewJudgingResults }}
    <nav class="hack-tabs hack-judging-view-tabs" aria-label="Judging views">
      <a href="{{ .JudgingURL }}" class="hack-tab" aria-selected="{{ if not .JudgingResultsSelected }}true{{ else }}false{{ end }}">Ballot</a>
      <a href="{{ .JudgingResultsURL nil }}" class="hack-tab" aria-selected="{{ if .JudgingResultsSelected }}true{{ else }}false{{ end }}">Results</a>
    </nav>
    {{ end }}

    {{ if .JudgingResultsSelected }}
    {{ $results := .JudgingResults }}
    <section class="hack-section hack-judging-results">
      <div class="hack-section__head">
        <div>
          <div class="hack-label">§ Deliberation results</div>
          <h2>Review the <span class="hack-serif">rankings.</span></h2>
        </div>
        <div class="hack-section__deck">Read-only aggregate results for rounds you submitted or completed. Standings update live as judges submit their choices.</div>
      </div>

      {{ if .JudgingResultEvents }}
      <nav class="hack-results-events" aria-label="Judging rounds">
        {{ range .JudgingResultEvents }}
        <a href="{{ $.JudgingResultsURL . }}" class="hack-results-event{{ if $.JudgingResultEventIs . }} hack-results-event--active{{ end }}" {{ if $.JudgingResultEventIs . }}aria-current="page"{{ end }}>
          <strong>{{ .Name }}</strong>
          <span>{{ $.JudgeTypeLabel .PlaybookType }} · {{ $.JudgeEventStateLabel . }}</span>
          {{ if .StartsAt }}<time class="hackathon-judging-time" datetime="{{ .StartsAt.Format "2006-01-02T15:04:05Z07:00" }}">{{ .StartsAt.Format "2006-01-02 15:04" }}</time>{{ end }}
        </a>
        {{ end }}
      </nav>
      {{ end }}

      {{ if not $results.Event }}
      <div class="hack-empty">Results become available after you submit a ballot or one of your assigned judging rounds closes.</div>
      {{ else }}
      <div data-live-judging-results data-live-results-url="{{ .JudgingLiveResultsURL $results.Event }}">
        {{ template "hackathon_judging_results_live" . }}
      </div>
      {{ end }}
    </section>
    {{ else }}
    {{ if .CanViewRegularJudging }}
    {{ $event := .CurrentJudgeEvent }}
    <section class="hack-section hack-judging-round">
      {{ if $event }}
      <div class="hack-current-round{{ if .CanScoreJudgeEvent $event }} hack-current-round--open{{ end }}">
        <div class="hack-current-round__label">{{ if .CanScoreJudgeEvent $event }}Open now{{ else }}Current judging round{{ end }}</div>
        <div class="hack-current-round__body">
          <div>
            <div class="hack-label">{{ .JudgeTypeLabel $event.PlaybookType }}</div>
            <h2>{{ $event.Name }}</h2>
            <p class="hack-current-round__summary">{{ if .CanScoreJudgeEvent $event }}This is the active ballot. Rank the projects, then submit your choices when you are ready.{{ else }}This round is selected, but it is not currently accepting scores for your account.{{ end }}</p>
          </div>
          <div class="hack-current-round__meta">
            <span>{{ .RankLimit $event }} ranks</span>
            <span>{{ .JudgeEventStateLabel $event }}</span>
            <span>{{ len .Projects }} project{{ if ne (len .Projects) 1 }}s{{ end }}</span>
            {{ if $event.StartingProjectNumber }}<span>Starts at #{{ $event.StartingProjectNumber }}</span>{{ end }}
          </div>
        </div>
        <div class="hack-current-round__times">
          {{ if or $event.StartsAt $event.EndsAt }}
          {{ if $event.StartsAt }}<div><span>Starts</span><time class="hackathon-judging-time" datetime="{{ $event.StartsAt.Format "2006-01-02T15:04:05Z07:00" }}">{{ $event.StartsAt.Format "2006-01-02 15:04" }}</time></div>{{ end }}
          {{ if $event.EndsAt }}<div><span>Ends</span><time class="hackathon-judging-time" datetime="{{ $event.EndsAt.Format "2006-01-02T15:04:05Z07:00" }}">{{ $event.EndsAt.Format "2006-01-02 15:04" }}</time></div>{{ end }}
          {{ else }}
          <div><span>Schedule</span><strong>Time TBA</strong></div>
          {{ end }}
        </div>
      </div>

      {{ if .Projects }}
      <form id="event-{{ $event.ID }}" method="POST" action="{{ .JudgingURL }}/scorecards" class="hack-form hack-judging-ballot" data-judge-ballot data-ballot-submitted="{{ if .HasSubmittedBallot $event }}true{{ else }}false{{ end }}">
        {{ if .CanScoreJudgeEvent $event }}
        <input type="hidden" name="JudgeEventID" value="{{ $event.ID }}">
        <div class="hack-form__body">
          <div>
            <div class="hack-label" style="margin-bottom:8px;">Ballot</div>
            <h3 style="margin:0;font-size:32px;font-weight:700;">Current ranking</h3>
          </div>
          <p class="hack-judging-ballot__note">Choose each rank once. Your choices are not recorded until you submit them.</p>
        </div>
        <div class="hack-table-wrap">
          <table class="hack-table">
            <thead>
              <tr>
                <th scope="col">Project</th>
                <th scope="col">Rank</th>
              </tr>
            </thead>
            <tbody>
              {{ range $.Projects }}
              {{ $project := . }}
              {{ $scorecard := $.Scorecard .ID $event.ID }}
              <tr>
                <td>
                  <input type="hidden" name="ProjectID" value="{{ .ID }}">
                  <a href="{{ $.ProjectURL . }}" class="hack-judging-project-link">{{ $.ProjectNumberLabel . }} · {{ .Title }}</a>
                  {{ if .ShortDescription }}<div class="hack-list__meta">{{ .ShortDescription }}</div>{{ end }}
                </td>
                <td class="hack-field hack-rank-cell">
                  <fieldset class="hack-rank-picker" aria-label="Rank {{ .Title }}">
                    {{ range $.RankOptions $event }}
                    {{ $rank := . }}
                    <label class="hack-rank-option">
                      <input type="radio" name="{{ printf "Rank_%s" $project.ID }}" value="{{ . }}" {{ with $scorecard }}{{ if eq ($.ScoreValue .Rank) (printf "%d" $rank) }}checked{{ end }}{{ end }}>
                      <span>{{ $.RankOptionLabel $event . }}</span>
                    </label>
                    {{ end }}
                    <label class="hack-rank-option">
                      <input type="radio" name="{{ printf "Rank_%s" .ID }}" value="" {{ if not $scorecard }}checked{{ else }}{{ if eq ($.ScoreValue $scorecard.Rank) "" }}checked{{ end }}{{ end }}>
                      <span>Not ranked</span>
                    </label>
                  </fieldset>
                </td>
              </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
        <div class="hack-ballot-submit" data-ballot-submit-wrap>
          <p class="hack-ballot-submit__error" data-ballot-submit-error role="alert" hidden></p>
          <button type="submit" class="hack-button hack-button--accent hack-ballot-submit__button" data-ballot-submit>
            <span data-ballot-submit-label>Submit choices</span>
            <small data-ballot-submit-count>0 selected</small>
          </button>
        </div>
        {{ else }}
        <div class="hack-empty">This round is not open for your account.</div>
        {{ end }}
      </form>
      {{ else }}
      <div class="hack-empty">No projects are visible for this judging round.</div>
      {{ end }}
      {{ else }}
      <div class="hack-current-round hack-current-round--empty">
        <div class="hack-current-round__label">Current judging round</div>
        <div class="hack-current-round__body">
          <div>
            <div class="hack-label">Judging</div>
            <h2>Judging is not <span class="hack-serif">open.</span></h2>
          </div>
          <div class="hack-current-round__meta">
            <span>Waiting for admin</span>
          </div>
        </div>
      </div>
      {{ end }}
    </section>
    {{ end }}

    {{ if .SponsorAwardsForJudge }}
    <section class="hack-section">
      {{ if .Competition.ResultsFinalizedAt }}
      <div class="hack-section__head">
        <div>
          <div class="hack-label">§ Sponsor Awards</div>
          <h2>Judging <span class="hack-serif">complete.</span></h2>
        </div>
        <div class="hack-section__deck">Hackathon results are finalized. Sponsor award winner selection is now closed.</div>
      </div>
      {{ else }}
      <div class="hack-section__head">
        <div>
          <div class="hack-label">§ Sponsor Awards</div>
          <h2>Pick sponsor award <span class="hack-serif">winners.</span></h2>
        </div>
        <div class="hack-section__deck">Sponsor judges select winners directly for each assigned award, up to its recipient limit. These selections do not affect ranked scoring.</div>
      </div>
      <div class="hack-card-grid hack-card-grid--sponsor-judging">
        {{ range .SponsorAwardsForJudge }}
        {{ $award := . }}
        {{ $awardees := $.Awardees . }}
        {{ $options := $.SponsorAwardProjectOptions . }}
        <article id="award-{{ .ID }}" class="hack-card hack-sponsor-judge-card">
          <div class="hack-card__body">
            <div class="hack-tags">
              <span class="hack-tag">Sponsor award</span>
              {{ if $.AwardIsChallenge . }}<span class="hack-tag">Challenge</span>{{ end }}
              {{ if $.AwardHasSponsor . }}<span class="hack-tag">{{ $.AwardSponsorLabel . }}</span>{{ end }}
              {{ if .OptInRequired }}<span class="hack-tag">Opt-in required</span>{{ end }}
            </div>
            <h3>{{ .Title }}</h3>
            {{ if .Description }}<div class="hack-card__desc">{{ .Description }}</div>{{ end }}
            {{ if .JudgingInstructions }}<p class="hack-list__meta" style="margin-top:12px;white-space:pre-line;">{{ .JudgingInstructions }}</p>{{ end }}
            {{ if $.AwardSponsorURL . }}<div class="hack-card__links"><a href="{{ $.AwardSponsorURL . }}" target="_blank" rel="noreferrer">Sponsor</a></div>{{ end }}

            {{ if $awardees }}
            <div class="hack-sponsor-judge-card__section">
              <div class="hack-label">Selected winners</div>
              <div class="hack-list">
                {{ range $awardees }}
                <div class="hack-list__row">
                  <div>
                    <strong>#{{ $.ProjectAwardNumber . }} · {{ .ProjectTitle }}</strong>
                  </div>
                  {{ if not $.Competition.ResultsFinalizedAt }}
                  <form method="POST" action="{{ $.JudgingURL }}/award-winners/remove">
                    <input type="hidden" name="AwardID" value="{{ $award.ID }}">
                    <input type="hidden" name="ProjectID" value="{{ .ProjectID }}">
                    <button type="submit" class="hack-button hack-button--danger-soft">Remove winner</button>
                  </form>
                  {{ end }}
                </div>
                {{ end }}
              </div>
            </div>
            {{ end }}

            {{ if $.SponsorAwardCanAssign . }}
            <form method="POST" action="{{ $.JudgingURL }}/award-winners" class="hack-sponsor-judge-card__section hack-sponsor-judge-card__assignment">
              <input type="hidden" name="AwardID" value="{{ .ID }}">
              {{ if $options }}
              <label class="hack-field">
                <span>Winning project</span>
                <select name="ProjectID" required>
                  <option value="">Choose project</option>
                  {{ range $options }}
                  <option value="{{ .ID }}">{{ $.ProjectNumberLabel . }} · {{ .Title }}</option>
                  {{ end }}
                </select>
              </label>
              <button type="submit" class="hack-button hack-button--accent">Add winner</button>
              {{ else }}
              <div class="hack-sponsor-judge-card__notice">No eligible projects are available for this sponsor award.</div>
              {{ end }}
            </form>
            {{ else }}
            {{ with $.SponsorAwardAssignmentMessage . }}<div class="hack-sponsor-judge-card__notice">{{ . }}</div>{{ end }}
            {{ end }}
          </div>
        </article>
        {{ end }}
      </div>
      {{ end }}
    </section>
    {{ end }}

    <section class="hack-section">
      <div class="hack-section__head">
        <div>
          <div class="hack-label">§ Projects</div>
          <h2>Eligible <span class="hack-serif">submissions.</span></h2>
        </div>
        <div class="hack-section__deck">{{ len .Projects }} eligible project{{ if ne (len .Projects) 1 }}s{{ end }}.</div>
      </div>
      {{ if .Projects }}
      <div class="hack-card-grid">
        {{ range .Projects }}
        <article id="project-{{ .ID }}" class="hack-card hack-judging-project-card" role="link" tabindex="0" data-url="{{ $.ProjectURL . }}" aria-label="Open {{ .Title }}">
          <div class="hack-card__body">
            <div class="hack-tags">
              <span class="hack-tag">{{ $.ProjectNumberLabel . }}</span>
              <span class="hack-tag">{{ $.ProjectStatusLabel .Status }}</span>
            </div>
            <h3>{{ .Title }}</h3>
            {{ if .ShortDescription }}<div class="hack-card__desc">{{ .ShortDescription }}</div>{{ end }}
            {{ if .Description }}<div class="hack-copy__body" style="font-size:14px;line-height:1.55;">{{ hackathonRichText .Description }}</div>{{ end }}
            {{ if .Tags }}
            <div class="hack-tags">
              {{ range .Tags }}<span class="hack-tag">{{ . }}</span>{{ end }}
            </div>
            {{ end }}
            <div class="hack-card__links">
              {{ if .GitHubURL }}<a href="{{ .GitHubURL }}">GitHub</a>{{ end }}
              {{ if .DemoURL }}<a href="{{ .DemoURL }}">Demo</a>{{ end }}
              {{ if .VideoURL }}<a href="{{ .VideoURL }}">Video</a>{{ end }}
              {{ if .SlidesURL }}<a href="{{ .SlidesURL }}">Slides</a>{{ end }}
              {{ if .DocsURL }}<a href="{{ .DocsURL }}">Docs</a>{{ end }}
            </div>
          </div>
        </article>
        {{ end }}
      </div>
      {{ else }}
      <div class="hack-empty">No projects are visible yet.</div>
      {{ end }}
    </section>
    {{ end }}
  </main>
  <script>
    (function () {
      const times = Array.prototype.slice.call(document.querySelectorAll('.hackathon-judging-time'));
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
      for (const el of times) {
        const value = el.getAttribute('datetime');
        if (!value) continue;
        const date = new Date(value);
        el.textContent = new Intl.DateTimeFormat(undefined, {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: 'numeric',
          minute: '2-digit',
          timeZone: tz,
          timeZoneName: 'short'
        }).format(date);
      }
    })();
    (function () {
      const pickers = Array.prototype.slice.call(document.querySelectorAll('fieldset[aria-label^="Rank "]'));
      for (const picker of pickers) {
        const checked = picker.querySelector('input[type="radio"]:checked');
        picker.dataset.currentRank = checked ? checked.value : '';
      }

      for (const card of document.querySelectorAll('.hack-judging-project-card[data-url]')) {
        function openProjectPage() {
          const target = card.dataset.url;
          if (!target) return;
          window.location.href = target;
        }
        card.addEventListener('click', function (event) {
          if (event.target.closest('a, button, input, label, select, textarea')) return;
          openProjectPage();
        });
        card.addEventListener('keydown', function (event) {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          openProjectPage();
        });
      }

      function ballotSignature(form) {
        return Array.prototype.map.call(form.querySelectorAll('fieldset[aria-label^="Rank "]'), function (picker) {
          const checked = picker.querySelector('input[type="radio"]:checked');
          return checked ? checked.value : '';
        }).join('|');
      }

      function selectedRankCount(form) {
        return form.querySelectorAll('fieldset[aria-label^="Rank "] input[type="radio"]:checked:not([value=""])').length;
      }

      function setBallotError(form, message) {
        const error = form.querySelector('[data-ballot-submit-error]');
        if (!error) return;
        error.textContent = message || '';
        error.hidden = !message;
      }

      function updateBallotSubmit(form) {
        const button = form.querySelector('[data-ballot-submit]');
        const label = form.querySelector('[data-ballot-submit-label]');
        const countLabel = form.querySelector('[data-ballot-submit-count]');
        if (!button || !label || !countLabel) return;

        const count = selectedRankCount(form);
        const dirty = ballotSignature(form) !== form.dataset.initialSignature;
        form.dataset.dirty = dirty ? 'true' : 'false';
        countLabel.textContent = count + ' project' + (count === 1 ? '' : 's') + ' selected';

        if (form.dataset.submitting === 'true') {
          button.disabled = true;
          label.textContent = 'Submitting...';
        } else if (count === 0) {
          button.disabled = true;
          label.textContent = 'Choose at least one project';
        } else if (form.dataset.ballotSubmitted === 'true' && !dirty) {
          button.disabled = true;
          label.textContent = 'Choices submitted';
        } else {
          button.disabled = false;
          label.textContent = form.dataset.ballotSubmitted === 'true' ? 'Update choices' : 'Submit choices';
        }
      }

      for (const form of document.querySelectorAll('[data-judge-ballot]')) {
        form.dataset.initialSignature = ballotSignature(form);
        updateBallotSubmit(form);

        form.addEventListener('change', function (event) {
          const selected = event.target;
          if (!selected.matches('fieldset[aria-label^="Rank "] input[type="radio"]') || !selected.checked) return;

          const selectedPicker = selected.closest('fieldset[aria-label^="Rank "]');
          if (!selectedPicker) return;
          const previousRank = selectedPicker.dataset.currentRank || '';
          selectedPicker.dataset.currentRank = selected.value;

          if (selected.value !== '') {
            const choices = Array.prototype.slice.call(form.querySelectorAll('fieldset[aria-label^="Rank "] input[type="radio"]'));
            for (const choice of choices) {
              if (choice === selected || choice.value !== selected.value || !choice.checked) continue;
              choice.checked = false;

              const picker = choice.closest('fieldset[aria-label^="Rank "]');
              if (!picker) continue;
              const replacement = Array.prototype.find.call(picker.querySelectorAll('input[type="radio"]'), function (input) {
                return input.value === previousRank;
              });
              if (replacement) {
                replacement.checked = true;
                picker.dataset.currentRank = replacement.value;
              }
            }
          }
          setBallotError(form, '');
          updateBallotSubmit(form);
        });

        form.addEventListener('submit', async function (event) {
          if (form.dataset.submitting === 'true') {
            event.preventDefault();
            return;
          }
          if (!window.fetch || !window.URLSearchParams) return;
          event.preventDefault();
          form.dataset.submitting = 'true';
          setBallotError(form, '');
          updateBallotSubmit(form);

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: new URLSearchParams(new FormData(form)),
              credentials: 'same-origin',
              headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'fetch'
              }
            });
            const payload = await response.json().catch(function () { return {}; });
            if (!response.ok || !payload.redirect) {
              throw new Error(payload.error || 'Unable to submit your choices. Please try again.');
            }
            form.dataset.dirty = 'false';
            window.location.assign(payload.redirect);
          } catch (error) {
            form.dataset.submitting = '';
            setBallotError(form, error.message || 'Unable to submit your choices. Please try again.');
            updateBallotSubmit(form);
          }
        });
      }

      window.addEventListener('beforeunload', function (event) {
        const dirtyBallot = document.querySelector('[data-judge-ballot][data-dirty="true"]');
        if (!dirtyBallot || dirtyBallot.dataset.submitting === 'true') return;
        event.preventDefault();
        event.returnValue = '';
      });
    })();
  </script>
  {{ block "footer" . }} {{ end }}
</body>
</html>
