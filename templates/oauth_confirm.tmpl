<!doctype html>
<html lang="en">
<head>
  <title>Link {{ .ProviderName }} · bitcoin++</title>
  {{ template "header" . }}
  <link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-account-flows">
</head>
<body class="btcpp-login-page account-flow">
  {{ template "mainnav" . }}
  <main class="auth-shell auth-shell--simple">
    <section class="auth-card">
      <header class="auth-card__head">
        <h1>Link <em>{{ .ProviderName }}.</em></h1>
        <p>Confirm that {{ .ProviderName }} {{ .Identity.Username }} should sign in to the bitcoin++ profile for {{ .Speaker.Name }}.</p>
      </header>
      <div class="auth-identity">
        <strong>{{ .Identity.Username }}</strong>
        {{ if .Identity.Email }}<small><strong>{{ .Identity.Email }}</strong>{{ if .Identity.EmailVerified }} · verified{{ end }}</small>{{ end }}
      </div>
      <form method="POST" action="/auth/oauth/{{ .ProviderKey }}/confirm" class="auth-form">
        <input type="hidden" name="csrf" value="{{ .CSRF }}">
        <button class="auth-primary" type="submit">Link {{ .ProviderName }} to this profile</button>
      </form>
      <div class="auth-form auth-form__actions"><a href="/dashboard/settings">Cancel and return to account settings →</a></div>
    </section>
  </main>
  {{ template "footer" . }}
</body>
</html>
