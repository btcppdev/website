<!DOCTYPE html>
<html lang="en">
<head>
  <title>Badges · {{ .Organization.Name }} - bitcoin++</title>
  {{ block "header" . }}{{ end }}
  {{ if .CanManage }}<script src="/static/js/person-picker.js" defer></script>{{ end }}
</head>
<body class="btcpp-dashboard-page organization-dashboard-page organization-badges-page">
  {{ block "mainnav" . }}{{ end }}
  {{ template "dashboard_tabs" (dict "Active" "orgs" "ShowHackathons" .HasHackathonProjects "ShowSponsors" .ShowSponsors "ShowAdmin" .IsGlobalAdmin "PendingOrgInviteCount" .PendingOrgInviteCount) }}
  <div class="dashboard-shell">
    <main class="dashboard-main">
      {{ if .FlashMessage }}<div class="dashboard-flash is-success"><p>{{ .FlashMessage }}</p></div>{{ end }}
      {{ if .FlashError }}<div class="dashboard-flash is-error"><p>{{ .FlashError }}</p></div>{{ end }}

      {{ template "organization_workspace_header" (dict "Page" . "Active" "badges") }}

      <nav class="organization-dashboard-local-nav" aria-label="Badge sections">
        <a href="#badge-catalog">/catalog</a>
        {{ if .CanManage }}<a href="#badge-grants">/issue &amp; manage{{ if .OrganizationGrants }} ({{ len .OrganizationGrants }}){{ end }}</a>{{ end }}
        {{ if or .Badges .PersonalGrants }}<a href="#badges-for-you">/badges for you</a>{{ end }}
      </nav>

      <section class="organization-dashboard-section dashboard-workspace-panel" id="badge-catalog">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Badge catalog</div><h2>Recognition from {{ .Organization.Name }}.</h2></div>
          <p>Anyone can receive these badges. Owners and managers can issue to any Nostr pubkey or use the bitcoin++ directory to find members.</p>
        </div>
        {{ if .BadgeCatalog }}
          {{ if .BadgeCatalog.Badges }}<div class="whois-credential-grid">{{ range .BadgeCatalog.Badges }}<article class="whois-credential"><div class="whois-credential-art"><img src="{{ .ImageURL }}" alt="" loading="lazy"></div><div><small>published badge</small><h3>{{ .Name }}</h3><p>{{ .Description }}</p></div></article>{{ end }}</div>{{ else }}<p>No badge definitions have been published yet.</p>{{ end }}
          <p><a href="{{ .BadgeCatalog.CatalogURL }}" target="_blank" rel="noopener noreferrer">View public badge catalog ↗</a></p>
        {{ else }}<p>This organization has not linked a Badge Studio issuer yet.</p>{{ end }}
        {{ if .CanManage }}<div class="organization-badge-actions">{{ if .SignerURL }}<a href="{{ .SignerURL }}/?tenant=organization&amp;tenant_id={{ .Organization.Ref }}" target="_blank" rel="noopener noreferrer">Set up or open managed signer ↗</a>{{ end }}{{ if .BadgeStudioURL }}<a href="{{ .BadgeStudioURL }}/api/auth/btcpp/continue?return_to=%2F%3Fbtcpp_org%3D{{ .Organization.Ref }}" target="_blank" rel="noopener noreferrer">Open Badge Studio with bitcoin++ ↗</a>{{ end }}</div>{{ end }}
      </section>

      {{ if .CanManage }}
      <section class="organization-dashboard-section dashboard-workspace-panel" id="badge-grants">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Issue &amp; manage</div><h2>Recognize any bitcoin++ member.</h2></div>
          <p>A grant records the organization’s intent here first. If the person has a verified Nostr key it becomes ready to issue; otherwise Bitcoin++ asks them to add one.</p>
        </div>
        {{ if and .BadgeCatalog .BadgeCatalog.Badges }}
        <form method="POST" action="/dashboard/orgs/{{ orgPathRef .Organization }}/badge-grants" class="organization-badge-grant-form">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <label><span>Published badge</span><select name="badge_identifier" required><option value="">Choose a badge</option>{{ range .BadgeCatalog.Badges }}<option value="{{ .Identifier }}">{{ .Name }}</option>{{ end }}</select></label>
          <div class="organization-person-picker" data-person-picker data-person-picker-required="true" data-person-picker-max="1" data-person-picker-name="recipient_person_id" data-person-picker-search-url="/dashboard/orgs/{{ orgPathRef .Organization }}/people/search">
            <label for="BadgeGrantRecipient"><span>Bitcoin++ person</span></label>
            <input id="BadgeGrantRecipient" type="search" data-person-picker-input placeholder="Search name, email, or phone">
            <p class="hidden" data-person-picker-flash></p>
          </div>
          <button type="submit">Grant badge →</button>
        </form>
        {{ else }}<p>Publish and link an organization badge definition before creating grants.</p>{{ end }}
        {{ if .OrganizationGrants }}
        <div class="organization-badge-grant-list">
          {{ range .OrganizationGrants }}
          <article>
            <img src="{{ .BadgeImageURL | safeURL }}" alt="" loading="lazy">
            <div><small>{{ if eq .State "ready_to_issue" }}ready to issue{{ else if eq .State "delivery_error" }}delivery needs attention{{ else }}{{ .State }}{{ end }}</small><strong>{{ .BadgeName }} → {{ .RecipientName }}</strong><span>{{ if eq .State "granted" }}Waiting for a verified Nostr key.{{ else if eq .State "ready_to_issue" }}Verified key: {{ .RecipientPubkey }}{{ else if eq .State "issued" }}Nostr award: {{ .AwardEventID }}{{ else if eq .State "accepted" }}Accepted into the recipient’s Nostr profile.{{ else if eq .State "revoked" }}Revoked by the issuer{{ if .RevocationReason }} · {{ .RevocationReason }}{{ end }}{{ else if .DeliveryError }}{{ .DeliveryError }}{{ end }}</span></div>
            <div class="organization-badge-grant-actions">
              {{ if eq .State "ready_to_issue" }}{{ if $.BadgeStudioURL }}<a href="{{ $.BadgeStudioURL }}/api/auth/btcpp/continue?return_to=%2F%3Fbtcpp_org%3D{{ $.Organization.Ref }}%26grant%3D{{ .ID }}" target="_blank" rel="noopener noreferrer">Issue in Studio with bitcoin++ ↗</a>{{ end }}{{ end }}
              {{ if or (eq .State "granted") (eq .State "ready_to_issue") }}<form method="POST" action="/dashboard/orgs/{{ orgPathRef $.Organization }}/badge-grants/{{ .ID }}/cancel" onsubmit="return confirm('Cancel this badge grant?');"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><button type="submit">Cancel</button></form>{{ end }}
            </div>
          </article>
          {{ end }}
        </div>
        {{ else }}<p>No Bitcoin++ badge grants have been created by this organization yet.</p>{{ end }}
      </section>
      {{ end }}

      {{ if or .Badges .PersonalGrants }}
      <section class="organization-dashboard-section dashboard-workspace-panel" id="badges-for-you">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Badges for you</div><h2>Your credentials from organizations.</h2></div>
          <p>Badges are issued to your verified Nostr key. Pending badges appear here before you add one.</p>
        </div>
        {{ if or (and .Badges (or .Badges.Issued .Badges.Pending)) .PersonalGrants }}
        <div class="whois-credential-grid">
          {{ if .Badges }}{{ range .Badges.Issued }}<article class="whois-credential{{ if .Award.Revocation }} is-revoked{{ end }}"><div class="whois-credential-art"><img src="{{ .Definition.ImageURL }}" alt="" loading="lazy"></div><div><small>{{ if .Award.Revocation }}revoked{{ else if .Accepted }}accepted on nostr{{ else }}awarded · acceptance pending{{ end }}</small><h3>{{ .Definition.Name }}</h3>{{ if not .Award.Revocation }}{{ if .CredentialURL }}<a href="{{ .CredentialURL }}">View credential →</a>{{ end }}{{ if .ClaimURL }} <a href="{{ .ClaimURL }}">Accept on Nostr →</a>{{ end }}{{ end }}</div></article>{{ end }}{{ end }}
          {{ range .PersonalGrants }}<article class="whois-credential{{ if or (eq .State "granted") (eq .State "ready_to_issue") }} is-pending{{ end }}"><div class="whois-credential-art"><img src="{{ .BadgeImageURL | safeURL }}" alt="" loading="lazy"></div><div><small>bitcoin++ grant · {{ if eq .State "ready_to_issue" }}ready to issue{{ else }}{{ .State }}{{ end }}</small><h3>{{ .BadgeName }}</h3>{{ if eq .State "granted" }}<a href="/dashboard/settings#settings-sign-in">Add or verify your Nostr key →</a>{{ else if eq .State "ready_to_issue" }}<span>The organization can now issue this to your verified key.</span>{{ end }}</div></article>{{ end }}
        </div>
        {{ else }}<p>No badges have been issued to this profile yet.</p>{{ end }}
      </section>
      {{ end }}
    </main>
  </div>
  {{ block "footer" . }}{{ end }}
</body>
</html>
