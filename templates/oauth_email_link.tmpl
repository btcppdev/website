<!DOCTYPE html>
<html>
<head>
  <title>Link {{ .ProviderName }} · bitcoin++</title>
  {{ block "header" . }} {{ end }}
  <link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-account-flows">
</head>
<body class="btcpp-login-page account-flow">
  {{ block "mainnav" . }} {{ end }}

  <main class="auth-shell auth-shell--simple">

    <section class="auth-card">
      <header class="auth-card__head">
        <h1>Check your <em>email.</em></h1>
        <p>{{ .ProviderName }} returned an email that already belongs to a bitcoin++ profile. We need to verify that email before linking the two sign-in methods.</p>
      </header>

      {{ if .Sent }}
      <div class="auth-alert auth-alert--success">Check <strong>{{ .Email }}</strong> — we sent a one-time link to finish connecting {{ .ProviderName }}.</div>
      {{ else }}
      <div class="auth-identity">
        <div class="auth-identity__row"><div><strong>{{ .Email }}</strong><small>Verified by {{ .ProviderName }}</small></div></div>
      </div>
      <form method="POST" action="/auth/oauth/{{ .ProviderKey }}/email" class="auth-form auth-form--compact">
        <input type="hidden" name="csrf" value="{{ .CSRF }}">
        <button class="auth-primary" type="submit">Send linking email <span>→</span></button>
      </form>
      {{ end }}

      <div class="auth-form auth-form__actions"><a href="/login">Cancel and return to sign in →</a></div>
    </section>
  </main>

  {{ block "footer" . }} {{ end }}
</body>
</html>
