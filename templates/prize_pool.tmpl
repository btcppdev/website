<!doctype html>
<html lang="en"><head><title>Community pool · {{ .Conf.Tag }} · Admin · bitcoin++</title>
{{ template "header" . }}{{ template "admin_favicon" "" }}
<style>.pool-admin-card{background:white;border:1px solid #ddd;border-radius:8px;padding:24px;margin:20px 0}.pool-admin-card label{display:block;margin:16px 0}.pool-admin-card input:not([type=checkbox]),.pool-admin-card textarea{display:block;width:100%;padding:10px;border:1px solid #bbb;border-radius:4px;margin-top:6px}.pool-admin-card button{padding:10px 16px;background:#111;color:white;border-radius:4px;margin:12px 0}.pool-admin-card button:disabled{opacity:.4}.pool-admin-stats{display:flex;flex-wrap:wrap;gap:32px}.pool-admin-stats strong{display:block;font-size:28px}.pool-payments{width:100%;border-collapse:collapse;min-width:650px}.pool-payments td,.pool-payments th{text-align:left;padding:12px;border-bottom:1px solid #ddd;vertical-align:top}.pool-payments td{max-width:300px;overflow-wrap:anywhere}.pool-payment-note{white-space:pre-wrap}.pool-payment-late{display:inline-block;margin:8px 0;padding:4px 8px;border:1px solid #b91c1c;border-radius:4px;background:#fef2f2;color:#991b1b;font-size:12px;font-weight:700;line-height:1.4}.pool-admin-subtabs{display:flex;gap:24px;margin:20px 0}.pool-admin-subtabs a[aria-current=page]{font-weight:700;border-bottom:2px solid #111}.pool-admin-card p{margin:12px 0}.pool-admin-card a{text-decoration:underline}</style>
</head><body class="btcpp-admin-page admin-hackathon-page bg-gray-50 text-gray-900">
{{ template "mainnav" . }}
<main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
<a href="{{ .EditURL .Competition }}" class="text-indigo-600">← {{ .Competition.Title }}</a><h1 class="mt-2 text-2xl font-semibold">Community prize pool</h1>
<p class="mt-1 mb-6 text-sm text-gray-600">Manage community funding for {{ .Conf.Desc }}.</p>
{{ template "admin_hackathon_tabs" . }}
{{ if .Error }}<p class="btcpp-admin-flash btcpp-admin-flash--error" role="alert">{{ .Error }}</p>{{ end }}
{{ with .Pool }}<section class="pool-admin-card"><div class="pool-admin-stats"><div>Total confirmed funding<strong>{{ .Sats }} sats</strong></div><div>Successful payments<strong>{{ .Count }}</strong></div><div>Status<strong>{{ .Status }}</strong></div></div><p>{{ .Address }}</p>{{ if .Stale }}<p>Updates delayed. Showing the last confirmed funding; monitoring will reconcile payments when it reconnects.</p>{{ else }}<p>Last checked {{ .SyncedAt.Format "Jan 2, 15:04 MST" }}.</p>{{ end }}<p class="text-sm text-gray-600">Received contributions, including late payments. This is the prize funding total, not an available wallet balance or payout record.</p></section>{{ end }}
<nav class="pool-admin-subtabs" aria-label="Community pool sections"><a href="{{ .CommunityPoolURL .Competition }}" {{ if not .PaymentsTab }}aria-current="page"{{ end }}>Setup</a>{{ if .Pool }}<a href="{{ .CommunityPoolURL .Competition }}?tab=payments" {{ if .PaymentsTab }}aria-current="page"{{ end }}>Successful payments</a>{{ end }}</nav>
{{ if .PaymentsTab }}
<section class="pool-admin-card"><h2 class="text-xl font-semibold">Successful payments</h2><p>Newest first. Descriptions and payer notes are visible only to hackathon administrators. A note is shown only when supplied by the payment source.</p>
{{ if .Payments }}<div class="overflow-x-auto"><table class="pool-payments"><thead><tr><th>Received (UTC)</th><th>Amount</th><th>Method</th><th>Description / note</th></tr></thead><tbody>{{ range .Payments }}<tr><td>{{ .PaidAt.UTC.Format "2006-01-02 15:04:05" }}{{ if .Late }}<div><span class="pool-payment-late" title="Received after funding closed; included in the pool total and flagged for review.">After closing</span></div>{{ end }}<details><summary>Payment hash</summary><code>{{ .Hash }}</code></details></td><td>{{ .Sats }} sats</td><td>{{ .Method }}</td><td>{{ if .Description }}<p class="pool-payment-note">{{ .DescriptionText }}</p>{{ end }}{{ if .Note }}<p class="pool-payment-note"><b>Payer note:</b> {{ .Note }}</p>{{ else }}<p class="text-sm text-gray-500">No payer note supplied</p>{{ end }}</td></tr>{{ end }}</tbody></table></div>{{ else }}<p>No successful payments on this page yet.</p>{{ end }}
<nav class="pool-admin-subtabs" aria-label="Payment pages">{{ if .Offset }}<a href="?tab=payments&offset={{ .PreviousOffset }}">← Newer payments</a>{{ end }}{{ if .HasNext }}<a href="?tab=payments&offset={{ .NextOffset }}">Older payments →</a>{{ end }}</nav></section>
{{ else }}
<section class="pool-admin-card"><h2 class="text-xl font-semibold">Funding setup</h2>
{{ if not .Pool }}
<form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}"><label><input type="checkbox" name="CommunityEnabled" value="yes" required> Enable community prize pool</label><label>Address name<input name="CommunitySlug" value="{{ .Conf.Tag }}" required maxlength="64" pattern="[a-z0-9][a-z0-9._-]{0,63}"></label><p class="text-sm">Your address will be name@{{ .Domain }}.</p><label>LNURL invoice description<textarea name="CommunityDescription" rows="3" maxlength="500" placeholder="bitcoin++ {{ .Conf.Tag }} community prize pool"></textarea></label><p>Save a private draft first, then register the address. The description also identifies the BOLT12 offer.</p><button name="action" value="enable">Enable and save setup</button></form>
{{ else }}
<p><b>Lightning address:</b> {{ .Pool.Address }}</p><p><b>Invoice description:</b> {{ .Pool.Description }}</p><p class="text-sm">Address and description are fixed for this pool so retries recover the same endpoint and offer.</p>
{{ if eq .Pool.Status "draft" }}
{{ if not .Configured }}<p>An accounts admin must configure the node and DNS credentials and enable monitoring before this address can be registered.</p>{{ end }}
<form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}"><button name="action" value="setup" {{ if not .Configured }}disabled{{ end }}>Register address / retry</button></form>
<p>LNURL registered: {{ .Pool.EndpointCreated }} · BIP353 published: {{ .Pool.DNSPublished }}</p>
{{ if .Pool.EndpointCreated }}<p><a href="https://{{ .Pool.Domain }}/.well-known/lnurlp/{{ .Pool.Slug }}">Inspect Lightning address ↗</a></p>{{ end }}
<form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}"><label><input type="checkbox" name="verified" value="yes" required> I verified public DNSSEC resolution and the Lightning address’s invoice flow.</label><button name="action" value="open">Open public funding</button></form>
{{ else if or (eq .Pool.Status "open") (eq .Pool.Status "closing") }}
<p><a href="/{{ .Conf.Tag }}/hackathon?prize=community#community-prize">View public community prize ↗</a></p>
<form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}"><label><input type="checkbox" name="confirmed" value="yes" required> Close new contributions. Payments received after this cutoff remain recorded for review.</label><button name="action" value="close">Close funding / retry</button></form>
{{ else }}<p>Funding is closed. Previously issued invoices are still tracked.</p>{{ end }}
{{ end }}</section>
{{ if and .Pool .Prizes }}<section class="pool-admin-card"><h2 class="text-xl font-semibold">Linked hackathon prizes</h2><p>Link existing pooled prizes. Linking does not allocate or pay funds.</p>{{ range .Prizes }}<form method="post"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><input type="hidden" name="prize" value="{{ .ID }}">{{ .Title }} · {{ if .Linked }}Linked{{ else }}Not linked{{ end }} <button name="action" value="link">Link to pool</button></form>{{ end }}</section>{{ end }}
{{ end }}
</main></body></html>
