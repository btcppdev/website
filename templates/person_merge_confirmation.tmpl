<!DOCTYPE html>
<html>
<head>
  <title>Confirm account merge · bitcoin++</title>
  {{ block "header" . }} {{ end }}
</head>
<body class="btcpp-profile-edit-page">
  {{ block "mainnav" . }} {{ end }}

  <main class="profile-edit-shell person-emails-page">
    <header class="profile-edit-hero">
      <p class="profile-edit-tag">§ ACCOUNT</p>
      <h1>Merge <span>accounts.</span></h1>
      {{ if .Merged }}
        <p>The second email and its account history are now part of one bitcoin++ account.</p>
      {{ else }}
        <p>Choose which profile details should be kept. Account history moves automatically.</p>
      {{ end }}
    </header>

    {{ if .Error }}<div class="profile-edit-flash person-emails-error">{{ .Error }}</div>{{ end }}
    {{ if .Merged }}
      <section class="profile-edit-section is-open">
        <div class="profile-edit-section__index">✓</div>
        <div class="profile-edit-section__body">
          <div class="profile-edit-section__head"><div><p>§ COMPLETE</p><h2>Accounts merged</h2></div></div>
          <p>You can now sign in with either email. Tickets, talks, volunteer work, registrations, orders, and other account records have moved to the combined account.</p>
          <p><a href="/dashboard">Go to dashboard →</a></p>
        </div>
      </section>
    {{ else if and .Request .Preview }}
      <section class="profile-edit-section is-open">
        <div class="profile-edit-section__index">⇄</div>
        <div class="profile-edit-section__body">
          <div class="profile-edit-section__head"><div><p>§ MERGE REQUEST</p><h2>Merge these accounts?</h2></div></div>
          <p><strong>{{ .Request.RequesterName }}</strong> ({{ .Request.RequesterEmail }}) asked to add <strong>{{ .Request.TargetEmail }}</strong> to their account.</p>
          <p>The requesting account remains the main account. For each populated difference below, keep its current value or replace it with the value from this second account.</p>

          {{ if .Preview.Conflicts }}
          <div class="person-merge-conflicts">
            <strong>This merge needs help before it can complete.</strong>
            <ul>{{ range .Preview.Conflicts }}<li>{{ .Description }}</li>{{ end }}</ul>
          </div>
          {{ end }}

          <form method="POST" action="/account/merge/confirm" class="person-merge-review">
            <input type="hidden" name="token" value="{{ .Token }}">
            <div class="person-merge-account-headings">
              <div><span>MAIN ACCOUNT</span><strong>{{ .Preview.Canonical.Name }}</strong><small>{{ .Request.RequesterEmail }}</small></div>
              <div><span>SECOND ACCOUNT</span><strong>{{ .Preview.Source.Name }}</strong><small>{{ .Request.TargetEmail }}</small></div>
            </div>
            <div class="person-merge-fields">
              {{ range .Fields }}
              <fieldset class="person-merge-field">
                <legend>{{ .Label }}</legend>
                <label>
                  <input type="radio" name="choice_{{ .Key }}" value="canonical" {{ if eq .DefaultChoice "canonical" }}checked{{ end }}>
                  <span><b>Keep main account</b>
                    {{ if eq .Key "photo" }}
                      {{ if $.Preview.Canonical.Photo }}<img class="person-merge-photo" src="{{ speakerPhoto $.Preview.Canonical.Photo }}" alt="">{{ else }}<em>No photo</em>{{ end }}
                    {{ else }}<em>{{ .CanonicalDisplay }}</em>{{ end }}
                  </span>
                </label>
                <label>
                  <input type="radio" name="choice_{{ .Key }}" value="source" {{ if eq .DefaultChoice "source" }}checked{{ end }}>
                  <span><b>Use second account</b>
                    {{ if eq .Key "photo" }}
                      {{ if $.Preview.Source.Photo }}<img class="person-merge-photo" src="{{ speakerPhoto $.Preview.Source.Photo }}" alt="">{{ else }}<em>No photo</em>{{ end }}
                    {{ else }}<em>{{ .SourceDisplay }}</em>{{ end }}
                  </span>
                </label>
              </fieldset>
              {{ end }}
            </div>
            <div class="person-merge-auto-move">
              <strong>Moves automatically</strong>
              <p>Verified emails, ticket registrations, talks, volunteer work, conference roles, shop orders, hackathon records, and other account history.</p>
            </div>
            <button type="submit" {{ if .Preview.Conflicts }}disabled{{ end }}>Confirm and merge accounts</button>
          </form>
          <p><small>This deletes the separate second profile after its information and records move to the main account. A reversible audit is retained for seven days. If you did not request this, close this page and contact hello@btcpp.dev.</small></p>
        </div>
      </section>
    {{ end }}
  </main>

  {{ block "footer" . }} {{ end }}
</body>
</html>
