<!doctype html>
<html lang="en">
<head>
  <title>People and identities - bitcoin++</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" "" }}
  <script src="/static/js/person-picker.js" defer></script>
</head>
<body class="btcpp-admin-page bg-gray-50 text-gray-900">
  {{ block "mainnav" . }} {{ end }}
  <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-6">
      <a href="/admin" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">&larr; Global admin</a>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">People and identities</h1>
      <p class="mt-1 text-sm text-gray-600">Resolve duplicate identities without losing conference, talk, project, or purchase history.</p>
    </div>

    {{ if .Flash }}<div class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ .Flash }}</div>{{ end }}
    {{ if .Error }}<div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ .Error }}</div>{{ end }}

    <section class="rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h2 class="text-base font-semibold text-gray-900">Merge two people</h2>
        <p class="mt-1 text-sm text-gray-600">The destination UUID remains. You will review every profile field before anything changes.</p>
        <form method="GET" action="/admin/people/merge" class="mt-5 grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium text-gray-700">Destination person</label>
            <p class="mt-0.5 text-xs text-gray-500">This person ID survives the merge.</p>
            <div class="relative mt-2" data-person-picker data-person-picker-required="true" data-person-picker-max="1" data-person-picker-name="canonical">
              <input type="search" data-person-picker-input placeholder="Search name, email, or phone" class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm">
              <p class="mt-2 hidden text-xs text-indigo-700" data-person-picker-flash></p>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700">Source person</label>
            <p class="mt-0.5 text-xs text-gray-500">This person is folded into the destination.</p>
            <div class="relative mt-2" data-person-picker data-person-picker-required="true" data-person-picker-max="1" data-person-picker-name="source">
              <input type="search" data-person-picker-input placeholder="Search name, email, or phone" class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm">
              <p class="mt-2 hidden text-xs text-indigo-700" data-person-picker-flash></p>
            </div>
          </div>
          <div class="sm:col-span-2 flex justify-end">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Review merge</button>
          </div>
        </form>
      </div>
    </section>

    <section class="mt-6 rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-base font-semibold text-gray-900">Duplicate email conflicts</h2>
            <p class="mt-1 text-sm text-gray-600">These addresses cannot sign in until the records are merged or the duplicate email is detached.</p>
          </div>
          <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800">{{ len .ConflictGroups }} emails</span>
        </div>
        {{ if .ConflictGroups }}
        <div class="mt-4 space-y-3">
          {{ range .ConflictGroups }}
          <article class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3">
            <div class="break-all font-mono text-sm font-semibold text-amber-950">{{ .Email }}</div>
            <ul class="mt-2 space-y-1 text-sm text-amber-900">
              {{ range .People }}<li>{{ .PersonName }} <span class="font-mono text-xs text-amber-700">{{ .PersonID }}</span></li>{{ end }}
            </ul>
            {{ range .Links }}
            <a href="{{ .URL }}" class="mt-3 inline-flex rounded-md bg-amber-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-800">Review {{ .SourceName }} into {{ .CanonicalName }}</a>
            {{ end }}
          </article>
          {{ end }}
        </div>
        {{ else }}
        <p class="mt-4 text-sm text-gray-500">No duplicate email conflicts.</p>
        {{ end }}
      </div>
    </section>

    <section class="mt-6 rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h2 class="text-base font-semibold text-gray-900">Merge audit</h2>
        <p class="mt-1 text-sm text-gray-600">Merge records are permanent. Completed merges can be restored for seven days.</p>
        {{ if .MergeEvents }}
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
            <thead><tr><th class="py-2 pr-4">Created</th><th class="py-2 pr-4">Destination</th><th class="py-2 pr-4">Source</th><th class="py-2 pr-4">Status</th><th class="py-2">Review</th></tr></thead>
            <tbody class="divide-y divide-gray-100">
              {{ range .MergeEvents }}
              <tr>
                <td class="whitespace-nowrap py-3 pr-4 text-xs text-gray-500">{{ .CreatedAt.Format "Jan 2, 2006 3:04 PM" }}</td>
                <td class="py-3 pr-4 font-medium">{{ .CanonicalName }}</td>
                <td class="py-3 pr-4">{{ .SourceName }}</td>
                <td class="py-3 pr-4"><span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700">{{ .Status }}</span></td>
                <td class="py-3"><a href="/admin/people/merges/{{ .ID }}" class="font-medium text-indigo-600 hover:text-indigo-500">Open audit</a></td>
              </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
        {{ else }}<p class="mt-4 text-sm text-gray-500">No people have been merged.</p>{{ end }}
      </div>
    </section>
  </main>
</body>
</html>
