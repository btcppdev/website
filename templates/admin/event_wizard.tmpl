<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><title>{{ .Title }} · bitcoin++</title><link rel="stylesheet" href="/static/css/event-wizard.css?v=20261121-steering-committee"><link rel="stylesheet" href="/static/css/brand-typography.css?v=20261121-light-surfaces"><link rel="stylesheet" href="/static/css/site-controls.css?v=20261121-header-orange">
</head>
<body class="event-wizard"><header class="ew-header"><a class="ew-brand" href="/admin">bitcoin++</a><a href="/admin/events">Event operations</a><span>Developing the <i class="brand-frontier">frontier</i> of bitcoin.</span></header>
{{ if .Index }}<main class="ew-index"><div class="ew-intro"><div><h1>Make the next<br>bitcoin++ happen.</h1><p>One place for the people, details, and decisions behind every event.</p></div><a class="ew-primary" href="/admin/events/new">＋ Create an event</a></div><div class="ew-event-grid">{{ range .Confs }}<a class="ew-event-card" href="/{{ .Tag }}/admin/setup"><span class="ew-pill">{{ if .IsPublished }}Published{{ else }}Draft{{ end }}</span><h2>{{ .Desc }}</h2><p>{{ .Location }}</p><code>/{{ .Tag }}</code><span class="ew-arrow">Plan event ↗</span></a>{{ end }}</div></main>
{{ else if .Invite }}<main class="ew-index ew-invite"><h1>Join the event team.</h1><p>Accept using the account with the email address your invitation was sent to.</p>{{ if .Error }}<p role="alert" class="ew-error">{{ .Error }}</p>{{ end }}<form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}"><button class="ew-primary">Accept invitation</button></form></main>
{{ else }}<div id="event-wizard-app" data-csrf="{{ .CSRF }}"></div><script id="event-wizard-data" type="application/json">{{ .Data }}</script><script src="/static/js/event-wizard.js?v=20261122-optional-ticket-tax" defer></script><noscript><p>Enable JavaScript to use the event setup wizard.</p></noscript>{{ end }}
</body></html>
