<!DOCTYPE html>
<html>
<head>
  <title>Edit {{ .Occurrence.CampaignTitle }} · {{ .Conf.Desc }}</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" .Conf }}
  <style>
    .event-missive-layout { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(22rem,.85fr); gap:1.5rem; align-items:start; }
    .event-missive-preview { width:100%; min-height:72vh; border:0; background:white; }
    .event-missive-backdrop,.event-missive-open,.event-missive-done { display:none; }
    @media (max-width: 1023px) {
      body.event-missive-sheet-open { overflow:hidden; }
      .event-missive-layout { display:block; }
      .event-missive-preview { min-height:calc(100vh - 12rem); }
      .event-missive-controls { position:fixed; z-index:60; left:0; right:0; bottom:0; max-height:88vh; overflow-y:auto; border-radius:1rem 1rem 0 0; padding-bottom:calc(1.5rem + env(safe-area-inset-bottom)); transform:translateY(105%); transition:transform .2s ease; }
      .event-missive-sheet-open .event-missive-controls { transform:translateY(0); }
      .event-missive-backdrop { display:block; position:fixed; z-index:50; inset:0; border:0; background:rgba(17,24,39,.45); opacity:0; pointer-events:none; transition:opacity .2s ease; }
      .event-missive-sheet-open .event-missive-backdrop { opacity:1; pointer-events:auto; }
      .event-missive-open { display:inline-flex; position:fixed; z-index:40; right:1rem; bottom:calc(1rem + env(safe-area-inset-bottom)); border-radius:9999px; background:#111827; color:white; padding:.75rem 1rem; font-size:.875rem; font-weight:700; box-shadow:0 10px 25px rgba(0,0,0,.2); }
      .event-missive-done { display:inline-flex; }
    }
  </style>
</head>
<body class="btcpp-admin-page bg-gray-50">
  {{ block "mainnav" . }} {{ end }}
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <a href="/{{ .Conf.Tag }}/admin/missives" class="text-xs text-gray-500 hover:text-gray-700">&larr; Event emails</a>
    <div class="mt-3">
      <div class="text-xs font-semibold uppercase tracking-wide text-indigo-600">{{ .Occurrence.Audience }} · sends {{ .Occurrence.SendLabel }}</div>
      <h1 class="mt-1 text-2xl font-bold text-gray-900">Edit generated draft</h1>
      <p class="mt-1 text-sm text-gray-500">This copy was populated from event data at build time. Saving changes only this occurrence.</p>
    </div>
    {{ if .Error }}<div class="mt-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ .Error }}</div>{{ end }}
    <div class="event-missive-layout mt-6">
      <section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm" aria-label="Rendered email preview">
        <div class="border-b border-gray-200 bg-gray-50 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-gray-500">Rendered draft</div>
        <iframe title="Rendered email preview" class="event-missive-preview" srcdoc="{{ .Preview }}"></iframe>
      </section>
      <form id="EventMissiveControls" method="POST" action="/{{ .Conf.Tag }}/admin/missives/occurrences/{{ .Occurrence.ID }}" class="event-missive-controls rounded-lg border border-gray-200 bg-white p-6 shadow-sm" aria-hidden="false">
        <div class="flex items-center justify-between gap-3"><h2 class="font-semibold text-gray-900">Draft controls</h2><button id="CloseEventMissiveControls" type="button" class="event-missive-done rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700">Done</button></div>
        <label class="mt-5 block"><span class="text-xs font-semibold text-gray-700">Subject</span><input name="title" required value="{{ .Title }}" class="mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm"></label>
        <label class="mt-5 block"><span class="text-xs font-semibold text-gray-700">Markdown</span><textarea name="markdown" rows="24" class="mt-1 block w-full rounded-md border-gray-300 font-mono text-sm shadow-sm">{{ .Markdown }}</textarea></label>
        <div class="mt-5 flex flex-wrap justify-end gap-2">
          <button type="submit" formaction="/{{ .Conf.Tag }}/admin/missives/occurrences/{{ .Occurrence.ID }}/rebuild" formnovalidate onclick="return confirm('Replace your edits with current event data?')" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Rebuild from event data</button>
          <button type="submit" formaction="/{{ .Conf.Tag }}/admin/missives/occurrences/{{ .Occurrence.ID }}/cancel" formnovalidate onclick="return confirm('Cancel this event email?')" class="rounded-md border border-red-200 bg-white px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">Cancel email</button>
          <button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700">Save generated draft</button>
        </div>
      </form>
    </div>
  </main>
  <button id="OpenEventMissiveControls" type="button" class="event-missive-open" aria-controls="EventMissiveControls" aria-expanded="false">Edit draft</button>
  <button id="EventMissiveBackdrop" type="button" class="event-missive-backdrop" aria-label="Close draft controls"></button>
  <script>
    (() => {
      const body = document.body;
      const panel = document.getElementById('EventMissiveControls');
      const open = document.getElementById('OpenEventMissiveControls');
      const close = document.getElementById('CloseEventMissiveControls');
      const backdrop = document.getElementById('EventMissiveBackdrop');
      const setOpen = (isOpen) => {
        body.classList.toggle('event-missive-sheet-open', isOpen);
        open.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        panel.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      };
      open.addEventListener('click', () => setOpen(true));
      close.addEventListener('click', () => setOpen(false));
      backdrop.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
      if (window.matchMedia('(max-width: 1023px)').matches) panel.setAttribute('aria-hidden', 'true');
    })();
  </script>
</body>
</html>
