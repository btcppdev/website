<!DOCTYPE html>
<html>
  <head>
    <title>notify recording speakers @ bitcoin++</title>
    {{ block "header" . }} {{ end }}
  </head>
  <body class="btcpp-admin-page">
    {{ block "mainnav" . }} {{ end }}
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <section class="mt-6 mb-6">
          <div class="overflow-hidden sm:rounded-lg bg-white shadow">
            <div class="px-4 py-5 sm:p-6">
              <a href="/{{ .Conf.Tag }}/admin/recordings" class="text-xs text-gray-500 hover:text-gray-700">&larr; Recordings</a>
              <h1 class="text-xl font-bold text-gray-900">Speaker release campaign</h1>
              <p class="text-sm text-gray-500">Review the immediate schedule digest, 24-hour speaker reminders, and Buffer/X release posts before queuing them.</p>
            </div>
          </div>
        </section>

        {{ if .MailOff }}
        <section class="mb-6">
          <div class="bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg">The mailer is disabled in this environment. Email delivery will be previewed but not queued.</div>
        </section>
        {{ end }}
        {{ if .FlashMessage }}
        <section class="mb-6">
          <div class="bg-green-50 border border-green-300 text-green-800 px-4 py-3 rounded-lg">{{ .FlashMessage }}</div>
        </section>
        {{ end }}
        {{ if .DevEmailOverride }}
        <section class="mb-6">
          <div class="bg-blue-50 border border-blue-300 text-blue-900 px-4 py-3 rounded-lg">Development email override is active. All outgoing email is redirected to <strong>{{ .DevEmailOverride }}</strong>.</div>
        </section>
        {{ end }}
        {{ if not .BufferOK }}
        <section class="mb-6">
          <div class="bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg">Buffer is not configured. The emails can still be queued, but X posts will be skipped.</div>
        </section>
        {{ end }}
        {{ if .FlashError }}
        <section class="mb-6">
          <div class="bg-yellow-50 border border-yellow-300 text-yellow-800 px-4 py-3 rounded-lg">{{ .FlashError }}</div>
        </section>
        {{ end }}

        <section class="mb-6">
          <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
              <div>
                <h2 class="text-sm font-semibold text-gray-900">1. Immediate schedule digest</h2>
                <p class="text-xs text-gray-500">Each unique speaker plus every event/global admin, volunteer coordinator, and staff member receives the complete release schedule.</p>
              </div>
              <span class="text-xs text-gray-500">{{ len .Recipients }} email(s)</span>
            </div>
            {{ if .Recipients }}
            <div class="px-4 py-4 flex flex-wrap gap-2">
              {{ range .Recipients }}
              <span class="inline-flex flex-col rounded-md bg-gray-50 border border-gray-200 px-3 py-2 text-sm text-gray-900">{{ .Speaker.Name }}<span class="text-xs text-gray-500">{{ .Email }}</span></span>
              {{ end }}
            </div>
            {{ else }}
            <div class="px-4 py-6 text-sm text-gray-500">No valid speaker recipients.</div>
            {{ end }}
          </div>
        </section>

        <section class="mb-6">
          <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
              <div>
                <h2 class="text-sm font-semibold text-gray-900">2. Talk release schedule</h2>
                <p class="text-xs text-gray-500">This is the order shown in the digest. X posts are scheduled five minutes after each YouTube release.</p>
              </div>
              <span class="text-xs text-gray-500">{{ len .Talks }} talk(s)</span>
            </div>
            {{ if .Talks }}
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Talk</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">YouTube public</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Buffer/X</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Links</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  {{ range .Talks }}
                  <tr>
                    <td class="px-4 py-3 text-sm text-gray-900">{{ .VenueLabel }}</td>
                    <td class="px-4 py-3 text-sm text-gray-700">{{ .TalkTitle }}<div class="text-xs text-gray-500">{{ .SpeakerNames }}</div></td>
                    <td class="px-4 py-3 text-sm text-gray-700">{{ .PublishLabel }}<div class="text-xs text-gray-500">{{ .PublishUTCLabel }}</div></td>
                    <td class="px-4 py-3 text-sm text-gray-700">{{ .BufferLabel }}</td>
                    <td class="px-4 py-3 text-sm whitespace-nowrap"><a href="{{ .TalkURL }}" target="_blank" rel="noopener" class="text-indigo-600 hover:text-indigo-800">Talk ↗</a> <span class="text-gray-300 mx-1">·</span> <a href="{{ .YouTubeURL }}" target="_blank" rel="noopener" class="text-indigo-600 hover:text-indigo-800">YouTube ↗</a></td>
                  </tr>
                  {{ end }}
                </tbody>
              </table>
            </div>
            {{ else }}
            <div class="px-4 py-6 text-sm text-gray-500">No upcoming scheduled YouTube talks.</div>
            {{ end }}
          </div>
        </section>

        <section class="mb-6">
          <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
              <div>
                <h2 class="text-sm font-semibold text-gray-900">3. Speaker reminders</h2>
                <p class="text-xs text-gray-500">Sent 24 hours before release with the talk page, YouTube link, and attached 1080p promotional image.</p>
              </div>
              <span class="text-xs text-gray-500">{{ len .Items }} email(s)</span>
            </div>
            {{ if .Items }}
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Speaker</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Talk</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reminder sends</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  {{ range .Items }}
                  <tr>
                    <td class="px-4 py-3 text-sm text-gray-900">{{ .Speaker.Name }}<div class="text-xs text-gray-500">{{ .Email }}</div></td>
                    <td class="px-4 py-3 text-sm text-gray-700">{{ .TalkTitle }}</td>
                    <td class="px-4 py-3 text-sm text-gray-700">{{ .ReminderLabel }}</td>
                  </tr>
                  {{ end }}
                </tbody>
              </table>
            </div>
            {{ end }}
          </div>
        </section>

        {{ if .Talks }}{{ if .Recipients }}
        <section class="mb-6">
          <form method="POST" action="/{{ .Conf.Tag }}/admin/recordings/notify-speakers" class="bg-white shadow rounded-lg px-4 py-4 flex items-center justify-end gap-3">
            <a href="/{{ .Conf.Tag }}/admin/recordings" class="px-3 py-1.5 text-sm rounded-md text-gray-700 bg-gray-100 hover:bg-gray-200">Cancel</a>
            {{ if .CanSendEmailTest }}
            <button type="submit" formaction="/{{ .Conf.Tag }}/admin/recordings/notify-speakers/test" class="px-3 py-1.5 text-sm rounded-md text-indigo-700 bg-indigo-50 border border-indigo-200 hover:bg-indigo-100">Send email-only test</button>
            {{ end }}
            <button type="submit" class="px-3 py-1.5 text-sm rounded-md text-white bg-orange-600 hover:bg-orange-700">Queue speaker campaign</button>
          </form>
        </section>
        {{ end }}{{ end }}

        {{ if .Skipped }}
        <section class="mb-8">
          <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
              <h2 class="text-sm font-semibold text-gray-900">Not included</h2>
              <span class="text-xs text-gray-500">{{ len .Skipped }}</span>
            </div>
            <table class="min-w-full divide-y divide-gray-200">
              <tbody class="bg-white divide-y divide-gray-200">
                {{ range .Skipped }}
                <tr>
                  <td class="px-4 py-3 text-sm text-gray-900">{{ if .Speaker }}{{ .Speaker.Name }} — {{ end }}{{ if and .Row .Row.ConfTalk .Row.ConfTalk.Proposal }}{{ .Row.ConfTalk.Proposal.Title }}{{ else if and .Row .Row.Recording }}{{ .Row.Recording.TalkName }}{{ end }}</td>
                  <td class="px-4 py-3 text-sm text-gray-500">{{ .Reason }}</td>
                </tr>
                {{ end }}
              </tbody>
            </table>
          </div>
        </section>
        {{ end }}
      </div>
    </div>
  </body>
</html>
