<!doctype html>
<html lang="en">
<head>
  <title>Missives - bitcoin++</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" "" }}
</head>
<body class="btcpp-admin-page bg-gray-50 text-gray-900">
  {{ block "mainnav" . }} {{ end }}
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <a href="/dashboard" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">&larr; Dashboard</a>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight">Missives</h1>
        <p class="mt-1 text-sm text-gray-600">Edit reusable triggered emails, review newsletter history, or open a draft.</p>
      </div>
      <div class="flex flex-wrap items-start justify-end gap-2">
        <form method="POST" action="/admin/missives/weekly">
          <button type="submit" class="rounded-md bg-gray-900 px-3 py-2 text-sm font-semibold text-white hover:bg-gray-800">Create next weekly issue</button>
          <p class="mt-1 text-right text-xs text-gray-500">Draft for {{ .NextWeeklyLabel }}</p>
        </form>
        {{ if .IsDevelopment }}
        <form method="POST" action="/admin/missives/weekly/test-auto-draft">
          <button type="submit" {{ if not .DevReviewEmail }}disabled{{ end }} class="rounded-md border border-indigo-300 bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-800 hover:bg-indigo-100 disabled:cursor-not-allowed disabled:opacity-50">Test auto-draft</button>
          {{ if .DevReviewEmail }}
          <p class="mt-1 max-w-52 text-right text-xs text-gray-500">Review email redirects to {{ .DevReviewEmail }}</p>
          {{ else }}
          <p class="mt-1 max-w-52 text-right text-xs text-amber-700">Set DEV_EMAIL_OVERRIDE to enable</p>
          {{ end }}
        </form>
        {{ end }}
        <a href="/admin/missives/new" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">New blank missive</a>
      </div>
    </div>

    {{ if .FlashMessage }}
    <div class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ .FlashMessage }}</div>
    {{ end }}
    {{ if .ErrorMessage }}
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ .ErrorMessage }}</div>
    {{ end }}

    <div class="overflow-hidden rounded-lg bg-white shadow">
      <nav aria-label="Missive views" class="flex overflow-x-auto border-b border-gray-200 px-5">
        <a href="{{ .OneShotsTabURL }}" class="whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium {{ if eq .MissiveView "oneshots" }}border-indigo-600 text-indigo-600{{ else }}border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700{{ end }}">
          One-shots <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ .MissiveTabCounts.OneShots }}</span>
        </a>
        <a href="{{ .UnsentTabURL }}" class="ml-7 whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium {{ if eq .MissiveView "unsent" }}border-indigo-600 text-indigo-600{{ else }}border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700{{ end }}">
          Unsent <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ .MissiveTabCounts.Unsent }}</span>
        </a>
        <a href="{{ .SentTabURL }}" class="ml-7 whitespace-nowrap border-b-2 px-1 py-4 text-sm font-medium {{ if eq .MissiveView "sent" }}border-indigo-600 text-indigo-600{{ else }}border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700{{ end }}">
          Sent / scheduled <span class="ml-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ .MissiveTabCounts.SentScheduled }}</span>
        </a>
      </nav>
      <div class="flex flex-col gap-3 border-b border-gray-200 px-5 py-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          {{ if eq .MissiveView "oneshots" }}
          <h2 class="text-base font-semibold">One-shot emails</h2>
          <p class="mt-1 text-xs text-gray-500">The active version of each reusable email sent by an application event.</p>
          {{ else if eq .MissiveView "sent" }}
          <h2 class="text-base font-semibold">Sent and scheduled missives</h2>
          <p class="mt-1 text-xs text-gray-500">Newsletter issues already sent or scheduled for a specific date.</p>
          {{ else }}
          <h2 class="text-base font-semibold">Unsent missives</h2>
          <p class="mt-1 text-xs text-gray-500">Newsletter drafts that have not been scheduled or sent.</p>
          {{ end }}
        </div>
        <form method="GET" action="/admin/missives" class="flex items-end gap-2">
          <input type="hidden" name="view" value="{{ .MissiveView }}">
          <label class="block">
            <span class="text-xs font-medium text-gray-700">Newsletter</span>
            <select name="newsletter" class="mt-1 block min-w-48 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm">
              <option value="">All newsletters</option>
              {{ range .NewsletterOptions }}
              <option value="{{ . }}" {{ if eq $.NewsletterFilter . }}selected{{ end }}>{{ . }}</option>
              {{ end }}
            </select>
          </label>
          <button type="submit" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Filter</button>
          {{ if .NewsletterFilter }}<a href="{{ .ClearFilterURL }}" class="px-2 py-2 text-sm font-medium text-indigo-600 hover:text-indigo-500">Clear</a>{{ end }}
        </form>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Missive</th>
              <th scope="col" class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Audience / trigger</th>
              <th scope="col" class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Status</th>
              <th scope="col" class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Sent date</th>
              <th scope="col" class="px-5 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">SendAt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            {{ if .Letters }}
              {{ range .Letters }}
              <tr class="hover:bg-indigo-50">
                <td class="p-0">
                  <a href="/admin/missives/{{ .UID }}" class="block px-5 py-4">
                    <div class="text-sm font-semibold text-gray-900">{{ .Title }}</div>
                    <div class="mt-1 text-xs text-gray-500">MISS-{{ .UID }}</div>
                  </a>
                </td>
                <td class="p-0">
                  <a href="/admin/missives/{{ .UID }}" class="block px-5 py-4">
                    <div class="flex flex-wrap gap-1">
                      {{ if eq .OnlyFor "templated" }}
                      {{ range .Newsletters }}<span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-600">{{ . }}</span>{{ end }}
                      {{ else }}
                      <div>
                        {{ with index $.OneShotLabels .OnlyFor }}<div class="text-sm font-medium text-gray-800">{{ . }}</div>{{ end }}
                        <span class="mt-1 inline-block rounded bg-violet-100 px-1.5 py-0.5 font-mono text-xs text-violet-700">{{ .OnlyFor }}</span>
                      </div>
                      {{ end }}
                    </div>
                  </a>
                </td>
                <td class="p-0">
                  <a href="/admin/missives/{{ .UID }}" class="block px-5 py-4">
                    {{ if ne .OnlyFor "templated" }}
                    <span class="rounded bg-blue-100 px-2 py-1 text-xs font-medium text-blue-800">Triggered</span>
                    {{ else if .SentAt }}
                    <span class="rounded bg-green-100 px-2 py-1 text-xs font-medium text-green-800">Sent</span>
                    {{ else if index $.ScheduledMissives .UID }}
                    <span class="rounded bg-purple-100 px-2 py-1 text-xs font-medium text-purple-800">Scheduled</span>
                    {{ else }}
                    <span class="rounded bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800">Draft</span>
                    {{ end }}
                  </a>
                </td>
                <td class="p-0 text-sm text-gray-700">
                  <a href="/admin/missives/{{ .UID }}" class="block whitespace-nowrap px-5 py-4">
                    {{ if and (eq .OnlyFor "templated") .SentAt }}{{ .SentAt.Format "Jan 2, 2006 3:04 PM MST" }}{{ else }}&mdash;{{ end }}
                  </a>
                </td>
                <td class="p-0 text-sm text-gray-700">
                  <a href="/admin/missives/{{ .UID }}" class="block whitespace-nowrap px-5 py-4">{{ if ne .OnlyFor "templated" }}On trigger{{ else if .SendAt }}{{ .SendAt }}{{ else }}&mdash;{{ end }}</a>
                </td>
              </tr>
              {{ end }}
            {{ else }}
              <tr><td colspan="5" class="px-5 py-12 text-center text-sm text-gray-500">
                {{ if .NewsletterFilter }}No missives in this tab match the selected newsletter.{{ else if eq .MissiveView "oneshots" }}No one-shot emails found.{{ else if eq .MissiveView "sent" }}No sent or scheduled missives found.{{ else }}No unsent missives found.{{ end }}
              </td></tr>
            {{ end }}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
