<!doctype html>
<html lang="en">
<head>
  <title>Newsletter subscribers - bitcoin++</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" "" }}
</head>
<body class="btcpp-admin-page bg-gray-50 text-gray-900">
  {{ block "mainnav" . }} {{ end }}
  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-6">
      <a href="/admin" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">&larr; Global admin</a>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Newsletter subscribers</h1>
      <p class="mt-1 text-sm text-gray-600">Review stored email addresses and the mailing lists they currently belong to.</p>
    </div>

    <section aria-label="Subscriber totals" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg bg-white px-4 py-5 shadow">
        <div class="text-xs font-medium uppercase tracking-wide text-gray-500">General newsletter</div>
        <div class="mt-2 text-3xl font-semibold text-gray-900">{{ .Summary.NewsletterActive }}</div>
        <div class="mt-1 text-xs text-gray-500">Active on <code>newsletter</code></div>
      </div>
      <div class="rounded-lg bg-white px-4 py-5 shadow">
        <div class="text-xs font-medium uppercase tracking-wide text-gray-500">Active on any list</div>
        <div class="mt-2 text-3xl font-semibold text-gray-900">{{ .Summary.ActiveAny }}</div>
        <div class="mt-1 text-xs text-gray-500">Has at least one membership</div>
      </div>
      <div class="rounded-lg bg-white px-4 py-5 shadow">
        <div class="text-xs font-medium uppercase tracking-wide text-gray-500">All stored emails</div>
        <div class="mt-2 text-3xl font-semibold text-gray-900">{{ .Summary.TotalStored }}</div>
        <div class="mt-1 text-xs text-gray-500">Includes inactive records</div>
      </div>
      <div class="rounded-lg bg-white px-4 py-5 shadow">
        <div class="text-xs font-medium uppercase tracking-wide text-gray-500">No active lists</div>
        <div class="mt-2 text-3xl font-semibold text-gray-900">{{ .Summary.Inactive }}</div>
        <div class="mt-1 text-xs text-gray-500">Retained after unsubscribing</div>
      </div>
    </section>

    <section class="mt-6 rounded-lg bg-white shadow">
      <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
        <form method="GET" action="/admin/subscribers" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="sm:col-span-2">
            <label for="SubscriberSearch" class="block text-xs font-medium uppercase tracking-wide text-gray-500">Search email</label>
            <input id="SubscriberSearch" name="q" type="search" value="{{ .Search }}" placeholder="name@example.com"
                   class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none">
          </div>
          <div>
            <label for="SubscriberList" class="block text-xs font-medium uppercase tracking-wide text-gray-500">Mailing list</label>
            <select id="SubscriberList" name="list" class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none">
              <option value="">All lists</option>
              {{ range .ListCounts }}
              <option value="{{ .Name }}" {{ if eq .Name $.SelectedList }}selected{{ end }}>{{ .Name }} ({{ .Count }})</option>
              {{ end }}
            </select>
          </div>
          <div>
            <label for="SubscriberStatus" class="block text-xs font-medium uppercase tracking-wide text-gray-500">Status</label>
            <select id="SubscriberStatus" name="status" class="mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none">
              <option value="all" {{ if eq .Status "all" }}selected{{ end }}>All stored emails</option>
              <option value="active" {{ if eq .Status "active" }}selected{{ end }}>Active on any list</option>
              <option value="inactive" {{ if eq .Status "inactive" }}selected{{ end }}>No active lists</option>
            </select>
          </div>
          <div class="flex items-center gap-2 sm:col-span-2 lg:col-span-4">
            <button type="submit" class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Apply filters</button>
            <a href="/admin/subscribers" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Clear</a>
          </div>
        </form>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm text-gray-600 sm:px-6">
        <span>{{ .TotalFiltered }} matching email{{ if ne .TotalFiltered 1 }}s{{ end }}</span>
        {{ if .Subscribers }}<span>Showing {{ .FirstResult }}&ndash;{{ .LastResult }}</span>{{ end }}
      </div>

      {{ if .Subscribers }}
      <div class="overflow-x-auto border-t border-gray-200">
        <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
          <thead class="bg-gray-50 text-xs font-medium uppercase tracking-wide text-gray-500">
            <tr>
              <th scope="col" class="px-4 py-3 sm:px-6">Email</th>
              <th scope="col" class="px-4 py-3">Lists</th>
              <th scope="col" class="px-4 py-3">Added</th>
              <th scope="col" class="px-4 py-3 sm:pr-6">Updated</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            {{ range .Subscribers }}
            <tr>
              <td class="break-all px-4 py-4 font-medium text-gray-900 sm:px-6">{{ .Email }}</td>
              <td class="px-4 py-4">
                {{ if .Subscriptions }}
                <div class="flex min-w-48 flex-wrap gap-1.5">
                  {{ range .Subscriptions }}<span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">{{ . }}</span>{{ end }}
                </div>
                {{ else }}
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">No active lists</span>
                {{ end }}
              </td>
              <td class="whitespace-nowrap px-4 py-4 text-xs text-gray-500">{{ .CreatedAt.Format "Jan 2, 2006" }}</td>
              <td class="whitespace-nowrap px-4 py-4 text-xs text-gray-500 sm:pr-6">{{ .UpdatedAt.Format "Jan 2, 2006" }}</td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
      {{ else }}
      <div class="border-t border-gray-200 px-4 py-12 text-center sm:px-6">
        <p class="text-sm font-medium text-gray-900">No subscribers match these filters.</p>
        <p class="mt-1 text-sm text-gray-500">Try a different email, list, or status.</p>
      </div>
      {{ end }}

      {{ if gt .TotalPages 1 }}
      <nav aria-label="Subscriber pages" class="flex items-center justify-between border-t border-gray-200 px-4 py-4 sm:px-6">
        <div>{{ if .PreviousPageURL }}<a href="{{ .PreviousPageURL }}" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Previous</a>{{ end }}</div>
        <span class="text-sm text-gray-600">Page {{ .Page }} of {{ .TotalPages }}</span>
        <div>{{ if .NextPageURL }}<a href="{{ .NextPageURL }}" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50">Next</a>{{ end }}</div>
      </nav>
      {{ end }}
    </section>
  </main>
</body>
</html>
