<!doctype html>
<html lang="en">
<head>
  <title>Review person merge - bitcoin++</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" "" }}
</head>
<body class="btcpp-admin-page bg-gray-50 text-gray-900">
  {{ block "mainnav" . }} {{ end }}
  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-6">
      <a href="/admin/people" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">&larr; People and identities</a>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Review person merge</h1>
      <p class="mt-1 text-sm text-gray-600">The destination UUID survives. Email aliases and owned records move to it.</p>
    </div>

    {{ if .Error }}<div class="mb-4 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900">{{ .Error }}</div>{{ end }}
    {{ if .Preview }}
    <section class="rounded-lg bg-white shadow">
      <div class="grid divide-y divide-gray-200 sm:grid-cols-2 sm:divide-x sm:divide-y-0">
        <div class="px-4 py-5 sm:p-6">
          <div class="text-xs font-semibold uppercase text-indigo-700">Destination</div>
          <h2 class="mt-1 text-lg font-semibold">{{ .Preview.Canonical.Name }}</h2>
          <div class="mt-1 break-all font-mono text-xs text-gray-500">{{ .Preview.Canonical.ID }}</div>
          <div class="mt-3 flex flex-wrap gap-2">{{ range .Preview.CanonicalEmails }}<span class="rounded bg-indigo-50 px-2 py-1 text-xs text-indigo-800">{{ . }}</span>{{ end }}</div>
        </div>
        <div class="px-4 py-5 sm:p-6">
          <div class="text-xs font-semibold uppercase text-red-700">Source removed after merge</div>
          <h2 class="mt-1 text-lg font-semibold">{{ .Preview.Source.Name }}</h2>
          <div class="mt-1 break-all font-mono text-xs text-gray-500">{{ .Preview.Source.ID }}</div>
          <div class="mt-3 flex flex-wrap gap-2">{{ range .Preview.SourceEmails }}<span class="rounded bg-red-50 px-2 py-1 text-xs text-red-800">{{ . }}</span>{{ end }}</div>
        </div>
      </div>
    </section>

    {{ if .Preview.Conflicts }}
    <section class="mt-6 rounded-lg border-2 border-red-400 bg-red-50 px-4 py-5 sm:px-6">
      <h2 class="text-base font-bold text-red-950">Merge blocked</h2>
      <p class="mt-1 text-sm text-red-900">Resolve these relationships first. No records have been changed.</p>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-red-900">{{ range .Preview.Conflicts }}<li>{{ .Description }}</li>{{ end }}</ul>
    </section>
    {{ end }}

    <form method="POST" action="/admin/people/merge" class="mt-6">
      <input type="hidden" name="CanonicalPersonID" value="{{ .Preview.Canonical.ID }}">
      <input type="hidden" name="SourcePersonID" value="{{ .Preview.Source.ID }}">
      <section class="overflow-hidden rounded-lg bg-white shadow">
        <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
          <h2 class="text-base font-semibold text-gray-900">Profile fields</h2>
          <p class="mt-1 text-sm text-gray-600">Choose the destination value, source value, or a custom replacement for every field.</p>
        </div>
        <div class="divide-y divide-gray-200">
          {{ range .Fields }}
          <fieldset class="px-4 py-5 sm:px-6">
            <legend class="text-sm font-semibold text-gray-900">{{ .Label }}</legend>
            <div class="mt-3 grid gap-3 lg:grid-cols-3">
              <label class="flex cursor-pointer gap-3 rounded-md border border-gray-200 p-3 hover:bg-gray-50">
                <input type="radio" name="choice_{{ .Key }}" value="canonical" {{ if eq .DefaultChoice "canonical" }}checked{{ end }} class="mt-0.5">
                <span class="min-w-0"><span class="block text-xs font-semibold uppercase text-gray-500">Destination</span><span class="mt-1 block break-words text-sm text-gray-900">{{ .CanonicalDisplay }}</span></span>
              </label>
              <label class="flex cursor-pointer gap-3 rounded-md border border-gray-200 p-3 hover:bg-gray-50">
                <input type="radio" name="choice_{{ .Key }}" value="source" {{ if eq .DefaultChoice "source" }}checked{{ end }} class="mt-0.5">
                <span class="min-w-0"><span class="block text-xs font-semibold uppercase text-gray-500">Source</span><span class="mt-1 block break-words text-sm text-gray-900">{{ .SourceDisplay }}</span></span>
              </label>
              <label class="cursor-pointer rounded-md border border-gray-200 p-3 hover:bg-gray-50">
                <span class="flex gap-3"><input type="radio" name="choice_{{ .Key }}" value="custom" class="mt-0.5"><span class="text-xs font-semibold uppercase text-gray-500">Custom</span></span>
                {{ if eq .Kind "textarea" }}
                <textarea name="custom_{{ .Key }}" rows="3" class="mt-2 block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm"></textarea>
                {{ else if eq .Kind "bool" }}
                <select name="custom_{{ .Key }}" class="mt-2 block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm"><option value="false">No</option><option value="true">Yes</option></select>
                {{ else if eq .Kind "value" }}
                <input type="datetime-local" name="custom_{{ .Key }}" class="mt-2 block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm">
                {{ else }}
                <input type="text" name="custom_{{ .Key }}" class="mt-2 block w-full rounded-md border border-gray-300 px-2 py-1.5 text-sm">
                {{ end }}
              </label>
            </div>
          </fieldset>
          {{ end }}
        </div>
      </section>
      <section class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-5 sm:px-6">
        <h2 class="font-semibold text-red-950">This deletes the source person</h2>
        <p class="mt-1 text-sm text-red-900">All compatible relationships and verified emails move to the destination. The audit remains permanent, and restoration is available for seven days.</p>
        <div class="mt-4 flex justify-end">
          <button type="submit" {{ if .Preview.Conflicts }}disabled{{ end }} class="rounded-md bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-40">Merge people</button>
        </div>
      </section>
    </form>
    {{ end }}
  </main>
</body>
</html>
