<!doctype html><html lang="en"><head>
<title>Bitcoin closure refund · bitcoin++</title>
<meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow">
<link rel="stylesheet" href="/static/css/site-chrome.css?v=20260904-1"><link rel="stylesheet" href="/static/css/btcpp-redesign.css"><link rel="stylesheet" href="/static/css/shop.css?v=shipping-queue-1"><link rel="stylesheet" href="/static/css/site-navigation.css?v=20260904-1">
</head><body class="shop-page shop-admin-page">
{{ template "mainnav" . }}
<main class="shop-admin"><section class="shop-admin__intro">
<p class="shop-kicker">§ billing admin</p><h1>Bitcoin closure refund.</h1>
<p>Unused prepaid time is refunded as a proportion of the original Bitcoin payment, rounded down to a satoshi.</p>
<p>This review records the calculation. An admin pays from our wallet after destination approval; payout verification records the refund separately.</p>
<a class="shop-button" href="/admin/service-payments">Service payments</a>
</section>
{{ if .Review }}
<section><h2>Review recorded</h2><dl><dt>Review ID</dt><dd><code>{{ .Review.ID }}</code></dd><dt>Reviewed by</dt><dd><code>{{ .Review.ActorID }}</code></dd><dt>Recorded at (UTC)</dt><dd>{{ .Review.CreatedAt.UTC.Format "2006-01-02 15:04:05" }}</dd><dt>Reason</dt><dd>{{ .Review.Reason }}</dd></dl>
<p>This is the saved calculation. The current payment balance must be checked again before destination approval and payout recording.</p></section>
{{ else }}
<form method="get"><label>Payment attempt UUID <input name="attempt" value="{{ .Attempt }}" required></label><label>Permanent closure time (RFC3339, with timezone) <input name="closure" value="{{ .Closure }}" placeholder="2030-01-01T00:00:00Z" required></label><button class="shop-button" type="submit">Preview refund</button></form>
{{ end }}
{{ with .Plan }}<section><h2>Calculation</h2><dl>
<dt>Order</dt><dd><code>{{ .OrderPublicID }}</code></dd><dt>Product</dt><dd>{{ .ProductCode }}</dd><dt>Payment attempt</dt><dd><code>{{ .AttemptID }}</code></dd><dt>Closure time (UTC)</dt><dd>{{ .ClosureAt.UTC.Format "2006-01-02T15:04:05.999999Z07:00" }}</dd>
<dt>Previous refunds</dt><dd>{{ if ne .PreviouslyRefundedSatoshis nil }}{{ .PreviouslyRefundedSatoshis }} satoshis{{ else }}Unknown{{ end }}</dd>
<dt>Remaining closure refund</dt><dd>{{ if ne .RemainingRefundSatoshis nil }}{{ .RemainingRefundSatoshis }} satoshis{{ else }}Requires investigation{{ end }}</dd>
{{ with .USDAllocation }}<dt>Original USD accounting adjustment</dt><dd>{{ .AmountCents }} cents (tax inclusive)</dd>{{ end }}</dl>
{{ if .ReviewReasons }}<h3>Resolve before reviewing</h3><ul>{{ range .ReviewReasons }}<li>{{ . }}</li>{{ end }}</ul>{{ end }}</section>{{ end }}
{{ if .CanReview }}<form method="post">
<input type="hidden" name="action" value="review"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="review" value="{{ .ReviewID }}"><input type="hidden" name="attempt" value="{{ .Attempt }}"><input type="hidden" name="closure" value="{{ .Closure }}"><input type="hidden" name="amount" value="{{ .Plan.RemainingRefundSatoshis }}">
<label>Review reason <textarea name="reason" maxlength="1000" required></textarea></label>
<label><input type="checkbox" name="confirmed" value="yes" required> I reviewed the payment, closure time and calculated amount.</label>
<button class="shop-button" type="submit">Record calculation review</button>
</form>{{ else }}{{ if .Plan }}{{ if not .Review }}<p>No calculation review can be recorded until the amount is positive and all issues are resolved.</p>{{ end }}{{ end }}{{ end }}
{{ if .Review }}
{{ with .Destination }}<section><h2>Approved destination</h2><dl><dt>Address</dt><dd><code>{{ .Destination.Address }}</code></dd><dt>Network</dt><dd>{{ .Destination.Chain }}</dd><dt>Approved by</dt><dd><code>{{ .ActorID }}</code></dd><dt>Reason</dt><dd>{{ .Reason }}</dd></dl></section>{{ end }}
{{ if .Payout }}<section><h2>Payout recorded</h2>{{ with .PayoutCheck }}<p>Latest follow-up: <strong>{{ .State }}</strong>{{ with .CheckedAt }} ({{ .UTC.Format "2006-01-02 15:04:05" }} UTC){{ end }}.</p>{{ if .BlockHash }}<p>Block being monitored: <code>{{ .BlockHash }}</code>{{ if .ReconciliationID }}<br>Reconciliation: <code>{{ .ReconciliationID }}</code><br>Reviewed by <code>{{ .ReconciledBy }}</code><br>{{ .ReconciliationReason }}{{ end }}</p>{{ end }}{{ if eq .State "unverified" }}<p>The node could not reverify this output. Investigate node availability, block availability and chain status before taking action. This does not authorize another payment.</p>{{ end }}{{ end }}<p>This records the verification at the time shown, not the current confirmation count.</p><dl>
<dt>Transaction</dt><dd><code>{{ .Payout.Evidence.TxID }}</code></dd><dt>Output index</dt><dd>{{ .Payout.Evidence.Vout }}</dd><dt>Amount</dt><dd>{{ .Payout.Refund.AmountSatoshis }} satoshis</dd><dt>Recorded at (UTC)</dt><dd>{{ .Payout.RecordedAt.UTC.Format "2006-01-02 15:04:05" }}</dd></dl><a class="shop-button" href="/admin/service-refunds?attempt={{ .Plan.AttemptID }}">Inspect refund delivery and tax status</a></section>
{{ if .NodeConfigured }}<section><h3>Verify a different containing block</h3><p>If this same transaction was mined into a new block, verify its new inclusion here. This keeps the original payout record and never issues another refund.</p><form method="post">
<input type="hidden" name="action" value="reconcile"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="review" value="{{ .Review.ID }}"><input type="hidden" name="reconciliation" value="{{ .ReconciliationID }}">
<label>New containing block hash <input name="block" required minlength="64" maxlength="64" spellcheck="false"></label><label>Reconciliation reason <textarea name="reason" required maxlength="1000"></textarea></label>
<label><input type="checkbox" name="confirmed" value="yes" required> I checked that this is a new block for the same payout transaction.</label><button class="shop-button" type="submit">Verify and record new block</button></form></section>{{ end }}
{{ else if not .CurrentBasis }}<p>The payment basis has changed or cannot be verified. Create a fresh calculation review before proceeding.</p>
{{ else if not .NodeConfigured }}<p>Bitcoin Core verification is not configured. An operator must configure the connection before destination approval or payout recording.</p>
{{ else if not .Destination }}<section><h2>Approve recipient address</h2><p>Confirm the address with the recipient. Bitcoin Core validates the address and network; it cannot verify who owns the address.</p><form method="post">
<input type="hidden" name="action" value="destination"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="review" value="{{ .Review.ID }}">
<label>Bitcoin address <input name="address" required maxlength="128" autocomplete="off" spellcheck="false"></label><label>Approval reason <textarea name="reason" required maxlength="1000"></textarea></label>
<label><input type="checkbox" name="confirmed" value="yes" required> I confirmed this address belongs to the refund recipient.</label><button class="shop-button" type="submit">Verify and approve address</button></form></section>
{{ else }}<section><h2>Record an on-chain payout</h2><p>Enter the payment already sent from our wallet to the approved address for the exact reviewed amount. Verification requires six confirmations. This form does not send funds.</p><form method="post">
<input type="hidden" name="action" value="payout"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="review" value="{{ .Review.ID }}">
<label>Transaction ID <input name="txid" required minlength="64" maxlength="64" spellcheck="false"></label><label>Containing block hash <input name="block" required minlength="64" maxlength="64" spellcheck="false"></label><label>Recipient output index (starts at zero) <input name="vout" type="number" min="0" max="4294967295" step="1" required></label>
<label><input type="checkbox" name="confirmed" value="yes" required> I verified these details identify the recipient's refund payment.</label><button class="shop-button" type="submit">Verify and record payout</button></form></section>{{ end }}{{ end }}
</main></body></html>
