<!doctype html>
<html lang="en">
<head>
  <title>{{ .Current.OnlyFor }} email - bitcoin++</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" "" }}
</head>
<body class="btcpp-admin-page bg-gray-50 text-gray-900">
  {{ block "mainnav" . }} {{ end }}
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-6">
      <a href="/admin/missives" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">&larr; All missives</a>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-semibold tracking-tight">{{ .Current.OnlyFor }}</h1>
        <span class="rounded bg-violet-100 px-2 py-1 font-mono text-xs font-medium text-violet-800">Triggered email</span>
      </div>
      <p class="mt-1 text-sm text-gray-600">This reusable template is sent by application code when the <code class="rounded bg-gray-100 px-1 font-mono">{{ .Current.OnlyFor }}</code> event occurs.</p>
    </div>

    {{ if .FlashMessage }}
    <div class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ .FlashMessage }}</div>
    {{ end }}
    {{ if .ErrorMessage }}
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ .ErrorMessage }}</div>
    {{ end }}

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
      <form method="POST" action="/admin/missives/{{ .Current.UID }}/inline" class="rounded-lg bg-white p-5 shadow">
        <div class="mb-5 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
          Saving changes the next email sent by this trigger. It does not schedule or send anything now.
        </div>
        <label class="block">
          <span class="text-sm font-semibold text-gray-800">Subject</span>
          <span class="mt-1 block text-xs text-gray-500">Go-template fields can be used here too.</span>
          <input name="Title" value="{{ .Current.Title }}" required class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
        </label>
        <label class="mt-5 block">
          <span class="text-sm font-semibold text-gray-800">Body</span>
          <span class="mt-1 block text-xs text-gray-500">Markdown with Go-template expressions such as <code>{{`{{ .Volunteer.Name }}`}}</code>.</span>
          <textarea name="Markdown" rows="28" required class="mt-2 block w-full rounded-md border border-gray-300 px-3 py-2 font-mono text-sm leading-6">{{ .Current.Markdown }}</textarea>
        </label>
        <div class="mt-5 flex items-center justify-between gap-3 border-t border-gray-200 pt-4">
          <span class="text-xs text-gray-500">MISS-{{ .Current.UID }} · database key {{ .Current.PageID }}</span>
          <button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800">Save triggered email</button>
        </div>
      </form>

      <aside class="self-start rounded-lg bg-white p-5 shadow lg:sticky lg:top-6">
        <h2 class="text-base font-semibold">Available template fields</h2>
        <p class="mt-1 text-xs leading-5 text-gray-500">Copy these expressions into the subject or body. Nested fields reflect the current application data types.</p>
        {{ if .FieldNotice }}<p class="mt-3 rounded bg-blue-50 px-3 py-2 text-xs leading-5 text-blue-800">{{ .FieldNotice }}</p>{{ end }}
        <div class="mt-4 max-h-[70vh] space-y-4 overflow-y-auto pr-1">
          {{ range .Fields }}
          <details open class="rounded-md border border-gray-200 p-3">
            <summary class="cursor-pointer text-xs font-semibold text-gray-800">{{ .Name }}</summary>
            {{ if .IsRange }}
            <p class="mt-2 text-xs text-gray-500">Loop with <code class="break-all">{{`{{ range `}}{{ .Name }}{{` }}`}}</code> and <code>{{`{{ end }}`}}</code>.</p>
            {{ end }}
            <ul class="mt-2 space-y-1">
              {{ range .Items }}<li><code class="block break-all rounded bg-gray-50 px-2 py-1 text-xs">{{`{{ `}}{{ . }}{{` }}`}}</code></li>{{ end }}
            </ul>
          </details>
          {{ end }}
        </div>
      </aside>
    </div>
  </div>
</body>
</html>
