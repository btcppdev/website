<!doctype html>
<html lang="en">
<head>
  <title>Discount codes - bitcoin++</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" "" }}
</head>
<body class="btcpp-admin-page bg-gray-50 text-gray-900">
  {{ block "mainnav" . }} {{ end }}
  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mb-6">
      <a href="/admin" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">&larr; Global admin</a>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Discount codes</h1>
      <p class="mt-1 text-sm text-gray-600">Create one shared code for one or more conferences. Usage limits are shared across every selected conference.</p>
    </div>

    {{ if .Flash }}<div class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ .Flash }}</div>{{ end }}
    {{ if .FlashErr }}<div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ .FlashErr }}</div>{{ end }}

    <section class="rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Create discount code</h2>
          <p class="mt-1 text-sm text-gray-500">For a Seoul + Berlin half-price code, select both conferences and leave the default 50% amount.</p>
        </div>
        <form method="POST" action="/admin/discounts" class="mt-5 space-y-6">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
              <label for="global_code_name" class="block text-sm font-medium text-gray-700">Code</label>
              <input type="text" name="code_name" id="global_code_name" required value="{{ .Form.CodeName }}" placeholder="SEOULBERLIN50"
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm uppercase focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
            </div>
            <div>
              <label for="global_discount_type" class="block text-sm font-medium text-gray-700">Discount type</label>
              <select name="discount_type" id="global_discount_type" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                <option value="percent" {{ if or (eq .Form.DiscountType "") (eq .Form.DiscountType "percent") }}selected{{ end }}>% off</option>
                <option value="dollars" {{ if eq .Form.DiscountType "dollars" }}selected{{ end }}>Dollars off</option>
              </select>
            </div>
            <div>
              <label for="global_amount" class="block text-sm font-medium text-gray-700">Amount</label>
              <input type="number" name="amount" id="global_amount" required min="1" step="1" value="{{ .Form.Amount }}"
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
            </div>
          </div>

          <fieldset>
            <legend class="text-sm font-medium text-gray-700">Conference scope</legend>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              <label class="flex cursor-pointer items-start gap-3 rounded-md border border-gray-200 px-3 py-3 hover:bg-indigo-50">
                <input type="radio" name="conference_scope" value="selected" {{ if ne .Form.ConferenceScope "all" }}checked{{ end }} class="mt-1 border-gray-300 text-indigo-600 focus:ring-indigo-500">
                <span><span class="block text-sm font-medium text-gray-900">Selected conferences</span><span class="block text-xs text-gray-500">Limit the code to the events checked below.</span></span>
              </label>
              <label class="flex cursor-pointer items-start gap-3 rounded-md border border-amber-300 bg-amber-50 px-3 py-3 hover:bg-amber-100">
                <input type="radio" name="conference_scope" value="all" {{ if eq .Form.ConferenceScope "all" }}checked{{ end }} class="mt-1 border-gray-300 text-amber-700 focus:ring-amber-600">
                <span><span class="block text-sm font-medium text-gray-900">All current and future conferences</span><span class="block text-xs text-amber-800">Wildcard scope, matching affiliate-code behavior.</span></span>
              </label>
            </div>
            <p class="mt-4 text-xs font-medium uppercase tracking-wide text-gray-500">Conference selection</p>
            <div class="mt-3 grid max-h-72 gap-2 overflow-y-auto rounded-md border border-gray-200 p-3 sm:grid-cols-2 lg:grid-cols-3">
              {{ range .Confs }}
              <label class="flex cursor-pointer items-start gap-3 rounded-md border border-gray-200 px-3 py-2 hover:bg-indigo-50">
                <input type="checkbox" name="conference_refs" value="{{ .Ref }}" {{ if index $.SelectedConferenceRefs .Ref }}checked{{ end }}
                       class="mt-1 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-gray-900">{{ .Desc }}</span>
                  <span class="block text-xs text-gray-500">{{ .Tag }}{{ if .DateDesc }} &middot; {{ .DateDesc }}{{ end }}</span>
                  {{ if .Active }}<span class="mt-1 inline-flex rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700">Active</span>{{ end }}
                </span>
              </label>
              {{ else }}
              <p class="text-sm text-gray-500">No conferences are available.</p>
              {{ end }}
            </div>
          </fieldset>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
            <div>
              <label for="global_valid_from" class="block text-sm font-medium text-gray-700">Valid from</label>
              <input type="date" name="valid_from" id="global_valid_from" value="{{ .Form.ValidFrom }}"
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
            </div>
            <div>
              <label for="global_expires_at" class="block text-sm font-medium text-gray-700">Expires at</label>
              <input type="date" name="expires_at" id="global_expires_at" value="{{ .Form.ExpiresAt }}"
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
            </div>
            <div>
              <label for="global_max_allowed" class="block text-sm font-medium text-gray-700">Max allowed</label>
              <input type="number" name="max_allowed" id="global_max_allowed" min="1" step="1" value="{{ .Form.MaxAllowed }}" placeholder="Unlimited"
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
            </div>
            <div>
              <label for="global_affiliate_email" class="block text-sm font-medium text-gray-700">Affiliate email</label>
              <input type="email" name="affiliate_email" id="global_affiliate_email" value="{{ .Form.AffiliateEmail }}" placeholder="Optional"
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
            </div>
          </div>

          <div class="flex items-center gap-3">
            <button type="submit" onclick="return confirm('Create this discount code for every selected conference?');"
                    class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Create discount</button>
            <span class="text-xs text-gray-500">Codes are case-insensitive and saved in uppercase.</span>
          </div>
        </form>
      </div>
    </section>

    <section class="mt-8 overflow-hidden rounded-lg bg-white shadow">
      <div class="border-b border-gray-200 px-4 py-5 sm:px-6">
        <h2 class="text-lg font-semibold text-gray-900">Existing discount codes</h2>
        <p class="mt-1 text-sm text-gray-500">Shared codes appear once with all of their valid conferences.</p>
      </div>
      {{ if .Discounts }}
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
          <thead class="bg-gray-50 text-xs font-medium uppercase tracking-wide text-gray-500">
            <tr><th class="px-4 py-3 sm:pl-6">Code</th><th class="px-4 py-3">Discount</th><th class="px-4 py-3">Conferences</th><th class="px-4 py-3">Valid dates</th><th class="px-4 py-3 sm:pr-6">Uses</th></tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{ range .Discounts }}
            <tr>
              <td class="px-4 py-4 font-mono font-semibold text-gray-900 sm:pl-6">{{ .CodeName }}</td>
              <td class="px-4 py-4"><span class="font-medium text-gray-900">{{ .AmountLabel }}</span><span class="mt-0.5 block font-mono text-xs text-gray-500">{{ .Expression }}</span></td>
              <td class="px-4 py-4">
                {{ if .Conferences }}<div class="flex min-w-48 flex-wrap gap-1.5">{{ range .Conferences }}<a href="/{{ .Tag }}/admin/discounts" class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 hover:bg-indigo-100">{{ .Desc }}</a>{{ end }}</div>
                {{ else }}<span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">All current and future conferences</span>{{ end }}
              </td>
              <td class="whitespace-nowrap px-4 py-4 text-gray-600">{{ .ValidDates }}</td>
              <td class="whitespace-nowrap px-4 py-4 text-gray-600 sm:pr-6">{{ .UsesLabel }}</td>
            </tr>
            {{ end }}
          </tbody>
        </table>
      </div>
      {{ else }}<div class="px-4 py-10 text-center text-sm text-gray-500">No discount codes yet.</div>{{ end }}
    </section>
  </main>
</body>
</html>
