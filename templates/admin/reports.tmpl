  <div data-section="judges"><div class="story-text report-markdown paper-deck">{{(.Section "judges").Markdown}}</div></div>
  <div class="paper-judges">{{range .Judges}}<figure>{{if .Photo}}<img src="{{.Photo}}" alt="Portrait of {{.Name}}" loading="lazy">{{end}}<figcaption><strong>{{.Name}}</strong><span>{{if .Company}}{{.Company}}{{else}}{{.Role}}{{end}}</span>{{with .Note}}<p>{{.}}</p>{{end}}</figcaption></figure>{{end}}</div>
  {{with .Event.VenueImages}}<figure class="paper-setting"><img src="{{index . 0}}" alt="Location image from the event website"><figcaption>{{$.Event.Location}} · location imagery from the event website; not an event-action photograph.</figcaption></figure>{{end}}
  {{with .ChartFor "team-sizes"}}{{template "paper_chart" .}}{{end}}
  <footer class="paper-folio"><span>Public judge roster · names and affiliations as listed</span><span>bitcoin++ / {{.Event.Tag}}</span></footer>
</section>

{{template "report_media_totals" .MediaTotals}}{{range .MediaPages}}{{template "report_media_page" .}}{{end}}
<section id="online-reach" class="paper-sheet paper-reach" aria-label="Event reach online"><div class="paper-running"><span>05 / Beyond the room</span><span>Event recordings &amp; online visibility</span></div><h2>A room in {{.Event.Location}}.<br><em>An audience online.</em></h2><div data-section="reach_intro"><div class="story-text report-markdown">{{($.Section "reach_intro").Markdown}}</div></div>
<div class="paper-reach-platforms">{{range .HeadlinePlatforms}}<article class="paper-reach-platform"><h3>{{.Name}}</h3>{{if .Ready}}<dl>{{range .HeadlineMetrics}}{{if ne .Value ""}}<div><dt>{{.Label}}</dt><dd>{{.Display}}</dd></div>{{end}}{{end}}</dl><p class="paper-source">{{.Period}} · exported {{.Date}}<br>Source: {{.Source}}<br>Coverage: {{.Coverage}}</p>{{else}}<p class="paper-reach-status">Analytics not yet supplied</p><p class="paper-source">{{if eq .Key "youtube"}}Event video views, thumbnail impressions, watch time and views from external sources.{{else}}Impressions on event posts and views of event videos/broadcasts.{{end}}</p>{{end}}</article>{{end}}</div>
<footer class="paper-folio"><span>Event-specific coverage · dated sources</span><span>bitcoin++</span></footer></section>

{{if .PostHighlights}}<section class="paper-sheet report-post-highlights"><h2>The conversation<br><em>keeps spreading.</em></h2>{{template "report_post_cards" .PostHighlights}}<footer class="paper-folio"><span>{{.Event.Location}}</span><span>bitcoin++</span></footer></section>{{end}}

<section class="paper-sheet paper-next" aria-label="Next steps and sources">
  <div class="paper-running"><span>06 / What comes next</span><span>Make the next step easier</span></div>
  <h2>A gathering ends.<br><em>The work continues.</em></h2>
  <div data-section="closing"><div class="story-text report-markdown paper-closing">{{(.Section "closing").Markdown}}</div></div>
  <aside class="paper-thanks">{{template "report_recipient_logo" .}}<p class="paper-kicker">Our partners</p><p data-report-recipient>{{.PreparedFor}}</p><span>Thank you for supporting the people building Bitcoin.</span></aside>
  <details class="paper-methods" open><summary>Sources & reading this report</summary>
  <p>Program: <a href="https://btcpp.dev/{{.Event.Tag}}">btcpp.dev/{{.Event.Tag}}</a> · Results and judge roster: <a href="https://btcpp.dev/{{.Event.Tag}}/hackathon">event hackathon page</a>. {{if .Preview}}Public evidence reviewed {{.EvidenceDate}}.{{else}}Database edition: {{.Generated}}.{{end}}</p>
  {{if .Preview}}<p>Project descriptions summarize the published entries. Technical significance is editorial interpretation, not a claim of production readiness, subsequent adoption or panel consensus. Overall prize awards exclude other prizes and are not confirmation of settlement. Private attendance is not included in this edition. YouTube views use the dated, matched-video snapshot on the reach page; X post impressions use the dated account snapshot and the event assignments shown in the editor. Watch time remains unavailable.</p>{{else}}<p>Attendees are unique checked-in people; volunteer counts describe shift assignments. Program delivery requires editor confirmation. Project entries are submitted/advanced projects; participants are distinct members. Sats paid are recorded sent/claimed distributions, not the announced pool. Missing metrics are omitted, not treated as zero. Daily attendance is not collected.</p>{{end}}
  </details>
  <footer class="paper-folio"><span>bitcoin++ / {{.Event.Tag}}</span><span>Prepared for <span data-report-recipient>{{.PreparedFor}}</span></span></footer>
</section>
</div>
{{end}}

{{define "paper_chart"}}
<figure class="paper-chart" data-chart="{{.Kind}}">
  <div class="paper-chart-head"><h3>{{.Title}}</h3><span>{{.Unit}}</span></div>
  {{if .Donut}}<div class="paper-chart-split"><svg viewBox="0 0 220 220" role="img" aria-label="{{.Title}}"><circle cx="110" cy="110" r="78" fill="none" stroke="#ddd" stroke-width="25"/>{{range .Donut}}<circle cx="110" cy="110" r="78" pathLength="100" fill="none" stroke="{{.Color}}" stroke-width="25" stroke-dasharray="{{.Percent}} 100" stroke-dashoffset="{{.Offset}}" transform="rotate(-90 110 110)"><title>{{.Label}}: {{.Value}} ({{printf "%.0f" .Percent}}%)</title></circle>{{end}}<text x="110" y="111" text-anchor="middle">{{if eq .Kind "published-prizes"}}{{.CompactTotal}}{{else}}{{.DonutTotal}}{{end}}</text><text x="110" y="135" text-anchor="middle" class="paper-chart-unit">{{.Unit}}</text></svg><div class="paper-chart-legend">{{range .Donut}}<div><i style="background:{{.Color}}"></i><span>{{.Label}}</span><b>{{if eq $.Kind "program"}}{{.Value}}{{else}}{{printf "%.0f" .Percent}}%{{end}}</b></div>{{end}}</div></div>
  {{else}}<div class="paper-bars">{{range .Rows}}<div><span>{{.Label}}</span><b>{{if eq $.Kind "prizes"}}{{.SatsDisplay}}{{else}}{{.Value}}{{end}}</b><svg viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true"><rect width="100" height="2" fill="#dfd9e8"/><rect width="{{.Width}}" height="2" fill="#9672ca"/></svg></div>{{end}}</div>{{end}}
  <figcaption>{{.Note}}</figcaption>
</figure>
{{end}}

{{define "report_media_page"}}<section class="paper-sheet report-media-sheet"><div class="paper-running"><span>Beyond the room</span><span>Recording highlights</span></div><h2>Ideas worth<br><em>watching again.</em></h2><div class="report-media-grid">{{range .}}<article class="report-media-card"><a href="{{.URL}}">{{if .ImageURL}}<img src="{{.ImageURL}}" alt="Thumbnail for {{.Title}}">{{end}}<h3>{{.Title}}</h3></a><p class="paper-kicker">{{.Platform}} · {{.Event}}</p><p><a href="{{.URL}}">Watch recording ↗</a>{{if .MomentURL}} · <a href="{{.MomentURL}}">Watch selected moment ↗</a>{{end}}</p></article>{{end}}</div><p class="paper-source">Selected recordings from the matched event library. Explore the talks and workshops through the links above.</p></section>{{end}}

{{define "report_media_totals"}}{{if .}}<section class="paper-sheet report-media-totals"><div class="paper-running"><span>Beyond the room</span><span>The recording library</span></div><h2>A body of work.<br><em>A growing audience.</em></h2><div class="report-topline-grid">{{range .}}<article><div class="report-topline-circle"><strong>{{.Display}}</strong><span>{{.Platform}} views</span></div><p>Across {{.Recordings}} matched recordings</p><p class="paper-source">Snapshots collected {{.FirstCollected}}{{if ne .FirstCollected .LastCollected}} – {{.LastCollected}}{{end}}</p></article>{{end}}</div><p class="paper-source">Lifetime views of recordings matched to the selected events, counted once per platform and video. These are not views earned only during the reporting year, a complete channel or playlist total, or unique viewers. YouTube and X are reported separately. Export-based reach figures elsewhere may overlap and are not added to these totals.</p></section>{{end}}{{end}}

{{define "report_winner_team"}}{{if .Portraits}}<div class="report-winner-team" aria-label="Project team">{{range .Portraits}}<figure>{{if .Photo}}<img src="{{.Photo}}" alt="Profile image for {{.Name}}">{{else}}<span class="report-team-initials" aria-hidden="true">{{.Initials}}</span>{{end}}<figcaption>{{.Name}}</figcaption></figure>{{end}}</div>{{else}}{{with .Members}}<p class="paper-byline">Built by {{.}}</p>{{end}}{{end}}{{end}}

{{define "report_post_cards"}}<div class="report-post-cards">{{range .}}<article><p>{{.Text}}</p><a href="{{.URL}}">Read on X ↗</a></article>{{end}}</div>{{end}}

{{define "report_stage_demand"}}<div class="report-stage-demand"><div class="report-demand-circle"><strong>{{.Display}}</strong><span>{{.Label}}</span></div><div><h3>{{.Title}}</h3>{{if .Ratio}}<p>{{.Ratio}}</p>{{end}}{{if .Scope}}<p>{{.Scope}}</p>{{end}}</div></div>{{end}}

{{define "report_recipient_logo"}}<img class="report-recipient-logo" data-report-recipient-logo {{if .RecipientLogo}}src="{{.RecipientLogo}}"{{else}}hidden{{end}} alt="{{.PreparedFor}} logo">{{end}}
