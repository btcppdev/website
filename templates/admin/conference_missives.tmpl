<!DOCTYPE html>
<html>
<head>
  <title>{{ .Conf.Desc }} · event emails</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" .Conf }}
</head>
<body class="btcpp-admin-page bg-gray-50">
  {{ block "mainnav" . }} {{ end }}
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <a href="/{{ .Conf.Tag }}/admin" class="text-xs text-gray-500 hover:text-gray-700">&larr; {{ .Conf.Desc }} dashboard</a>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Event emails</h1>
        <p class="mt-1 text-sm text-gray-500">Drafts are built from current event data one day before their scheduled send.</p>
      </div>
      <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700">{{ .Conf.Timezone }}</span>
      {{ if inDev }}<form method="POST" action="/{{ .Conf.Tag }}/admin/missives/test-automation" class="flex items-end gap-2"><label class="text-xs font-semibold text-gray-600">Simulated local time<input type="datetime-local" name="simulated_at" class="mt-1 block rounded-md border-gray-300 text-xs"></label><button type="submit" class="rounded-md bg-gray-900 px-3 py-2 text-xs font-semibold text-white">Run automation</button></form>{{ end }}
    </div>

    {{ if .Flash }}<div class="mt-5 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ .Flash }}</div>{{ end }}
    {{ if .Error }}<div class="mt-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ .Error }}</div>{{ end }}

    <section class="mt-7 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-5 py-4">
        <h2 class="font-semibold text-gray-900">Schedule</h2>
        <p class="mt-1 text-xs text-gray-500">Past dates are retained as skipped; changing the event date recalculates future planned dates.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
            <tr><th class="px-5 py-3">Email</th><th class="px-5 py-3">Audience</th><th class="px-5 py-3">Build</th><th class="px-5 py-3">Send</th><th class="px-5 py-3">State</th><th class="px-5 py-3">Draft</th></tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
          {{ range .Occurrences }}
            <tr>
              <td class="px-5 py-3 font-medium text-gray-900">{{ .CampaignTitle }}{{ if .TargetEmail }}<div class="mt-1 font-normal text-xs text-gray-500">{{ .TargetEmail }}</div>{{ end }}</td>
              <td class="px-5 py-3 text-gray-600">{{ .Audience }}</td>
              <td class="px-5 py-3 whitespace-nowrap text-gray-600">{{ .BuildLabel }}</td>
              <td class="px-5 py-3 whitespace-nowrap text-gray-600">{{ .SendLabel }}</td>
              <td class="px-5 py-3"><span class="rounded-full bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-700">{{ .Status }}</span>{{ if not .Enabled }}<span class="ml-1 text-xs text-amber-700">paused</span>{{ end }}{{ if .LastError }}<div class="mt-2 max-w-xs text-xs text-red-700">{{ .LastError }}</div>{{ end }}</td>
              <td class="px-5 py-3">{{ if .MissiveUID }}<a class="font-semibold text-indigo-600 hover:text-indigo-800" href="/{{ $.Conf.Tag }}/admin/missives/occurrences/{{ .ID }}">Edit MISS-{{ .MissiveUID }}</a>{{ else }}<span class="text-gray-400">builds later</span>{{ end }}</td>
            </tr>
          {{ else }}
            <tr><td colspan="6" class="px-5 py-8 text-center text-gray-500">No event-email occurrences have been calculated.</td></tr>
          {{ end }}
          </tbody>
        </table>
      </div>
    </section>

    {{ if .Missives }}
    <section class="mt-8 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-5 py-4"><h2 class="font-semibold text-gray-900">On-registration missives</h2><p class="mt-1 text-xs text-gray-500">These sent to the current conference list and continue for new registrants until expiry.</p></div>
      <div class="divide-y divide-gray-100">
      {{ range .Missives }}
        <a href="/admin/missives/{{ .UID }}" class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 hover:bg-gray-50">
          <div><div class="font-semibold text-gray-900">{{ .Title }}</div><div class="mt-1 text-xs text-gray-500">MISS-{{ .UID }} · {{ .SendAt }}</div></div>
          <div class="text-xs text-gray-500">{{ if .Expiry }}expires {{ .Expiry.Format "Jan 2, 2006" }}{{ else }}no expiry{{ end }} <span class="ml-2 font-semibold text-indigo-600">Edit &rarr;</span></div>
        </a>
      {{ end }}
      </div>
    </section>
    {{ end }}

    <section class="mt-8">
      <div class="mb-3"><h2 class="font-semibold text-gray-900">Campaign templates</h2><p class="mt-1 text-xs text-gray-500">These become editable missive drafts one day before delivery.</p></div>
      <div class="grid gap-4 lg:grid-cols-2">
      {{ range .Campaigns }}
        <form method="POST" action="/{{ $.Conf.Tag }}/admin/missives/campaigns/{{ .ID }}" class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div><div class="text-xs font-semibold uppercase tracking-wide text-indigo-600">{{ .Kind }}</div><div class="mt-1 text-xs text-gray-500">{{ .Audience }} · {{ .SendTime }} local{{ if .TemplateMissiveUID }} · copied from <a href="/admin/missives/{{ .TemplateMissiveUID }}" class="font-semibold text-indigo-600 hover:text-indigo-800">MISS-{{ .TemplateMissiveUID }}</a>{{ end }}</div></div>
            <label class="inline-flex items-center gap-2 text-xs font-semibold text-gray-700"><input type="checkbox" name="enabled" value="1" {{ if .Enabled }}checked{{ end }} class="rounded border-gray-300 text-indigo-600"> Enabled</label>
          </div>
          <label class="mt-4 block"><span class="text-xs font-semibold text-gray-700">Subject</span><input name="title" required value="{{ .Title }}" class="mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm"></label>
          <label class="mt-4 block"><span class="text-xs font-semibold text-gray-700">Markdown template</span><textarea name="markdown" rows="12" class="mt-1 block w-full rounded-md border-gray-300 font-mono text-xs shadow-sm">{{ .Markdown }}</textarea></label>
          <div class="mt-4 flex justify-end"><button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700">Save campaign</button></div>
        </form>
      {{ end }}
      </div>
    </section>
  </main>
</body>
</html>
