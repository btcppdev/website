<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>{{.Year}} · {{.Recipient}} · Annual sponsor report</title><link rel="stylesheet" href="/static/css/sponsor-report.css?v=recipient-logo1"><link rel="stylesheet" href="/static/css/sponsor-report-paper.css?v=20261023-demand"><link rel="stylesheet" href="/static/css/sponsor-report-annual.css?v=20261113-floripa-prize-estimate"><script src="/static/js/sponsor-report.js?v=20261111-auto-sources" defer></script></head>
<body data-layout="paper" data-readonly="{{.Preview}}" class="annual-report">
{{if .Preview}}<div class="synthetic-banner">LOCAL LAYOUT DEMO · Illustrative event metrics, not actual annual results</div>{{end}}
<nav class="report-tools"><a href="/admin/reports">← Event reports</a><form method="get" action="/admin/reports/annual"><label>Year<input type="number" name="year" value="{{.Year}}" min="2020" max="2100"></label><label>Prepared for<select name="recipient"><option {{if eq .Recipient "NYDIG"}}selected{{end}}>NYDIG</option><option {{if eq .Recipient "HRF"}}selected{{end}}>HRF</option></select></label><button>Open annual draft</button></form>{{if not .Frozen}}<button type="button" id="report-edit">Edit report</button>{{end}}<button type="button" id="report-print">Print / Save as PDF</button></nav>
{{if .Message}}<p class="notice" role="status">{{.Message}}</p>{{end}}
{{if .Frozen}}<p class="notice">Frozen edition · {{.Frozen}}. Text and figures are preserved. <a href="{{.URL}}">Return to the live draft →</a></p>{{else}}
<aside class="notice annual-collection" aria-label="Report data collection"><strong>Event data is included automatically.</strong> Recordings and matched X posts refresh when this live draft opens. Exclude incorrect items in Edit report; your saved exclusions carry forward. <button type="button" id="annual-refresh-all" {{if .Preview}}disabled{{end}}>Refresh now</button><div id="annual-refresh-status" role="status" aria-live="polite">{{if .Preview}}Automatic collection is disabled in this preview.{{else}}Checking source data…{{end}}</div><noscript>Enable JavaScript to refresh external analytics automatically. Database figures and previously collected sources are already included.</noscript></aside>
<details class="report-editor"><summary>Edit this {{.Recipient}} edition</summary><p><strong>Visual annual review with a dedicated cover and up to three event highlights per recap page.</strong> Aim for 150–200 words in the letter and 50–80 words in each other section. Longer copy can extend the printed document; no prose is silently cut. Bracketed draft prompts stay in this editor.</p><p>NYDIG and HRF have independent drafts. Database figures load whenever you open the draft. Save keeps your text and exclusions. Freeze edition saves the text and collected figures together; future edits do not alter that edition. Export a PDF to preserve its visual appearance too.</p>
<form method="post" id="report-edit-form" data-save-label="Save annual draft"><input type="hidden" name="csrf" value="{{.CSRF}}"><input type="hidden" name="revision" value="{{.Revision}}"><p id="report-save-status" role="status">Draft loaded.</p>
<input type="hidden" name="event_selection_mode" value="exclude"><fieldset><legend>Reporting scope</legend><p>Completed events and their available registration, program, project, participant, winner and prize records are included automatically. Uncheck any event to exclude it. Prize totals count sats offered, including unawarded prizes, rather than payouts.</p><button name="action" value="include_all" {{if .Preview}}disabled{{end}}>Restore all completed events</button><p>Sponsor pages emphasize annual totals. Every selected event contributes, including smaller events. Registration headlines start at 100; video-view headlines start at 1,000. Review individual event reports for source values.</p><label>Include events completed by<input type="date" name="cutoff" value="{{.Cutoff}}" required></label><p>The cutoff selects completed events by their local end date. Counts are current records collected when you save or freeze, not historical database values as of the cutoff. Change the cutoff and save to enable newly eligible events. Published upcoming events in the report year appear automatically on the cover and closing page; their metrics are not included yet.</p>
{{range .Events}}<article class="annual-event-editor">{{if .Eligible}}<input type="hidden" name="event_seen" value="{{.Event.ID}}">{{end}}<label class="check-label"><input type="checkbox" name="event" value="{{.Event.ID}}" {{if .Included}}checked{{end}} {{if not .Eligible}}disabled{{end}}>{{.Event.Location}} · {{.Event.Period}}</label><p>{{.DataStatus}}</p>{{if .Included}}<p>{{if $.RegistrationBased}}{{.Registrations}} registrations{{else}}{{.Attendees}} recorded check-ins{{end}} · {{.Talks}} talks · {{.Workshops}} workshops · {{.Panels}} panels · {{.Projects}} projects</p>{{end}}<label>Hackathon coverage<select name="hack_{{.Event.ID}}"><option value="unknown" {{if or (eq .HackCoverage "unknown") (eq .HackCoverage "automatic")}}selected{{end}}>Automatically use available records</option>{{if .HasRetrospective}}<option value="retrospective" {{if eq .HackCoverage "retrospective"}}selected{{end}}>Use the published Insider retrospective</option><option value="excluded" {{if eq .HackCoverage "excluded"}}selected{{end}}>Exclude hackathon totals</option>{{end}}<option value="records" {{if eq .HackCoverage "records"}}selected{{end}}>Database records reviewed for this event</option>{{if not .HasRetrospective}}<option value="incomplete" {{if eq .HackCoverage "incomplete"}}selected{{end}}>Incomplete historical records — exclude hackathon totals</option>{{end}}<option value="none" {{if eq .HackCoverage "none"}}selected{{end}}>No hackathon at this event</option></select></label><a href="/{{.Event.Tag}}/admin/report">Review event report →</a></article>{{else}}<p>No published events with start dates in this year.</p>{{end}}
</fieldset>
<fieldset><legend>Recordings and posts</legend><p>Matched event recordings and all @btcplusplus posts published in the report year count automatically. Check “Exclude” for anything that does not belong, then save. Exclusions apply to this recipient’s annual report and persist across refreshes. Collected account-wide post counts take precedence over manual X impression totals.</p><details id="annual-source-review"><summary>Review {{len .SourceChoices}} recordings and posts</summary>{{range .SourceChoices}}<article class="annual-event-editor"><input type="hidden" name="source_seen" value="{{.Key}}"><label class="check-label"><input type="checkbox" name="{{.Key}}" aria-label="Exclude {{.Title}} from this report" value="yes" {{if .Excluded}}checked{{end}}>Exclude from this report</label><p><a href="{{.URL}}" target="_blank" rel="noopener">{{.Title}}</a></p><p>{{.Detail}}</p></article>{{else}}<p>No sources collected yet. Event recordings and account posts will appear here after automatic collection.</p>{{end}}</details></fieldset>
<fieldset><legend>Narrative · Markdown with live preview</legend>{{range .Sections}}<section class="narrative-editor"><label for="report-{{.Key}}">{{.Title}}</label><div class="narrative-columns"><textarea id="report-{{.Key}}" name="{{.Key}}" data-report-section="{{.Key}}" rows="10" maxlength="12000">{{.Text}}</textarea><div><div class="markdown-preview report-markdown" id="preview-{{.Key}}">{{.Markdown}}</div><p id="preview-status-{{.Key}}" class="preview-status" role="status">Preview up to date</p></div></div></section>{{end}}</fieldset>
<fieldset><legend>Event highlights · Markdown with live preview</legend><p>Aim for 45–65 words per event. Completed events appear up to three per page; upcoming events appear in the closing section. Longer copy can extend the printed document.</p>{{range .EventHighlightEditors}}<section class="narrative-editor"><label for="report-{{.Copy.Key}}">{{.Event.Location}} · {{.Event.Title}}</label><div class="narrative-columns"><textarea id="report-{{.Copy.Key}}" name="{{.Copy.Key}}" data-report-section="{{.Copy.Key}}" rows="5" maxlength="2000">{{.Copy.Text}}</textarea><div><div class="markdown-preview report-markdown" id="preview-{{.Copy.Key}}">{{.Copy.Markdown}}</div><p id="preview-status-{{.Copy.Key}}" class="preview-status" role="status">Preview up to date</p></div></div></section>{{end}}</fieldset>

<fieldset><legend>Winning projects · problem, build, and follow-up</legend><p>Public project descriptions seed the cards automatically. Keep each field to one or two sentences. Confirm follow-ups against the linked source or a team update; leave unknown outcomes blank. Empty fields are omitted from the sponsor report.</p>{{range .BriefProjects}}<article class="annual-event-editor"><h3>{{.Project.Title}} · {{.Event}}</h3><a href="{{.URL}}" target="_blank" rel="noopener">{{if .Project.SourceURL}}Read the retrospective{{else}}Read the team’s submission{{end}} ↗</a>{{range .StoryFields}}<label for="{{.Key}}">{{.Label}}<textarea id="{{.Key}}" name="{{.Key}}" rows="3" maxlength="1200" placeholder="{{.Placeholder}}">{{.Text}}</textarea></label>{{end}}</article>{{end}}</fieldset>
<fieldset><legend>Annual online reach · optional overrides</legend><p>Optional annual exports: explain the selection and retain the source. X post impressions use the collected account-wide snapshot when available; the manual value is a fallback. Event-level exports remain in each event editor and are not automatically added together.</p>{{range .Platforms}}<h3>{{.Name}}</h3><div class="editor-grid">{{range .Metrics}}<label>{{.Label}}<input type="number" min="0" max="1000000000000" name="{{.Key}}" value="{{.Value}}" placeholder="Not supplied"></label>{{end}}<label>Source / account / export<input name="reach_{{.Key}}_source" value="{{.Source}}" maxlength="12000"></label><label>Reporting period<input name="reach_{{.Key}}_period" value="{{.Period}}" maxlength="12000"></label><label>Export date<input type="date" name="reach_{{.Key}}_date" value="{{.Date}}"></label><label>Content included / coverage<input name="reach_{{.Key}}_coverage" value="{{.Coverage}}" maxlength="12000"></label></div>{{end}}</fieldset>
<button name="action" value="save" {{if .Preview}}disabled{{end}}>Save annual draft</button> <button name="action" value="freeze" {{if .Preview}}disabled{{end}}>Save &amp; freeze edition</button>
</form>{{if .Editions}}<h3>Previously frozen editions</h3><ul>{{range .Editions}}<li><a href="{{.URL}}">{{.Date}}</a></li>{{end}}</ul>{{end}}</details>{{end}}
<main><div class="paper-edition annual-brief annual-impact">
<section class="paper-sheet impact-cover" aria-label="Annual report cover">
<header class="impact-cover-masthead"><span>bitcoin++</span><span>ANNUAL PARTNER REVIEW</span></header>
<p class="impact-cover-year">{{.Year}}</p>
<h1>A year of<br><em>building Bitcoin.</em></h1>
<div class="impact-cover-events">{{range .CoverEvents}}<figure>{{if .Event.LeadImage}}<img src="{{.Event.LeadImage}}" alt="{{.Event.Location}} event landing artwork">{{end}}<figcaption><strong>{{.Event.Location}}</strong>{{if .Status}}<span>{{.Status}}</span>{{end}}</figcaption></figure>{{end}}</div>
<div class="impact-cover-recipient"><span>PREPARED FOR</span>{{if .RecipientLogo}}<img class="annual-recipient-logo" src="{{.RecipientLogo}}" alt="{{.Recipient}}">{{else}}<strong>{{.Recipient}}</strong>{{end}}</div>
{{template "annual_footer" $.Year}}
</section>

<section class="paper-sheet brief-opening">
<header class="paper-running"><span>bitcoin++ / {{.Year}}</span><span>Prepared for {{.Recipient}} · {{.ReportFolio 2}}</span></header>
<h1>A note<br><em>from nifty.</em></h1>
{{with .GatheringComparison}}{{template "annual_year_comparison" .}}{{end}}
<div class="annual-letter" data-section="note"><div class="story-text report-markdown">{{(.BriefSection "note").Markdown}}</div></div>
{{template "annual_footer" $.Year}}
</section>

{{range .EventHighlightPages}}<section class="paper-sheet annual-event-recaps" aria-label="Event highlights">
<div class="paper-running"><span></span><span>{{.Folio}}</span></div>
<div class="annual-recap-list">{{range .Highlights}}<article class="annual-event-recap">
<div class="annual-recap-visuals">{{if .Event.LeadImage}}<img src="{{.Event.LeadImage}}" alt="{{.Event.Location}} event artwork">{{end}}{{with .Speakers}}<div class="annual-recap-people" aria-label="Selected event speakers">{{range .}}<figure><img src="{{.Photo}}" alt="Portrait of {{.Name}}"><figcaption>{{.Name}}</figcaption></figure>{{end}}</div>{{end}}</div>
<header class="annual-recap-heading"><div><h2>{{.Event.Location}}</h2><p class="annual-recap-edition">{{.Edition}}</p><p class="annual-recap-date">{{.Event.Period}}</p></div>{{with .Globe}}<figure class="annual-recap-globe"><img src="{{.Image}}" width="320" height="320" alt="Globe highlighting {{.Country}}, with the event city marked"><figcaption>{{.Country}}</figcaption></figure>{{end}}</header>
<div class="annual-recap-copy">
{{if .Stats}}<dl class="annual-recap-stats" aria-label="Event statistics">{{range .Stats}}<div class="annual-recap-stat annual-recap-stat--{{.Kind}}{{if .Compact}} annual-recap-stat--compact{{end}}" title="{{.Detail}}"><dd>{{.Value}}</dd><dt>{{.Label}}</dt></div>{{end}}</dl>{{end}}
<div data-section="{{.Copy.Key}}"><div class="story-text report-markdown">{{.Copy.Markdown}}</div></div><a class="annual-recap-link" href="{{.FeatureURL}}">{{.Feature}} ↗</a></div>
</article>{{end}}</div>{{template "annual_footer" $.Year}}</section>{{end}}

<section class="paper-sheet impact-community">
<div class="paper-running"><span></span><span>{{.ReportFolio 3}}</span></div>
<h2>Many gatherings.<br><em>A shared direction.</em></h2>
<div class="annual-community-growth">{{if .ShowParticipation}}{{with .RegistrationGrowth}}{{template "annual_growth_chart" .}}{{else}}<div class="annual-stat-card"><strong>{{.ParticipationTotal}}</strong><span>{{if .RegistrationBased}}registrations{{else}}event attendances{{end}}</span></div>{{end}}{{end}}<div class="annual-community-stats">{{with .UniqueSpeakers}}<div class="annual-stat-card" title="Program speakers across included events, counting each person once"><strong>{{.}}</strong><span>total speakers</span></div>{{end}}{{with .RepeatParticipation}}<div class="annual-repeat"><strong>{{.Value}}</strong><span>{{.Label}}</span></div>{{end}}</div></div>
{{with .CommunityPeople}}<div class="annual-people-gallery" aria-label="Speakers and hackathon builders">{{range .}}<figure><img src="{{.Person.Photo}}" alt="Portrait of {{.Person.Name}}"><figcaption><strong>{{.Person.Name}}</strong><span>{{.Role}}</span><span>{{.Event}}</span></figcaption></figure>{{end}}</div>{{else}}<svg viewBox="0 0 720 350" class="annual-globe" role="img" aria-label="Included event locations"><image href="/static/img/report-globes.svg" width="720" height="350"/>{{range .MapPoints}}<circle cx="{{.X}}" cy="{{.Y}}" r="7" fill="#f7b500" stroke="#513762" stroke-width="2"><title>{{.Name}}</title></circle>{{end}}</svg>{{end}}
<div class="impact-places"><strong>{{len .Included}} gatherings</strong>{{range .Included}}<a href="https://btcpp.dev/{{.Event.Tag}}"><span aria-hidden="true">{{.BadgeEmoji}}</span>&nbsp;{{.Event.Location}} ↗</a>{{end}}</div>
{{with .BriefSection "community"}}{{if .Text}}<div class="annual-section-copy" data-section="community"><div class="story-text report-markdown">{{.Markdown}}</div></div>{{end}}{{end}}
{{template "annual_participant_quote" (.ParticipantQuote "community_quote")}}
{{template "annual_footer" $.Year}}
</section>

<section class="paper-sheet impact-program">
<div class="paper-running"><span></span><span>{{.ReportFolio 4}}</span></div>
<h2>Technical depth.<br><em>Different perspectives.</em></h2>
<div class="impact-program-grid"><div class="impact-program-donut">{{template "annual_donut" .ProgramChart}}</div><div class="annual-program-totals">{{with .UniqueSpeakers}}<div class="annual-program-counter"><strong>{{.}}</strong><span>speakers</span></div>{{end}}{{with .StageDemand}}<div class="annual-program-counter"><strong>{{.Display}}</strong><span>{{.Label}}</span></div>{{end}}</div></div>
<h3 class="annual-chart-heading">Sessions by gathering</h3><div class="impact-program-bars">{{range .ProgramRows}}{{if gt .Count 0}}<div class="annual-bar-row"><div><span>{{.Name}}</span><strong>{{.Count}}</strong></div><div class="annual-stack"><i style="width:{{.TalkWidth}}%;background:#c8b3f5"></i><i style="width:{{.WorkshopWidth}}%;background:#f7b500"></i><i style="width:{{.PanelWidth}}%;background:#f6b9dc"></i></div></div>{{end}}{{end}}</div>
{{with .BriefSection "program"}}{{if .Text}}<div class="annual-section-copy" data-section="program"><div class="story-text report-markdown">{{.Markdown}}</div></div>{{end}}{{end}}
{{template "annual_footer" $.Year}}
</section>

<section class="paper-sheet impact-reach">
<div class="paper-running"><span></span><span>{{.ReportFolio 5}}</span></div>
<h2>The event ends.<br><em>The ideas keep moving.</em></h2>
<div class="impact-reach-heroes">{{range .MediaTotals}}<article><strong>{{.Display}}</strong><span>{{.Platform}} recording views</span></article>{{end}}
{{range .HeadlinePlatforms}}{{$platform := .}}{{range .HeadlineMetrics}}<article><strong>{{.Display}}</strong><span>{{$platform.Name}} {{.Label}}</span></article>{{end}}{{end}}</div>
<div class="brief-recordings">{{range .BriefMedia}}{{$recording := .}}<article><a href="{{.URL}}"><div class="annual-recording-cover">{{if .ImageURL}}<img src="{{.ImageURL}}" alt="{{.Title}} recording thumbnail">{{else}}{{range $.Included}}{{if and (eq .Event.Location $recording.Event) .Event.LeadImage}}<img src="{{.Event.LeadImage}}" alt="{{.Event.Location}} event artwork">{{end}}{{end}}{{end}}<span aria-hidden="true">▶</span></div><h3>{{.Title}}</h3></a><p class="report-card-detail">{{.Event}} · {{.Platform}}</p><div class="annual-card-links"><a href="{{.URL}}">Watch ↗</a>{{if .MomentURL}}<a href="{{.MomentURL}}">Selected moment ↗</a>{{end}}</div></article>{{end}}</div>
{{with .BriefSection "reach"}}{{if .Text}}<div class="annual-section-copy" data-section="reach"><div class="story-text report-markdown">{{.Markdown}}</div></div>{{end}}{{end}}
{{template "annual_participant_quote" (.ParticipantQuote "reach_quote")}}
{{template "annual_footer" $.Year}}
</section>

<section class="paper-sheet impact-funding" id="annual-hackathons">
<div class="paper-running"><span></span><span>{{.ReportFolio 6}}</span></div>
<h2>Support that reaches<br><em>the builders.</em></h2>
<div class="annual-funding-overview">{{with .PrizeGrowth}}{{template "annual_growth_chart" .}}{{else}}{{with .FundingChart}}{{if .Rows}}<div class="impact-funding-chart">{{template "annual_funding_donut" $}}</div>{{end}}{{end}}{{end}}
<div class="annual-building-growth">{{range .BuildingGrowth}}{{template "annual_growth_chart" .}}{{end}}</div>
</div><div class="annual-funding-events">{{range .Included}}{{if and .HackKnown (or (gt .Sats 0) .HackathonRetrospective)}}<article>{{if .Event.LeadImage}}<img src="{{.Event.LeadImage}}" alt="{{.Event.Location}} event artwork">{{end}}<div><h3>{{.Event.Location}}</h3>{{if gt .Sats 0}}<p class="annual-funding-award"><strong>{{.SatsDisplay}}</strong> {{if and (eq $.Recipient "NYDIG") .OfferedBased}}in prizes{{else}}{{.PrizeUnit}}{{end}}</p>{{else if .HackathonRetrospective}}<p class="annual-funding-award"><strong>{{.HackathonRetrospective.Bugs}}</strong> bugs found</p>{{end}}<div class="annual-funding-card-footer"><div><p class="annual-funding-projects"><strong>{{.Projects}}</strong> projects</p>{{if .HackathonRetrospective}}<p class="annual-funding-retrospective">{{.ParticipantsDisplay}} participants · {{.HackathonRetrospective.Hours}} hours</p>{{end}}<a href="{{.HackathonURL}}">{{if .HackathonRetrospective}}Recap{{else}}Explore{{end}} ↗</a></div>{{with .Globe}}<figure class="annual-funding-globe"><img src="{{.Image}}" width="320" height="320" alt="Globe highlighting {{.Country}}, with the event city marked"></figure>{{end}}</div></div></article>{{end}}{{end}}</div>
{{with .BriefSection "support"}}{{if .Text}}<div class="annual-support-detail" data-section="support"><div class="story-text report-markdown">{{.Markdown}}</div></div>{{end}}{{end}}
{{with .BriefSection "building"}}{{if .Text}}<div class="annual-funding-intro annual-section-copy" data-section="building"><div class="story-text report-markdown">{{.Markdown}}</div></div>{{end}}{{end}}
{{with .BriefSection "resource_use"}}{{if .Text}}<div class="annual-resource-use"><h3>How support was used</h3><div data-section="resource_use"><div class="story-text report-markdown">{{.Markdown}}</div></div></div>{{end}}{{end}}
{{template "annual_footer" $.Year}}
</section>

{{range .ProjectHighlightPages}}<section class="paper-sheet impact-winners">
<div class="paper-running"><span></span><span>{{.Folio}}</span></div>
<h2>First place.<br><em>Meet the builders.</em></h2>
<div class="impact-winner-gallery{{if gt (len .Projects) 3}} impact-winner-gallery--grid{{end}}">{{range .Projects}}<article>
<div class="annual-winner-event"><strong>{{.Event}}</strong><span>{{.Project.PlaceLabel}}</span></div>
<div class="impact-winner-visuals">{{template "report_winner_team" .Project}}{{if .Project.Image}}<figure><img src="{{.Project.Image}}" alt="{{.Project.Title}} project artwork"></figure>{{else if and .Project.SourceURL .EventImage}}<figure class="annual-winner-event-art"><img src="{{.EventImage}}" alt="{{.Event}} event artwork"></figure>{{end}}</div><div class="annual-winner-copy"><h3>{{.Project.Title}}</h3>{{with .Project.PrizeFigure}}<p class="report-prize-amount"><strong>{{.Value}}</strong> {{.Label}}</p>{{end}}{{with .Story.Built}}<p class="annual-project-story">{{.}}</p>{{end}}<div class="annual-card-links"><a href="{{.URL}}">{{.LinkLabel}} ↗</a>{{if .Project.GitHub}}<a href="{{.Project.GitHub}}">Code ↗</a>{{end}}</div></div></article>{{else}}<p>First-place projects will appear as overall hackathon results are finalized.</p>{{end}}</div>
{{template "annual_footer" $.Year}}
</section>{{end}}

{{if .HasFollowUp}}<section class="paper-sheet annual-follow-up">
<div class="paper-running"><span></span><span>{{.FollowUpFolio}}</span></div>
<h2>Building on<br><em>this year.</em></h2>
{{$lessons := .BriefSection "lessons"}}{{$next := .BriefSection "next"}}
{{if $lessons.Text}}<h3>What we learned</h3><div class="annual-follow-up-copy" data-section="lessons"><div class="story-text report-markdown">{{$lessons.Markdown}}</div></div>{{end}}
{{if $next.Text}}<h3>What's next</h3><div class="annual-follow-up-copy" data-section="next"><div class="story-text report-markdown">{{$next.Markdown}}</div></div>{{end}}
{{template "annual_footer" $.Year}}
</section>{{end}}

<section class="paper-sheet brief-closing" id="annual-closing">
<div class="paper-running"><span></span><span>{{.ReportFolio 8}}</span></div>
<h2 class="annual-closing-title">Thank you,<br><em>{{.Recipient}}.</em></h2>
<p class="annual-closing-deck">For backing the people building Bitcoin.</p>
{{if .Forthcoming}}<div class="annual-forthcoming">{{range .UpcomingHighlights}}<article>{{if .Event.LeadImage}}<img src="{{.Event.LeadImage}}" alt="{{.Event.Location}} event landing artwork">{{end}}<div><h3>{{.Event.Location}}</h3><p class="report-card-detail">{{.Status}} · {{.Event.Period}}</p><p>{{.Event.Title}}</p><a href="https://btcpp.dev/{{.Event.Tag}}">Explore the event ↗</a></div></article>{{end}}</div>{{else}}<div class="impact-opening-art closing-art" aria-hidden="true"><i></i><i></i><i></i></div>{{end}}
{{template "annual_participant_quote" (.ParticipantQuote "closing_quote")}}
{{template "annual_footer" $.Year}}
</section>
</div></main></body></html>
{{define "annual_year_comparison"}}<section class="annual-year-comparison" aria-label="Completed gatherings through {{.Through}} in each year" title="Completed gatherings through {{.Through}} in each year"><h3>Gatherings, year over year.</h3><div class="annual-year-bars"><div><span>{{.PreviousYear}}</span><i style="width:{{.PreviousWidth}}%"></i><strong>{{.Previous}}</strong></div><div><span>{{.Year}}</span><i style="width:{{.CurrentWidth}}%"></i><strong>{{.Current}}</strong></div></div></section>{{end}}
{{define "annual_footer"}}<footer class="paper-folio"><span>bitcoin++ / {{.}}</span><span>the cutting edge of bitcoin technology</span></footer>{{end}}
{{define "annual_participant_quote"}}{{if .Text}}<figure class="annual-testimonial{{if .Author}} annual-testimonial--attributed{{end}}"><blockquote class="annual-participant-quote" data-section="{{.Key}}"><div class="story-text report-markdown">{{.Markdown}}</div></blockquote>{{with .Author}}<figcaption class="annual-quote-author">{{if .Photo}}<img src="{{.Photo}}" alt="Portrait of {{.Name}}" width="72" height="72">{{end}}<div><strong>{{.Name}}{{with .Alias}} <span>({{.}})</span>{{end}}</strong>{{with .Company}}<span class="annual-quote-company">{{.}}</span>{{end}}{{if .Twitter.Handle}}<a href="{{.Twitter.Link}}">{{.Twitter.Mention}}</a>{{end}}</div></figcaption>{{end}}</figure>{{end}}{{end}}
{{define "annual_growth_chart"}}<figure class="annual-growth annual-growth--{{.Kind}}"><figcaption><strong>{{.Display}}</strong><span>{{.Label}}</span></figcaption>{{if .Points}}<svg viewBox="0 0 480 198" role="img" aria-label="Cumulative {{.Unit}} at completed events in {{.Year}}"><title>{{range .Points}}{{.Date}} · {{.Event}}: {{.Display}} {{$.Unit}}. {{end}}</title><path class="annual-growth-grid" d="M40 20H440 M40 92H440 M40 164H440"/><polygon class="annual-growth-area" points="{{.Area}}"/><polyline class="annual-growth-line" points="{{.Line}}"/>{{range .Points}}<circle class="annual-growth-point" cx="{{.X}}" cy="{{.Y}}" r="4"><title>{{.Event}} · {{.Date}} · {{.Display}} {{$.Unit}} cumulative</title></circle>{{end}}<text class="annual-growth-axis" x="28" y="168" text-anchor="end">0</text>{{range .Ticks}}<text class="annual-growth-axis" x="{{.X}}" y="191" text-anchor="middle">{{.Label}}</text>{{end}}</svg>{{end}}</figure>{{end}}
{{define "annual_funding_donut"}}{{with .FundingChart}}<svg viewBox="0 0 160 160" role="img" aria-label="{{$.PrizeTotalDisplay}} {{.Unit}}; event breakdown below"><circle cx="80" cy="80" r="60" fill="none" stroke="#e1dae6" stroke-width="18"/>{{range .Donut}}<circle cx="80" cy="80" r="60" fill="none" stroke="{{.Color}}" stroke-width="18" pathLength="100" stroke-dasharray="{{.Percent}} 100" stroke-dashoffset="{{.Offset}}" transform="rotate(-90 80 80)"/>{{end}}<text x="80" y="80" text-anchor="middle" class="funding-total">{{$.PrizeTotalDisplay}}</text><text x="80" y="94" text-anchor="middle" class="funding-unit">{{if and (eq $.Recipient "NYDIG") $.OfferedBased}}in prizes{{else}}{{.Unit}}{{end}}</text></svg>{{end}}{{end}}
{{define "annual_bars"}}<div class="annual-bars">{{range .Rows}}<div class="annual-bar-row"><div><span>{{.Label}}</span><strong>{{.Value}}</strong></div><div class="annual-bar-track"><i style="width:{{.Width}}%"></i></div></div>{{else}}<p>No reviewed event data in this selection.</p>{{end}}</div>{{end}}
{{define "annual_donut"}}{{if .Donut}}<svg class="annual-donut" viewBox="0 0 120 120" role="img" aria-label="Distribution; values listed below"><circle cx="60" cy="60" r="44" fill="none" stroke="#e1dae6" stroke-width="15"/>{{range .Donut}}<circle cx="60" cy="60" r="44" fill="none" stroke="{{.Color}}" stroke-width="15" pathLength="100" stroke-dasharray="{{.Percent}} 100" stroke-dashoffset="{{.Offset}}" transform="rotate(-90 60 60)"/>{{end}}<text x="60" y="65" text-anchor="middle">{{.DonutTotal}}</text></svg><ul class="annual-legend">{{range .Donut}}<li><i style="background:{{.Color}}"></i><span>{{.Label}}</span><strong>{{.Value}}</strong></li>{{end}}</ul>{{else}}<p>No recorded entries in this selection.</p>{{end}}{{end}}
