<!doctype html><html lang="en"><head><title>Site visibility · bitcoin++</title>{{ block "header" . }}{{ end }}</head>
<body class="btcpp-profile-edit-page account-settings-page"><main class="profile-edit-shell person-emails-page">
<p><a href="/admin">← Administration</a></p><h1>Site visibility</h1>
{{ if .Saved }}<p role="status">Visibility saved.</p>{{ end }}
<form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}">
