<!doctype html>
<html lang="en">
<head>
  <title>{{ if .Admin }}Temporary password{{ else }}Choose your password{{ end }} · bitcoin++</title>
  {{ template "header" . }}
  <link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-account-flows">
</head>
<body class="btcpp-login-page account-flow">
  {{ template "mainnav" . }}
  <main class="auth-shell auth-shell--simple">
    <section class="auth-card">

  <header class="auth-card__head"><h1>{{ if .Admin }}Issue a temporary password{{ else }}Choose your own password{{ end }}</h1></header>
  {{ if .Error }}<p role="alert" class="auth-alert auth-alert--error">{{ .Error }}</p>{{ end }}
  {{ if .Password }}<p class="auth-alert auth-alert--success" role="status">Temporary password created for <strong>{{ .Email }}</strong></p>{{ else if .Message }}<p class="auth-alert auth-alert--success" role="status">{{ .Message }}</p>{{ end }}
  {{ if .Password }}
    <label class="auth-secret">Temporary password (shown only on this page)<input readonly value="{{ .Password }}" autocomplete="off" onclick="this.select()"></label>
    <div class="auth-form auth-form__actions"><a href="/admin/people">Back to people →</a></div>
  {{ else }}
    <form class="auth-form" method="post" action="{{ if .Admin }}/admin/people/temporary-password{{ else }}/change-temporary-password{{ end }}">
      <input type="hidden" name="csrf" value="{{ .CSRF }}">
      {{ if .Admin }}
      <p>Replaces the existing password and signs out existing sessions. Expires in 72 hours.</p>
      <label>Account email<input name="email" type="email" required value="{{ .Email }}"></label>
      <label>Temporary password (optional)<input name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password"></label>
      {{ else }}
      <p>You signed in with a temporary password. Choose a different password of at least 12 characters to continue.</p>
      <label>New password<input name="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password"></label>
      <label>Confirm password<input name="password_confirm" type="password" required minlength="12" maxlength="128" autocomplete="new-password"></label>
      {{ end }}
      <button class="auth-primary" type="submit">{{ if .Admin }}Issue temporary password{{ else }}Save password and continue{{ end }}</button>
    </form>
  {{ end }}

    </section>
  </main>
  {{ template "footer" . }}
</body>
</html>
