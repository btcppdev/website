<!DOCTYPE html>
<html lang="en">
<head><title>{{ if .Admin }}Temporary password{{ else }}Choose your password{{ end }} · bitcoin++</title>{{ block "header" . }}{{ end }}</head>
<body class="btcpp-admin-page">
{{ block "mainnav" . }}{{ end }}
<main class="mx-auto max-w-xl px-4 py-12">
  <h1 class="text-2xl font-bold">{{ if .Admin }}Issue a temporary password{{ else }}Choose your own password{{ end }}</h1>
  {{ if .Error }}<p role="alert" class="my-4 rounded border border-red-300 bg-red-50 p-3 text-red-800">{{ .Error }}</p>{{ end }}
  {{ if .Message }}<p class="my-4">{{ .Message }}</p>{{ end }}
  {{ if .Password }}
    <p class="mt-4 font-semibold">Account: {{ .Email }}</p>
    <label class="mt-4 block">Temporary password (shown only on this page)<input readonly value="{{ .Password }}" autocomplete="off" class="mt-2 block w-full rounded border p-3 font-mono" onclick="this.select()"></label>
    <p class="mt-4">Ask them to sign in at <a class="underline" href="/login">/login</a> using their email and this password.</p>
    <a class="mt-6 inline-block underline" href="/admin/people">Back to people</a>
  {{ else }}
    <form method="post" action="{{ if .Admin }}/admin/people/temporary-password{{ else }}/change-temporary-password{{ end }}" class="mt-6 space-y-4">
      <input type="hidden" name="csrf" value="{{ .CSRF }}">
      {{ if .Admin }}
      <p class="text-sm text-gray-600">Replaces the existing password and signs out existing sessions. Expires in 72 hours. The person must choose their own password before accessing their account. Requires a sign-in within the last 15 minutes.</p>
      <label class="block">Account email<input name="email" type="email" required value="{{ .Email }}" class="mt-1 block w-full rounded border p-2"></label>
      <label class="block">Temporary password (optional)<input name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" class="mt-1 block w-full rounded border p-2"></label>
      <p class="text-sm text-gray-600">Leave blank to generate a strong password. You can copy it after saving and share it directly.</p>
      {{ else }}
      <p>You signed in with a temporary password. Choose a different password of at least 12 characters to continue.</p>
      <label class="block">New password<input name="password" type="password" required minlength="12" maxlength="128" autocomplete="new-password" class="mt-1 block w-full rounded border p-2"></label>
      <label class="block">Confirm password<input name="password_confirm" type="password" required minlength="12" maxlength="128" autocomplete="new-password" class="mt-1 block w-full rounded border p-2"></label>
      {{ end }}
      <button class="rounded bg-indigo-600 px-4 py-2 font-semibold text-white" type="submit">{{ if .Admin }}Issue temporary password{{ else }}Save password and continue{{ end }}</button>
    </form>
  {{ end }}
</main>
</body>
</html>
