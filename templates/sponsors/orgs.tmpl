<!DOCTYPE html>
<html>
  <head>
    <title>orgs @ bitcoin++</title>
    {{ block "header" . }} {{ end }}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>&#127970;</text></svg>">
  </head>
  <body class="btcpp-admin-page">
    {{ block "mainnav" . }} {{ end }}
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-5xl">
            <section id="topline" class="mb-6">
                <div class="overflow-hidden sm:rounded-lg bg-white shadow">
                    <div class="px-4 py-5 sm:p-6 flex items-center justify-between">
                        <h1 class="text-xl font-bold text-gray-900">Organizations</h1>
                        <a href="/admin/orgs/new" class="px-3 py-1.5 text-sm rounded-md text-white bg-indigo-600 hover:bg-indigo-700">Add Org</a>
                    </div>
                </div>
            </section>

            {{ if .FlashMessage }}
            <section class="mb-6">
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg">
                    {{ .FlashMessage }}
                </div>
            </section>
            {{ end }}

            {{ if .FlashError }}
            <section class="mb-6" role="alert">
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg">{{ .FlashError }}</div>
            </section>
            {{ end }}

            <section class="mb-6" id="applications">
                <div class="overflow-hidden rounded-lg bg-white shadow">
                    <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
                        <div><h2 class="text-sm font-semibold text-gray-900">Pending organization applications</h2><p class="mt-1 text-xs text-gray-500">Review attendee proposals before they become organizations.</p></div>
                        <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800">{{ len .PendingApplications }} pending</span>
                    </div>
                    {{ if .PendingApplications }}<ul class="divide-y divide-gray-200">{{ range .PendingApplications }}
                        <li class="flex items-center justify-between gap-4 px-6 py-4"><div><strong class="text-sm text-gray-900">{{ .Name }}</strong><p class="text-xs text-gray-500">Submitted by {{ .ApplicantName }} · {{ .ApplicantEmail }}</p></div><a href="/admin/org-applications/{{ .ID }}" class="text-sm font-semibold text-indigo-600 hover:text-indigo-900">Review →</a></li>
                    {{ end }}</ul>{{ else }}<p class="px-6 py-5 text-sm text-gray-500">No applications are waiting for review.</p>{{ end }}
                </div>
            </section>

            {{ if .Orgs }}
            <section class="mb-6">
                <div class="bg-white shadow rounded-lg overflow-hidden">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Organization</th>
								<th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Directory</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Website</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            {{ range .Orgs }}
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 text-sm">
                                    <a href="/admin/orgs/{{ .Ref }}" class="text-indigo-600 hover:text-indigo-900 font-medium">{{ .Name }}</a>
                                </td>
                                <td class="px-6 py-4 text-sm">
                                    <form method="POST" action="/admin/orgs/{{ .Ref }}/visibility">
                                        {{ if .HiddenFromDirectory }}
                                        <button type="submit" name="DirectoryVisible" value="on" aria-label="Show {{ .Name }} in organization directory" title="Click to show in directory" class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 hover:bg-gray-200">Hidden · Show</button>
                                        {{ else }}
                                        <button type="submit" name="DirectoryVisible" value="off" aria-label="Hide {{ .Name }} from organization directory" title="Click to hide from directory" class="rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700 hover:bg-green-200">Visible · Hide</button>
                                        {{ end }}
                                    </form>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-500">
                                    {{ if .Email }}<a href="mailto:{{ .Email }}" class="text-indigo-600 hover:text-indigo-900">{{ .Email }}</a>{{ else }}<span class="text-gray-400">—</span>{{ end }}
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-500">{{ if .Website }}<a href="{{ .Website }}" class="text-indigo-600 hover:text-indigo-900">{{ .Website }}</a>{{ else }}<span class="text-gray-400">—</span>{{ end }}</td>
                            </tr>
                            {{ end }}
                        </tbody>
                    </table>
                    <div class="px-6 py-3 bg-gray-50 text-sm text-gray-500">
                        {{ len .Orgs }} organizations
                    </div>
                </div>
            </section>
            {{ else }}
            <section class="mb-6">
                <div class="bg-white shadow rounded-lg px-4 py-5 sm:p-6 text-center text-gray-500">
                    No organizations yet. <a href="/admin/orgs/new" class="text-indigo-600 hover:text-indigo-900">Add one</a>.
                </div>
            </section>
            {{ end }}
        </div>
    </div>
  </body>
</html>
