<!DOCTYPE html>
<html lang="en">
<head>
  <title>Alerts checkout · bitcoin++</title>
  {{ block "header" . }}{{ end }}
  <link rel="stylesheet" href="/static/css/shop.css?v=20260718-11">
  <link rel="stylesheet" href="/static/css/service-checkout.css?v=2">
</head>
<body class="shop-page">
{{ block "mainnav" . }}{{ end }}
<main class="service-checkout service-checkout--status">
  <section aria-labelledby="checkout-heading">
    <header class="service-checkout__head">
      <span class="service-kicker">CHECKOUT STATUS</span>
      <h1 id="checkout-heading">{{ .Heading }}</h1>
      <p class="service-status-message" role="status">{{ .Message }}</p>
    </header>
    <div class="service-checkout-actions">
      {{ if .CanPay }}
      <form method="post" action="/services/alerts/checkout/{{ .ID }}">
        <input type="hidden" name="csrf" value="{{ .CSRF }}">
        <button type="submit">Continue with card</button>
      </form>
      {{ end }}
      {{ if .CanCheck }}
      <form method="post" action="/services/alerts/checkout/{{ .ID }}">
        <input type="hidden" name="csrf" value="{{ .CSRF }}">
        <input type="hidden" name="action" value="check">
        <button type="submit"{{ if .CanPay }} class="service-secondary"{{ end }}>Check with Stripe</button>
      </form>
      {{ end }}
      <a href="/services/alerts/checkout/{{ .ID }}">Refresh payment status</a>
    </div>
    {{ if .CanPay }}
    <p class="service-note">Renews annually. Cancel future renewals through billing management; your paid allowance continues until the current period ends. Cancellation does not refund that period.</p>
    {{ end }}
    <div class="service-checkout-reference">
      <span class="service-kicker">Checkout reference</span>
      <code>{{ .ID }}</code>
    </div>
    <p><a href="https://alerts.btcpp.dev/alerts">Return to My alerts</a></p>
  </section>
  <aside class="service-summary" aria-label="Order summary">
    <img src="/static/img/alerts-checkout.svg" alt="" width="640" height="360">
    <div class="service-summary__body">
      <h2><span class="service-wordmark">bitcoin++</span> Alerts</h2>
      <p class="service-note">Software release notifications, delivered by email and Telegram.</p>
      <dl>
        <div><dt>Free projects</dt><dd>3 included</dd></div>
        <div><dt>Additional projects</dt><dd>{{ .Slots }}</dd></div>
        <div><dt>Billing period</dt><dd>Yearly</dd></div>
        <div class="service-total"><dt>Annual total</dt><dd>{{ .Total }}</dd></div>
      </dl>
      <p class="service-note">USD · applicable tax included.</p>
    </div>
  </aside>
</main>
</body>
</html>
