<!doctype html><html lang="en"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:"><title>{{ .Number }}</title>
<style>
@page{size:A4;margin:18mm}
*{box-sizing:border-box}
body{max-width:800px;margin:0 auto;padding:36px 28px;font:13px Arial,Helvetica,sans-serif;line-height:1.55;color:#171717;background:#fff}
.invoice-brand{border-bottom:4px solid #e95742;padding-bottom:24px;margin-bottom:28px}
.invoice-brand img{width:155px;height:auto}
h1{font-size:30px;letter-spacing:-1px;line-height:1.2;margin:0 0 12px}
h2{text-transform:uppercase;letter-spacing:1.5px;font-size:10px;color:#65605a;margin:0 0 12px}
section{margin:28px 0}
.addresses{display:flex;gap:40px;padding:24px;background:#f6f3ee;border:1px solid #e0dad1}
.addresses>div{flex:1;min-width:0;overflow-wrap:anywhere}
.address{white-space:pre-line}
table{width:100%;border-collapse:collapse;table-layout:fixed}
th,td{text-align:left;padding:14px 10px;border-bottom:1px solid #ded8cf;overflow-wrap:anywhere}
thead th{font-size:10px;text-transform:uppercase;letter-spacing:1px;background:#f6f3ee}
th:first-child,td:first-child{padding-left:0;width:55%}
th:last-child,td:last-child{text-align:right;padding-right:0}
tr{break-inside:avoid}
.totals{width:58%;margin:28px 0 28px auto}
.totals th{font-weight:normal}
.totals tr:last-child{border-top:2px solid #171717;font-size:17px;font-weight:bold}
.totals tr:last-child th{font-weight:bold}
.note{font-size:10px;color:#65605a;line-height:1.7;border-top:1px solid #ded8cf;padding-top:20px}
@media(max-width:500px){body{padding:24px 16px}.addresses{display:block;padding:20px}.addresses>div+div{margin-top:24px}.totals{width:100%}h1{font-size:24px}}
@media print{body{padding:0;max-width:none}.addresses{break-inside:avoid}.invoice-brand{break-after:avoid}}
</style></head><body><div class="invoice-brand"><img alt="bitcoin++" src="data:image/png;base64,"></div>
<h1>Invoice {{ .Number }}</h1>
<p>Issued: {{ .IssuedAt.UTC.Format "January 2, 2006" }} · Order date: {{ .Snapshot.PurchasedAt.UTC.Format "January 2, 2006" }}<br>Order reference: {{ .Snapshot.OrderReference }}</p>
<section class="addresses"><div><h2>Seller</h2><strong>{{ .Snapshot.SellerName }}</strong><p class="address">{{ .Snapshot.SellerAddress }}</p><p>EIN: {{ .Snapshot.SellerEIN }}</p></div><div><h2>Bill to</h2><strong>{{ .Snapshot.Buyer.Name }}</strong><p class="address">{{ .Snapshot.Buyer.Address }}
{{ .Snapshot.Buyer.City }} {{ .Snapshot.Buyer.Region }} {{ .Snapshot.Buyer.PostalCode }}
{{ .Snapshot.Buyer.Country }}</p>{{ if .Snapshot.Buyer.TaxID }}<p>Buyer tax ID: {{ .Snapshot.Buyer.TaxID }}</p>{{ end }}</div></section>
<p>Currency: {{ .Snapshot.Currency }} · Payment provider: {{ .Snapshot.PaymentMethod }}</p>
<table><thead><tr><th>Description</th><th>Quantity</th><th>Line amount before tax</th></tr></thead><tbody>{{ range .Snapshot.Items }}<tr><td>{{ .Name }}</td><td>{{ .Quantity }}</td><td>{{ .Money }}</td></tr>{{ end }}</tbody></table>
<table class="totals">{{ range .Snapshot.Totals }}<tr><th>{{ .Label }}</th><td>{{ .Amount }}</td></tr>{{ end }}</table>
<p class="note">Amounts and taxes reflect the original purchase records. This invoice does not request a new payment. Refunds and credit notes are separate adjustments; check your account for the current payment status. Contact inbox@btcpp.dev for billing corrections.</p>
</body></html>
