<!DOCTYPE html>
<html>
<head>
  <title>Choose a new password · bitcoin++</title>
  {{ block "header" . }} {{ end }}
</head>
<body class="btcpp-admin-page h-full">
  {{ block "mainnav" . }} {{ end }}
  <main class="profile-edit-shell">
    <header class="profile-edit-hero">
      <p class="profile-edit-tag">§ ACCOUNT RECOVERY</p>
      <h1>Choose a new <span>password.</span></h1>
    </header>
    {{ if .FlashError }}<div class="profile-edit-flash person-emails-error">{{ .FlashError }}</div>{{ end }}
    {{ if .TokenValid }}
    <section class="profile-edit-section is-open">
      <div class="profile-edit-section__index">*</div>
      <div class="profile-edit-section__body">
        <form method="POST" action="/reset-password" class="person-email-add person-password-form">
          <input type="hidden" name="csrf" value="{{ .CSRF }}">
          <input type="hidden" name="token" value="{{ .Token }}">
          <label>NEW PASSWORD <input type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password"></label>
          <label>CONFIRM PASSWORD <input type="password" name="password_confirm" required minlength="12" maxlength="128" autocomplete="new-password"></label>
          <button type="submit">Save password</button>
        </form>
      </div>
    </section>
    {{ else }}
    <div class="profile-edit-flash person-emails-error">That reset link is invalid, expired, or already used.</div>
    <p><a href="/forgot-password">Request another reset link</a></p>
    {{ end }}
  </main>
  {{ block "footer" . }} {{ end }}
</body>
</html>
