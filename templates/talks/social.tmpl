<!DOCTYPE html>
<html>
<head>
  <title>social posts @ bitcoin++</title>
  {{ block "header" . }} {{ end }}
  {{ template "admin_favicon" .Conf }}
  <link rel="stylesheet" href="/static/css/social-admin.css?v=1">
</head>
<body class="btcpp-admin-page social-admin-page">
  {{ block "mainnav" . }} {{ end }}
  <main class="social-admin-shell">
    <a class="social-back" href="/{{ .Conf.Tag }}/admin">← {{ .Conf.Desc }} dashboard</a>
    <header class="social-page-heading"><div><p class="social-eyebrow">{{ .Conf.Tag }} / publishing</p><h1>Social posts</h1><p>{{ .Conf.Desc }} · {{ .Conf.DateDesc }}</p></div><span class="social-channels">X · Instagram · LinkedIn</span></header>
    {{ if .FlashMessage }}<div class="social-notice" role="status">{{ .FlashMessage }}</div>{{ end }}
    {{ if .FlashError }}<div class="social-notice social-notice-error" role="alert">{{ .FlashError }}</div>{{ end }}
    {{ if not .BufferOK }}<div class="social-notice">Buffer is not configured.</div>{{ else }}
    <form method="POST" action="/{{ .Conf.Tag }}/admin/social/post" data-social-form data-media-upload-url="/{{ .Conf.Tag }}/admin/social/media">
      <p class="social-instructions">Review the media in posting order. Move attachments left or right, remove any, or add files. New files start first; you can move them afterward. A video must be the only attachment in its post.</p>
      <noscript><p>Enable JavaScript to edit media. Otherwise, the original attachments shown below will be used.</p></noscript>
<section class="social-post-section" id="speakers">
    <header class="social-section-heading"><h2>Speakers <span>{{ len .SpeakerRows }}</span></h2>
    {{ if .SpeakerRows }}<label class="social-select-all"><input type="checkbox" onclick="toggleAll(this, 'speaker')"> Select all</label>{{ end }}</header>
    {{ range .SpeakerRows }}
    <article class="social-post" data-social-row>
      <header class="social-post-heading"><div class="social-post-select">
                                    <input type="checkbox" name="selected_speaker" value="{{ .ID }}" data-selection-group="speaker" class="rounded border-gray-300">
                                    <input type="hidden" name="talkid_speaker{{ .ID }}" value="{{ .TalkID }}" class="rounded border-gray-300">
                                    <input type="hidden" name="speakerphoto_speaker_{{ .ID }}" value="{{ .SpeakerPhotoURL }}">
                                    <input type="hidden" name="photo_speaker_{{ .ID }}" value="{{ .PhotoURL }}">
                                    <input type="hidden" name="instaphoto_speaker_{{ .ID }}" value="{{ .InstaPhotoURL }}">
                                </div><div class="social-post-name">
                                    {{ .Name }}
                                    {{ if .TwitterHandle }}<div class="text-xs text-gray-400">@{{ .TwitterHandle }}</div>{{ end }}
                                </div></header>
      <div class="social-post-body"><div class="social-post-media"><h3>Media <span>Left to right = posting order</span></h3>
                                    <div data-social-media data-media-field="speaker_{{ .ID }}">
                                        <ol data-media-list aria-label="Post media in order" class="flex items-start gap-3 overflow-x-auto max-w-sm">{{ if or .PhotoURL .InstaPhotoURL }}<li data-media-item data-source="card" class="mb-3 shrink-0 rounded border border-gray-200 p-2">
                                            <strong class="block text-xs" data-media-label>Social card</strong>
                                            {{ if .InstaPhotoURL }}<figure><img src="{{ .InstaPhotoURL | safeURL }}" alt="Social card for X and Instagram" loading="lazy" class="w-32 rounded"><figcaption class="text-xs text-gray-500">X / Instagram</figcaption></figure>{{ end }}
                                            {{ if .PhotoURL }}<figure><img src="{{ .PhotoURL | safeURL }}" alt="Social card for LinkedIn" loading="lazy" class="w-32 rounded"><figcaption class="text-xs text-gray-500">{{ if .InstaPhotoURL }}LinkedIn{{ else }}All channels{{ end }}</figcaption></figure>{{ end }}
                                        </li>{{ end }}
                                        {{ if .SpeakerPhotoURL }}<li data-media-item data-source="photo" class="mb-3 shrink-0 rounded border border-gray-200 p-2"><strong class="block text-xs" data-media-label>Speaker photo</strong><img src="{{ .SpeakerPhotoURL | safeURL }}" alt="{{ .Name }} speaker photo" loading="lazy" class="w-32 rounded"></li>{{ end }}</ol>
                                        <input type="hidden" name="media_items_speaker_{{ .ID }}" data-media-items>
                                        <p data-media-validation role="status" class="text-xs text-red-700"></p>
                                        <label class="block text-sm font-medium text-gray-700">Add media
                                            <input type="file" multiple accept="video/mp4,video/quicktime,image/jpeg,image/png,.mp4,.mov" data-media-file class="mt-1 block w-full text-sm">
                                        </label>
                                        <p class="mt-1 text-xs text-gray-600" data-media-status role="status"></p>
                                    </div>
                                </div>
      <div class="social-post-copy"><h3>Post text</h3>
                                    <textarea name="text_speaker_{{ .ID }}" rows="7" class="w-full rounded border border-gray-300 px-3 py-2 text-sm font-mono">{{ .PostText }}</textarea>

                                </div></div>
    </article>
    {{ else }}<p class="social-empty">No speakers found.</p>{{ end }}
</section>
<section class="social-post-section" id="talks">
    <header class="social-section-heading"><h2>Talks <span>{{ len .TalkRows }}</span></h2>
    {{ if .TalkRows }}<label class="social-select-all"><input type="checkbox" onclick="toggleAll(this, 'talk')"> Select all</label>{{ end }}</header>
    {{ range .TalkRows }}
    <article class="social-post" data-social-row>
      <header class="social-post-heading"><div class="social-post-select">
                                    <input type="checkbox" name="selected_talk" value="{{ .ID }}" data-selection-group="talk" class="rounded border-gray-300">
                                    <input type="hidden" name="photo_talk_{{ .ID }}" value="{{ .PhotoURL }}">
                                </div><div class="social-post-name">
                                    {{ .Name }}
                                    <div class="text-xs text-gray-400">{{ .SpeakerNames }}</div>
                                </div></header>
      <div class="social-post-body"><div class="social-post-media"><h3>Media <span>Left to right = posting order</span></h3>
                                    <div data-social-media data-media-field="talk_{{ .ID }}">
                                        <ol data-media-list aria-label="Post media in order" class="flex items-start gap-3 overflow-x-auto max-w-sm">{{ if .PhotoURL }}<li data-media-item data-source="card" class="mb-3 shrink-0 rounded border border-gray-200 p-2"><strong class="block text-xs" data-media-label>Social card</strong><img src="{{ .PhotoURL | safeURL }}" alt="Social card" loading="lazy" class="w-32 rounded"></li>{{ end }}</ol>
                                        <input type="hidden" name="media_items_talk_{{ .ID }}" data-media-items>
                                        <p data-media-validation role="status" class="text-xs text-red-700"></p>
                                        <label class="block text-sm font-medium text-gray-700">Add media
                                            <input type="file" multiple accept="video/mp4,video/quicktime,image/jpeg,image/png,.mp4,.mov" data-media-file class="mt-1 block w-full text-sm">
                                        </label>
                                        <p class="mt-1 text-xs text-gray-600" data-media-status role="status"></p>
                                    </div>
                                </div>
      <div class="social-post-copy"><h3>Post text</h3>
                                    <textarea name="text_talk_{{ .ID }}" rows="7" class="w-full rounded border border-gray-300 px-3 py-2 text-sm font-mono">{{ .PostText }}</textarea>

                                </div></div>
    </article>
    {{ else }}<p class="social-empty">No talks found.</p>{{ end }}
</section>
<section class="social-post-section" id="sponsors">
    <header class="social-section-heading"><h2>Sponsors <span>{{ len .SponsorRows }}</span></h2>
    {{ if .SponsorRows }}<label class="social-select-all"><input type="checkbox" onclick="toggleAll(this, 'sponsor')"> Select all</label>{{ end }}</header>
    {{ range .SponsorRows }}
    <article class="social-post" data-social-row>
      <header class="social-post-heading"><div class="social-post-select">
                                    <input type="checkbox" name="selected_sponsor" value="{{ .Ref }}" data-selection-group="sponsor" class="rounded border-gray-300">
                                    <input type="hidden" name="card_sponsor_{{ .Ref }}" value="{{ .CardURL }}">
                                    <input type="hidden" name="level_sponsor_{{ .Ref }}" value="{{ .Level }}">
                                </div><div class="social-post-name">
                                    {{ .OrgName }}
                                    {{ if .Twitter }}<div class="text-xs text-gray-400">@{{ .Twitter }}</div>{{ end }}
                                    <div class="text-xs text-gray-400">{{ .Level }}</div>
                                </div></header>
      <div class="social-post-body"><div class="social-post-media"><h3>Media <span>Left to right = posting order</span></h3>
                                    <div data-social-media data-media-field="sponsor_{{ .Ref }}">
                                        <ol data-media-list aria-label="Post media in order" class="flex items-start gap-3 overflow-x-auto max-w-sm">{{ if .CardURL }}<li data-media-item data-source="card" class="mb-3 shrink-0 rounded border border-gray-200 p-2"><strong class="block text-xs" data-media-label>Social card</strong><img src="{{ .CardURL | safeURL }}" alt="Social card" loading="lazy" class="w-32 rounded"></li>{{ end }}</ol>
                                        <input type="hidden" name="media_items_sponsor_{{ .Ref }}" data-media-items>
                                        <p data-media-validation role="status" class="text-xs text-red-700"></p>
                                        <label class="block text-sm font-medium text-gray-700">Add media
                                            <input type="file" multiple accept="video/mp4,video/quicktime,image/jpeg,image/png,.mp4,.mov" data-media-file class="mt-1 block w-full text-sm">
                                        </label>
                                        <p class="mt-1 text-xs text-gray-600" data-media-status role="status"></p>
                                    </div>
                                </div>
      <div class="social-post-copy"><h3>Post text</h3>
                                    <textarea name="text_sponsor_{{ .Ref }}" rows="7" class="w-full rounded border border-gray-300 px-3 py-2 text-sm font-mono">{{ .PostText }}</textarea>

                                </div></div>
    </article>
    {{ else }}<p class="social-empty">No sponsors found.</p>{{ end }}
</section>
      {{ if .SponsorBatchText }}<section class="social-batch"><h2>Instagram sponsor carousel</h2><p>Image sponsors are combined in sponsor order, using the media order from each row. Video sponsors are posted individually.</p><label for="social-batch-copy">Carousel post text</label><textarea id="social-batch-copy" name="text_sponsor_batch" rows="4">{{ .SponsorBatchText }}</textarea></section>{{ end }}
      <footer class="social-submit-bar"><p>Select the posts you want to queue.<br><span>MP4, MOV, JPEG or PNG · Up to 300 MB per file.</span></p><button type="submit" data-social-submit>Queue selected posts to Buffer →</button></footer>
    </form>{{ end }}
  </main>
  <script src="/static/js/social-media-upload.js" defer></script>
  <script>function toggleAll(source, group) { document.querySelectorAll('input[type="checkbox"][data-selection-group="' + group + '"]').forEach(function(cb) { cb.checked = source.checked; }); }</script>
</body>
</html>
