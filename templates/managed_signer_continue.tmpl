{{ define "managed_signer_continue.tmpl" -}}
<!doctype html><html lang="en"><head><title>Returning to signer · bitcoin++</title>
{{ template "account_security_head" . }}
<script src="/static/js/managed-signer-continue.js" defer></script>
<link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-account-flows">
</head>
<body class="btcpp-login-page account-flow account-flow--signer">
{{ template "account_security_brand" . }}<main class="auth-shell auth-shell--simple" aria-live="polite"><section class="auth-card"><h1>Returning to your signer…</h1><p>Bitcoin++ confirmed this action. You’ll continue automatically.</p><form class="auth-form" method="post" action="{{ .ReturnTo }}" data-managed-signer-continue><input type="hidden" name="authorization" value="{{ .Token }}"><button class="auth-primary" type="submit">Return to signer →</button></form><noscript><p>Automatic return requires JavaScript. Use the button above to continue.</p></noscript></section></main>{{ template "account_security_footer" . }}</body></html>
{{- end }}
