<!DOCTYPE html>
<html lang="en">
<head><title>Review your Alerts plan · bitcoin++</title>{{ block "header" . }}{{ end }}
<link rel="stylesheet" href="/static/css/shop.css?v=20260718-11"><link rel="stylesheet" href="/static/css/service-checkout.css?v=3">
</head>
<body class="shop-page">
{{ block "mainnav" . }}{{ end }}
<main class="service-checkout"><section class="service-checkout-content">
<header class="service-checkout__head"><span class="service-kicker">BITCOIN++ ALERTS</span><h1>Review your plan</h1><p role="status">{{ .Message }}</p></header>

{{ if eq .Stored.Quote.Provider "opennode" }}<p>Bitcoin payment via OpenNode. This is prepaid access with no automatic renewal.</p>{{ end }}
{{ if not .Expired }}
<form method="post" action="/services/quotes/{{ .Stored.ID }}/confirm">
<input type="hidden" name="csrf" value="{{ .CSRF }}">
{{ with .Policy }}
<details><summary>Read the Terms of Service · {{ .Version }}</summary><div style="white-space:pre-wrap">{{ .TermsText }}</div></details>
<details><summary>Read the Privacy Policy · {{ .Version }}</summary><div style="white-space:pre-wrap">{{ .PrivacyText }}</div></details>
<input type="hidden" name="legal_version" value="{{ .Version }}">
<label><input type="checkbox" name="accept_terms" value="yes" required> I agree to these Terms of Service and acknowledge the Privacy Policy.</label>
{{ end }}
<button type="submit" class="service-primary">Confirm {{ .Total }} order →</button>
</form>
{{ end }}
<p><a href="https://alerts.btcpp.dev/alerts">Return to My alerts</a></p>
</section><aside class="service-summary" aria-label="Order summary"><img src="/static/img/alerts-checkout.svg" alt="" width="640" height="360"><div class="service-summary__body"><h2><span class="service-wordmark">bitcoin++</span> Alerts</h2><dl>
<div><dt>Projects added beyond your free three</dt><dd>{{ .Stored.Quote.Quantity }}</dd></div>
<div><dt>{{ if .Stored.Quote.BaseOrderID }}Prorated total{{ else }}Term total{{ end }} (USD, including tax)</dt><dd>{{ .Total }}</dd></div>
<div><dt>Included tax</dt><dd>{{ .Tax }}</dd></div>
{{ with .Stored.Quote.PeriodStart }}<div><dt>Access starts (UTC)</dt><dd>{{ .UTC.Format "January 2, 2006, 15:04" }}</dd></div>{{ end }}
{{ with .Stored.Quote.PeriodEnd }}<div><dt>Access ends (UTC)</dt><dd>{{ .UTC.Format "January 2, 2006, 15:04" }}</dd></div>{{ end }}
<div><dt>Quote valid until (UTC)</dt><dd>{{ .Stored.Quote.ExpiresAt.UTC.Format "January 2, 2006, 15:04" }}</dd></div>
</dl></div></aside></main>
</body></html>
