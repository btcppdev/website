<!DOCTYPE html>
<html>
<head>
  <title>Authorize {{ .Client.Name }} · bitcoin++</title>
  {{ block "header" . }} {{ end }}
  <link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-permissions-regular">
</head>
<body class="btcpp-login-page oauth-consent">
  {{ block "mainnav" . }} {{ end }}
  <main class="auth-shell auth-shell--simple" aria-labelledby="oauth-consent-title">
    <section class="auth-card">
      <header class="auth-card__head">
        <h1 id="oauth-consent-title">Authorize <span class="oauth-consent__app">{{ .Client.Name }}?</span></h1>
        <p>This application is asking for the following access to your bitcoin++ account. You can revoke this connection later.</p>
      </header>
      <ul role="list" class="oauth-consent-scopes" aria-label="Requested permissions">
        {{ range .Scopes }}
        <li><span class="oauth-consent-scopes__check" aria-hidden="true">✓</span><span class="oauth-consent-scopes__description">{{ with index $.ScopeDescriptions . }}{{ . }}{{ else }}{{ . }}{{ end }}</span></li>
        {{ end }}
      </ul>
      <form method="POST" action="/oauth/authorize" class="auth-form">
        <input type="hidden" name="csrf" value="{{ .CSRF }}">
        <input type="hidden" name="client_id" value="{{ .ClientID }}">
        <input type="hidden" name="redirect_uri" value="{{ .RedirectURI }}">
        <input type="hidden" name="response_type" value="code">
        <input type="hidden" name="scope" value="{{ range $i, $scope := .Scopes }}{{ if $i }} {{ end }}{{ $scope }}{{ end }}">
        <input type="hidden" name="state" value="{{ .State }}">
        <input type="hidden" name="code_challenge" value="{{ .CodeChallenge }}">
        <input type="hidden" name="code_challenge_method" value="S256">
        <button class="auth-primary" type="submit" name="decision" value="allow">Authorize {{ .Client.Name }} <span>→</span></button>
        <div class="auth-form__actions"><button class="auth-text-link" data-site-controls="off" type="submit" name="decision" value="deny">Cancel →</button></div>
      </form>
    </section>
  </main>
  {{ block "footer" . }} {{ end }}
</body>
</html>
