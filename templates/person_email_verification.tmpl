<!doctype html>
<html lang="en">
<head>
  <title>Add email · bitcoin++</title>
  {{ template "header" . }}
  <link rel="stylesheet" href="/static/css/login-layout.css?v=20261121-account-flows">
</head>
<body class="btcpp-login-page account-flow">
  {{ template "mainnav" . }}
  <main class="auth-shell auth-shell--simple">
    <section class="auth-card">
      <header class="auth-card__head">
        <h1>Add this <em>email.</em></h1>
        <p>Confirm that this email should be attached to the bitcoin++ account that requested it.</p>
      </header>
      {{ if .Error }}
        <div class="auth-alert auth-alert--error" role="alert">{{ .Error }}</div>
        <div class="auth-form auth-form__actions"><a href="/dashboard/emails">Return to email addresses →</a></div>
      {{ else }}
        <div class="auth-identity"><strong>{{ .Email }}</strong><small>For the account {{ .RequesterEmail }}</small></div>
        <form method="POST" action="/dashboard/emails/verify" class="auth-form">
          <input type="hidden" name="token" value="{{ .Token }}">
          <button class="auth-primary" type="submit">Verify and add this email</button>
        </form>
        <div class="auth-form auth-form__actions"><a href="/dashboard/emails">Cancel and return →</a></div>
      {{ end }}
    </section>
  </main>
  {{ template "footer" . }}
</body>
</html>
