<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ .Conf.Tag }} · merch register</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&amp;family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/pos.css?v=bitcoin-plus-plus">
<script src="/static/js/pos.js" defer></script>
</head>
<body data-pos-currency="{{ .Currency }}" data-pos-rate="{{ .Rate }}" data-pos-base="/{{ .Conf.Tag }}/merch/sell">
<header class="pos-header"><a href="/{{ .Conf.Tag }}"><img src="/static/img/logo_blk.svg" alt="bitcoin++"></a><div><strong>{{ .Conf.Location }}</strong><span>Merch {{ if .Admin }}setup{{ else }}register{{ end }}</span></div>{{ if and (not .Admin) (not .NeedsPIN) }}<form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}"><button class="quiet" name="action" value="lock">Lock</button></form>{{ end }}</header>
<main class="pos-main {{ if .Admin }}pos-main--admin{{ end }}">
{{ if .Error }}<p class="notice error" role="alert">{{ .Error }}</p>{{ end }}
{{ if .Flash }}<p class="notice" role="status">{{ .Flash }}</p>{{ end }}
{{ if .NeedsPIN }}
<section class="unlock"><span class="eyebrow">Ready for the next customer</span><h1>Open the register.</h1><p>Use the volunteer ticket check-in PIN.</p><form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}"><label for="pin">Volunteer PIN</label><input id="pin" name="pin" type="password" inputmode="numeric" autocomplete="off" required autofocus><button name="action" value="unlock">Unlock register →</button></form></section>
{{ else if .Admin }}
<div class="intro"><div><span class="eyebrow">Before the doors open</span><h1>Set up the merch table.</h1><p>Exact sats prices. Dedicated event stock. Local estimates in {{ .Currency }}.</p></div><a class="button secondary" href="/{{ .Conf.Tag }}/merch/sell">Open mobile register ↗</a></div>
<form method="post" class="settings"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="action" value="open"><label class="check"><input type="checkbox" name="enabled" {{ if .Enabled }}checked{{ end }}> Register open for sales</label><button>Save register status</button></form>
<p class="hint">Prices are final totals in sats. Positive transfers move stock from the online shop to this event; negative transfers return unsold, unreserved items. Transfers apply once per save.</p>
<section class="stock-list" aria-label="Event product settings">
{{ range .Products }}<form method="post" class="stock-card"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><input type="hidden" name="action" value="stock"><input type="hidden" name="operation_id" value="{{ $.RequestID }}"><input type="hidden" name="variant" value="{{ .VariantID }}"><div><h2>{{ .Name }}</h2><p>{{ .Label }} · {{ .SKU }}</p><span class="stock">{{ .Available }} at event · {{ .Central }} in central stock</span></div><label class="check"><input name="enabled" type="checkbox" {{ if .Enabled }}checked{{ end }}> Sell at event</label><label>Price in sats<input type="number" name="price" min="0" max="500000000" step="1" value="{{ .PriceSats }}" required><small class="local" data-local-sats="{{ .PriceSats }}"></small></label><label>Transfer units (+ / −)<input type="number" name="transfer" min="-1000000" max="1000000" step="1" value="0" required></label><button>Save item</button></form>{{ else }}<p>No products yet. <a href="/admin/merch">Add products to the shop.</a></p>{{ end }}
</section>
{{ template "pos_recent" . }}
<details class="recent"><summary>Stock, price and sales history</summary>{{ range .Audit }}<div class="recent-sale"><span>{{ .Description }}<small>{{ .Actor }} · {{ .VariantID }} {{ .SaleID }}</small></span><span>{{ .CreatedAt.Format "Jan 2 15:04" }}</span></div>{{ end }}</details>
{{ range .Recent }}{{ if eq .Status "creating" }}<form method="post" class="stock-card"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><input type="hidden" name="action" value="recover"><input type="hidden" name="sale" value="{{ .ID }}"><div><h2>Recover unconfirmed checkout</h2><p>{{ .ID }}</p><p>Find this order ID in OpenNode and enter its charge ID. Never create another invoice for this sale.</p></div><label>OpenNode charge ID<input name="charge_id" required></label><button>Verify and recover</button></form>
<form method="post" class="settings"><input type="hidden" name="csrf" value="{{ $.CSRF }}"><input type="hidden" name="action" value="cancel"><input type="hidden" name="sale" value="{{ .ID }}"><label class="check"><input type="checkbox" name="verified_no_charge" required> I checked OpenNode: no charge was created for this sale.</label><button class="secondary">Cancel unconfirmed sale</button></form>{{ end }}{{ end }}
{{ else if .Sale }}
{{ with .Sale }}
<section class="payment" data-sale="{{ .ID }}" data-status="{{ .Status }}" data-expires="{{ with .ExpiresAt }}{{ .Format "2006-01-02T15:04:05Z07:00" }}{{ end }}">
<span class="eyebrow">Lightning checkout</span><h1 id="payment-title">{{ if eq .Status "paid" }}Payment received.{{ else if or (eq .Status "expired") (eq .Status "cancelled") }}Invoice closed.{{ else if eq .Status "creating" }}Checking checkout.{{ else if eq .Status "review" }}Admin review needed.{{ else }}Scan. Pay. Done.{{ end }}</h1>
<div class="payment-total"><strong data-format-sats="{{ .TotalSats }}">{{ .TotalSats }} sats</strong><small class="local" data-local-sats="{{ .TotalSats }}" data-rate="{{ .LocalPerBTC }}" data-currency="{{ .Currency }}"></small></div>
<div id="invoice" {{ if or (ne .Status "pending") (not .Invoice) }}hidden{{ end }}><img class="qr" src="/{{ $.Conf.Tag }}/merch/sell/qr/{{ .ID }}" alt="Scan to pay with Lightning"><p id="expiry">Waiting for Lightning payment…</p><button type="button" id="copy-invoice" class="secondary" data-invoice="{{ .Invoice }}">Copy Lightning invoice</button></div>
<p id="payment-message" role="status">{{ if eq .Status "creating" }}Payment setup is unconfirmed. Do not charge again. Ask an admin to reconcile this sale in OpenNode.{{ else if eq .Status "review" }}A late payment needs reconciliation. Ask an admin before handing over stock.{{ else if or (eq .Status "expired") (eq .Status "cancelled") }}No payment confirmed. Reserved stock has been returned to the event.{{ else if eq .Status "paid" }}{{ if .HandedOverAt }}Items already handed over.{{ else }}Ready to hand over the items below.{{ end }}{{ else }}Keep this screen open. We’ll confirm when payment arrives.{{ end }}</p>
<ul class="sale-items">{{ range .Items }}<li><span>{{ .Quantity }} × {{ .Name }} <small>{{ .Label }}</small></span><span><strong data-format-sats="{{ .PriceSats }}">{{ .PriceSats }} sats</strong><small class="local" data-local-sats="{{ .PriceSats }}" data-rate="{{ $.Sale.LocalPerBTC }}" data-currency="{{ $.Sale.Currency }}"></small></span></li>{{ end }}</ul>
<form method="post" id="handover" {{ if or (ne .Status "paid") .HandedOverAt }}hidden{{ end }}><input type="hidden" name="csrf" value="{{ $.CSRF }}"><input type="hidden" name="sale" value="{{ .ID }}"><button name="action" value="handover">Items handed over · Next customer →</button></form>
<p class="hint">Leaving this screen keeps an unpaid invoice reserved until OpenNode confirms expiry.</p><a class="back-link" href="/{{ $.Conf.Tag }}/merch/sell">Back to register</a><p class="hint">Sale {{ .ID }}</p>
</section>
{{ end }}
{{ else }}
<div class="intro"><div><span class="eyebrow">§ 01 / Conference merch</span><h1>Merch desk<span class="brand-plus" aria-hidden="true">++</span></h1><p>Pick your gear. Pay in sats.</p></div><span class="status-pill">{{ if .Enabled }}Register open{{ else }}Register closed{{ end }}</span></div>
{{ if not .Enabled }}<p class="notice">An admin needs to open this register before you can sell.</p>{{ end }}
<section class="products" aria-label="Products">
{{ range .Products }}{{ if .Enabled }}<article class="product" data-variant="{{ .VariantID }}" data-price="{{ .PriceSats }}" data-name="{{ .Name }}" data-label="{{ .Label }}" data-stock="{{ .Available }}"><div class="product-image">{{ if .Image }}<img src="{{ .Image }}" alt="{{ .Name }}" loading="lazy">{{ else }}<img class="product-wordmark" src="/static/img/logo_blk.svg" alt="">{{ end }}</div><div class="product-info"><h2>{{ .Name }}</h2><p>{{ .Label }}</p><div class="price"><strong data-format-sats="{{ .PriceSats }}">{{ .PriceSats }} sats</strong><small class="local" data-local-sats="{{ .PriceSats }}"></small></div><span class="stock">{{ .Available }} available</span><div class="stepper"><button type="button" data-delta="-1" aria-label="Remove one {{ .Name }} {{ .Label }}" disabled>−</button><output aria-live="polite">0</output><button type="button" data-delta="1" aria-label="Add one {{ .Name }} {{ .Label }}" {{ if or (not $.Enabled) (le .Available 0) }}disabled{{ end }}>+</button></div></div></article>{{ end }}{{ end }}
</section>
<form method="post" id="checkout" class="cart-bar"><input type="hidden" name="csrf" value="{{ .CSRF }}"><input type="hidden" name="request_id" value="{{ .RequestID }}"><input type="hidden" name="action" value="checkout"><input type="hidden" name="cart" id="cart-json"><div><small id="cart-count">No items selected</small><strong id="cart-total">0 sats</strong><small class="local" id="cart-local"></small></div><button id="charge" disabled {{ if or (not .Enabled) (le .Rate 0.0) }}data-unavailable="true"{{ end }}>Charge →</button></form>
{{ template "pos_recent" . }}
{{ end }}
</main>
</body></html>
{{ define "pos_recent" }}
<details class="recent"><summary>Recent sales · {{ len .Recent }}</summary>{{ range .Recent }}<a class="recent-sale" href="/{{ $.Conf.Tag }}/merch/sell?sale={{ .ID }}"><span>{{ .CreatedAt.Format "15:04" }} · {{ range .Items }}{{ .Quantity }} × {{ .Name }} {{ .Label }}; {{ end }}<small>{{ .ID }}</small></span><span><strong data-format-sats="{{ .TotalSats }}">{{ .TotalSats }} sats</strong><small class="local" data-local-sats="{{ .TotalSats }}" data-rate="{{ .LocalPerBTC }}" data-currency="{{ .Currency }}"></small><small>{{ .Status }}{{ if .HandedOverAt }} · handed over{{ end }}</small></span></a>{{ else }}<p>No sales yet.</p>{{ end }}</details>
{{ end }}
