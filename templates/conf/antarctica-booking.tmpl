<!doctype html><html lang="en"><head><link rel="icon" type="image/svg+xml" sizes="any" href="/static/img/antarctica/favicon.svg?v=1"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Your expedition booking · bitcoin++</title><link rel="stylesheet" href="/static/css/antarctica.css?v=booking-1"><link rel="stylesheet" href="/static/css/antarctica-checkout.css?v=booking-1"></head><body class="antarctica expedition-checkout">
{{ if .Preview }}<div class="draft-banner">Sample booking · Illustrative data only · No reservation or payment created</div>{{ end }}
<header><a class="wordmark" href="/" aria-label="bitcoin++">bitcoin<span>++</span></a><span class="edition">COLD STORAGE EDITION</span><a href="/dashboard/orders">Your dashboard</a></header>
<main class="checkout-shell"><p class="eyebrow">January 24–February 5, 2028 · Antarctica</p><h1>Your expedition booking.</h1><p><strong>{{ .State }}</strong></p><p class="booking-reference">Booking reference: {{ .ID }}</p><p><a href="/dashboard/orders">Open your dashboard →</a> to find your expedition booking and payment history. Need to update your trip details? <a href="mailto:inbox@btcpp.dev">Contact the expedition team</a>.</p>
{{if .Terminal}}<p role="status" class="checkout-preview-note">{{.TerminalMessage}}</p>{{end}}
{{ if .Review }}<p role="status" class="checkout-preview-note">This booking needs review. Payment and refund receipts remain available below. The scheduled balance is not a revised cancellation or refund settlement; contact support before making another payment.</p>{{ end }}
<section aria-labelledby="booking-berths"><h2 id="booking-berths">Your berths · {{ .Quantity }} people</h2>
{{ range $index, $cabin := .Cabins }}<article class="cabin-allocation"><h3>{{ .Name }}</h3><p><strong>{{ .Quantity }} {{ if eq .Quantity 1 }}person{{ else }}people{{ end }}</strong> · {{ .Preference }}</p><p>Traveler names have not been assigned. We’ll collect each traveler’s details before departure.</p></article>{{ end }}
<p>Cabin numbers and deck locations are not assigned here. Roommate preferences are requests, not guarantees.</p></section>
<section id="checkout-totals" aria-labelledby="booking-payments"><h2 id="booking-payments">Passage payments</h2><p>{{ .Plan }} · {{ .Provider }}</p>
<div class="checkout-total-row"><span>Contracted passage total · USD</span><strong>{{ .Total }}</strong></div><div class="checkout-total-row"><span>Passage payments applied</span><strong>{{ .Paid }}</strong></div><div class="checkout-total-row checkout-booking-total"><span>{{if .Terminal}}Unpaid passage at closure{{else}}Remaining scheduled passage{{end}}</span><strong>{{ .Remaining }}</strong></div><p><strong>Next scheduled payment:</strong> {{ .NextDue }}</p><p>Passage amounts only. Taxes, merchandise and refunds are shown on the individual order receipts.</p>
{{ range .Payments }}<article class="booking-payment"><div><h3>Payment {{ .Number }} · {{ .Date }}</h3><p>{{ .Status }}</p></div><div><strong>{{ .Amount }}</strong>{{ if .OrderURL }}<p><a href="{{ .OrderURL }}">View order / receipt →</a></p>{{ else }}<p>{{ if $.Preview }}Sample only — no order created{{ else }}Payment link not yet issued{{ end }}</p>{{ end }}</div>
{{ if and .PayURL (not $.Preview) }}<p><a class="button" href="{{.PayURL}}">Review installment and pay →</a></p>{{end}}
{{ with .Legal }}<details><summary>Terms accepted for this payment · {{ .Version }}</summary><p>Accepted {{ .AcceptedAt.UTC.Format "January 2, 2006, 15:04" }} UTC</p><div class="policy-text">{{ .TermsText }}</div><h4>Privacy policy shown</h4><div class="policy-text">{{ .PrivacyText }}</div></details>{{ end }}</article>{{ end }}</section>
{{ if .Preview }}<p><a href="?checkout=1">Back to checkout preview →</a></p>{{ else }}<p><a href="/dashboard/orders">Back to payment history →</a></p>{{ end }}
</main></body></html>
