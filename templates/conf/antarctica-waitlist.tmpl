<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Expedition waitlist · Antarctica</title><link rel="icon" href="/static/img/antarctica/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/static/css/antarctica.css"><link rel="stylesheet" href="/static/css/antarctica-checkout.css"></head><body class="antarctica expedition-checkout">{{ if .Preview }}<div class="draft-banner">Waitlist preview · No real signup is saved and no email is sent</div>{{ end }}<header><a class="wordmark" href="/antarctica">bitcoin<span>++</span></a><span class="edition">COLD STORAGE EDITION</span></header><main class="checkout-shell"><p class="eyebrow">January 24–February 5, 2028</p>
{{ if .Joined }}<h1>{{ if .Preview }}Preview: {{ end }}{{ if .Notified }}Your availability alert was sent.{{ else }}You’re on the waitlist.{{ end }}</h1><p>{{ if .Notified }}We sent an availability alert to{{ else }}{{ if .Preview }}In the live flow, an availability email would go to{{ else }}We’ll send one email when spots become available to{{ end }}{{ end }} <strong>{{ .Email }}</strong>.</p><form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}"><button class="checkout-secondary" name="action" value="leave">Leave the waitlist</button></form>
{{ else if .Available }}<h1>Spots are available.</h1><p>You can check current availability and reserve your passage.</p>
{{ else }}<h1>Join the waitlist.</h1><p>All spots are currently booked or held. If one opens up, we’ll let you know.</p><form method="post"><input type="hidden" name="csrf" value="{{ .CSRF }}">{{ if .Preview }}<div class="checkout-billing"><label for="waitlist-email">Email address<input id="waitlist-email" name="email" type="email" autocomplete="email" required maxlength="320" value="{{ .Email }}"></label></div>{{ else }}<p>Your verified email: <strong>{{ .Email }}</strong></p>{{ end }}<button class="button" name="action" value="join">Join the waitlist →</button></form>{{ end }}
<p class="fine">Joining is free and does not reserve a berth, guarantee availability, or subscribe you to the newsletter. You can leave this waitlist at any time.</p>{{ if .Available }}<p><a class="button" href="/expeditions/antarctica/checkout">Check availability →</a></p>{{ end }}<p><a href="/antarctica">Back to the expedition</a></p></main></body></html>
