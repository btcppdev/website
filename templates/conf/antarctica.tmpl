      <li><span class="timeline-share">20%</span><span class="timeline-date">Reserve<span>Your deposit</span></span><strong data-installment-amount>$3,285.80</strong></li>
      <li><span class="timeline-share">20%</span><span class="timeline-date">Jan 1<span>2027</span></span><strong data-installment-amount>$3,285.80</strong></li>
