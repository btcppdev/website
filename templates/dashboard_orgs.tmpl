<!DOCTYPE html>
<html lang="en">
{{/* Every signed-in account gets this organization landing page. */}}
<head>
  <title>your organizations - bitcoin++</title>
  {{ block "header" . }}{{ end }}
</head>
<body class="btcpp-dashboard-page organization-dashboard-page">
  {{ block "mainnav" . }}{{ end }}
  {{ template "dashboard_tabs" (dict "Active" "orgs" "ShowHackathons" .HasHackathonProjects "ShowSponsors" .ShowSponsors "ShowAdmin" .IsGlobalAdmin "PendingOrgInviteCount" .PendingOrgInviteCount) }}
  <div class="dashboard-shell">
    <main class="dashboard-main">
      {{ if .FlashMessage }}<div class="dashboard-flash is-success"><p>{{ .FlashMessage }}</p></div>{{ end }}
      {{ if .FlashError }}<div class="dashboard-flash is-error"><p>{{ .FlashError }}</p></div>{{ end }}

      <header class="dashboard-workspace-hero organization-dashboard-hero">
        <div class="dashboard-workspace-hero__identity">
          <div class="dashboard-workspace-hero__mark"><span>O</span></div>
          <div class="dashboard-workspace-hero__copy">
            <div class="dashboard-kicker">● Organization workspace</div>
            <h1>Your organizations.</h1>
            <p>See the communities and projects you belong to, or manage their team and public profile.</p>
          </div>
        </div>
        <dl class="dashboard-workspace-hero__facts" aria-label="Organization summary">
          <div><dt>Memberships</dt><dd>{{ len .Memberships }}</dd></div>
          <div><dt>Managed</dt><dd>{{ .ManagedCount }}</dd></div>
        </dl>
      </header>

      {{ if .PendingInvites }}
      <section class="organization-dashboard-pending dashboard-workspace-panel" aria-labelledby="pending-organization-invitations">
        <div class="organization-dashboard-section__head">
          <div>
            <div class="dashboard-kicker">● Action needed</div>
            <h2 id="pending-organization-invitations">Pending invitations.</h2>
          </div>
          <p>These invitations match a verified email on your account.</p>
        </div>
        <div class="organization-dashboard-pending__list">
          {{ range .PendingInvites }}
          <article class="organization-dashboard-pending__invite">
            <div>
              <strong>{{ .OrganizationName }}</strong>
              <span>Invited as {{ .Role }} via {{ .Email }}</span>
              <small>Expires {{ .ExpiresAt.Format "Jan 2, 2006 at 3:04 PM MST" }}</small>
            </div>
            <form method="POST" action="/dashboard/orgs/invites/{{ .ID }}/accept">
              <input type="hidden" name="csrf" value="{{ $.CSRF }}">
              <button type="submit">Accept invitation</button>
            </form>
          </article>
          {{ end }}
        </div>
      </section>
      {{ end }}

		{{ if .BadgeStudioURL }}
		<section class="organization-dashboard-section dashboard-workspace-panel" id="badge-inbox">
			<div class="organization-dashboard-section__head">
				<div><div class="dashboard-kicker">§ Badge inbox</div><h2>Your credentials.</h2></div>
				<p>See every badge awarded to your verified Nostr key and accept new awards into your public profile.</p>
			</div>
			{{ if or (and .Badges .Badges.Issued) .PersonalGrants }}
			<div class="whois-credential-grid">
				{{ if .Badges }}{{ range .Badges.Issued }}
				<article class="whois-credential{{ if .Award.Revocation }} is-revoked{{ end }}"><div class="whois-credential-art"><img src="{{ .Definition.ImageURL }}" alt="Artwork for {{ .Definition.Name }}" loading="lazy"></div><div><small>{{ if .Award.Revocation }}revoked{{ else if .Accepted }}accepted on nostr{{ else }}awarded · acceptance pending{{ end }}</small><h3>{{ .Definition.Name }}</h3>{{ if .Definition.Description }}<p>{{ .Definition.Description }}</p>{{ end }}{{ if not .Award.Revocation }}{{ if .CredentialURL }}<a href="{{ .CredentialURL }}">View credential →</a>{{ end }}{{ if .ClaimURL }} <a href="{{ .ClaimURL }}">Accept on Nostr →</a>{{ end }}{{ end }}</div></article>
				{{ end }}{{ end }}
				{{ range .PersonalGrants }}
				<article class="whois-credential is-pending"><div class="whois-credential-art"><img src="{{ .BadgeImageURL | safeURL }}" alt="Artwork for {{ .BadgeName }}" loading="lazy"></div><div><small>bitcoin++ grant · {{ if eq .State "ready_to_issue" }}ready to issue{{ else if eq .State "delivery_error" }}delivery needs attention{{ else }}{{ .State }}{{ end }}</small><h3>{{ .BadgeName }}</h3>{{ if .BadgeDescription }}<p>{{ .BadgeDescription }}</p>{{ end }}{{ if eq .State "granted" }}<a href="/dashboard/settings#settings-sign-in">Add or verify your Nostr key →</a>{{ else if eq .State "ready_to_issue" }}<span>The organization can now issue this to your verified key.</span>{{ else if .DeliveryError }}<span>The issuer needs to retry delivery.</span>{{ end }}</div></article>
				{{ end }}
			</div>
			{{ else }}<p>No badges are waiting for you. Awards will appear here as soon as an organization issues one to your verified key.</p>{{ end }}
		</section>
		{{ end }}

      {{ if .Memberships }}
      <section class="organization-dashboard-list" aria-label="Your organizations">
        {{ range .Memberships }}
        <article class="organization-dashboard-card dashboard-workspace-panel">
          <div class="organization-dashboard-card__mark">
            {{ if .Organization.LogoLight }}<img src="{{ .Organization.LogoLight | safeURL }}" alt="">{{ else }}<span>{{ printf "%.1s" .Organization.Name }}</span>{{ end }}
          </div>
          <div class="organization-dashboard-card__body">
            <div class="dashboard-kicker">§ {{ .Role }}</div>
            <h2>{{ .Organization.Name }}</h2>
            <p>{{ if .Organization.Tagline }}{{ .Organization.Tagline }}{{ else }}No public description has been added yet.{{ end }}</p>
            <a href="/dashboard/orgs/{{ orgMembershipPathRef . }}">{{ if or (eq .Role "owner") (eq .Role "manager") }}Manage organization{{ else }}View membership{{ end }} →</a>
          </div>
        </article>
        {{ end }}
      </section>
      {{ else }}
      <section class="organization-dashboard-empty dashboard-workspace-panel">
        <div class="dashboard-kicker">§ Memberships</div>
        <h2>No organizations yet.</h2>
        <p>Browse the directory below to join an open organization or request membership.</p>
      </section>
      {{ end }}

      <section class="organization-dashboard-section organization-directory-preview dashboard-workspace-panel" id="discover">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ Directory</div><h2>Discover organizations.</h2></div>
          <p>Find bitcoin communities and projects already represented at bitcoin++.</p>
        </div>
        <div class="organization-directory-tools">
          <form method="GET" action="/dashboard/orgs/discover" role="search">
            <label for="organization-search">Search organizations</label>
            <div class="organization-directory-search-row"><input id="organization-search" name="q" type="search" placeholder="Search by name or description"><button class="organization-directory-search-button" type="submit">Search →</button></div>
          </form>
          <a class="organization-directory-secondary-action" href="/dashboard/orgs/discover">View all organizations →</a>
        </div>
        <div class="organization-directory-grid">
          {{ range .Directory }}
          {{ template "organization_directory_card" (dict "Entry" . "CSRF" $.CSRF) }}
          {{ else }}
          <p class="organization-directory-empty">No organizations have been added yet.</p>
          {{ end }}
        </div>
      </section>

      <section class="organization-dashboard-section dashboard-workspace-panel" id="propose">
        <div class="organization-dashboard-section__head">
          <div><div class="dashboard-kicker">§ New organization</div><h2>Propose an organization.</h2></div>
          <p>Can’t find your community or project? Send it to the bitcoin++ administrators for review.</p>
        </div>
        {{ if .Applications }}
        <div class="organization-application-history">
          {{ range .Applications }}<div><strong>{{ .Name }}</strong><span class="organization-application-status is-{{ .Status }}">{{ .Status }}</span>{{ if .ReviewNote }}<p>{{ .ReviewNote }}</p>{{ end }}</div>{{ end }}
        </div>
        {{ end }}
        <details class="sponsor-profile-editor organization-application-form">
          <summary>Propose a new organization</summary>
          {{ if .SpacesReady }}
          <form method="POST" enctype="multipart/form-data" action="/dashboard/orgs/applications" class="sponsor-profile-form">
            <input type="hidden" name="csrf" value="{{ .CSRF }}">
            <div class="sponsor-profile-grid">
              <label><span>Organization name</span><input name="name" required></label>
              <label><span>Public contact email</span><input name="contact_email" type="email"></label>
              <label class="is-wide"><span>Tagline</span><textarea name="tagline" rows="2" required></textarea></label>
              <label><span>Website</span><input name="website" type="url" placeholder="https://"></label>
              <label><span>GitHub</span><input name="github" type="url" placeholder="https://github.com/"></label>
              <label class="is-wide"><span>Why should this organization be added?</span><textarea name="notes" rows="4" required></textarea></label>
            </div>
            <fieldset class="sponsor-profile-group organization-application-logos">
              <legend>Logo variants</legend>
              <p>Both variants are required. Upload a version that reads clearly on each background. PNG, JPEG, GIF, WebP, and SVG are supported.</p>
              <div class="sponsor-logo-variants">
                <div class="sponsor-logo-variant">
                  <span>For light backgrounds (dark logo)</span>
                  <div class="sponsor-logo-variant__preview is-light"><em>Dark logo preview</em></div>
                  <label><span>Choose dark logo</span><input name="LogoLightFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" required></label>
                </div>
                <div class="sponsor-logo-variant">
                  <span>For dark backgrounds (light logo)</span>
                  <div class="sponsor-logo-variant__preview is-dark"><em>Light logo preview</em></div>
                  <label><span>Choose light logo</span><input name="LogoDarkFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml" required></label>
                </div>
              </div>
            </fieldset>
            <button type="submit">Submit for review →</button>
          </form>
          {{ else }}
          <p>Organization proposals are temporarily unavailable because logo uploads are not configured.</p>
          {{ end }}
        </details>
      </section>
    </main>
  </div>
  {{ block "footer" . }}{{ end }}
</body>
</html>
